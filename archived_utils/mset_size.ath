load "msets-notp"
module MSetSize {
open MSet
declare mset-size: (T) [(MSet.MSet T)] -> N
assert* mset-size-axioms :=
  [
   ((mset-size MSet.null) = zero)
   ((mset-size (MSet.insert ?x ?rest)) = (N.S (mset-size ?rest)))]
} 
open MSetSize
(print "\n=== MSet Size Module ===\n")
(print "Provides: mset-size : (T) [(MSet T)] -> N\n")
(print "\nAxioms:\n")
(print "  [X] size(null) = zero\n")
(print "  [X] size(insert x rest) = S(size(rest))\n")
(print "\nUse for: Termination proofs via size decrease\n")
