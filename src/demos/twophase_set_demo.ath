load "../crdts/twophase_set/twophase_set_payload_adapter"

open TwoPhaseSetAdapter
open TwoPhaseSetSpec
open Payload

(print "\n========================================\n")
(print "2P-Set Unified Framework Demo\n")
(print "========================================\n\n")

# Step 1: Initialize configuration
(print "[Step 1] Initialize configuration with actors: a, b, c\n")
define actors := ('a :: 'b :: 'c :: nil)
define cfg0 := (tps-init actors)

# Step 2: Actor 'a adds element x - broadcast to self
(print "[Step 2] Actor 'a adds element x\n")
define cfg1 := (tps-broadcast cfg0 ('a :: nil) (TwoPhaseSetSpec.add 'x))

# Step 3: Deliver to 'a
(print "[Step 3] Deliver to 'a -> state: ({x}, {})\n")
define cfg2 := (tps-reduce cfg1)

# Step 4: Actor 'b adds element y - broadcast to self
(print "[Step 4] Actor 'b adds element y\n")
define cfg3 := (tps-broadcast cfg2 ('b :: nil) (TwoPhaseSetSpec.add 'y))

# Step 5: Deliver to 'b
(print "[Step 5] Deliver to 'b -> state: ({y}, {})\n")
define cfg4 := (tps-reduce cfg3)

# Step 6: Actor 'c removes element x (can only remove if previously added) - broadcast to self
(print "[Step 6] Actor 'c removes element x\n")
define cfg5 := (tps-broadcast cfg4 ('c :: nil) (TwoPhaseSetSpec.remove 'x))

# Step 7: Deliver to 'c
(print "[Step 7] Deliver to 'c -> state: ({}, {x})\n")
define cfg6 := (tps-reduce cfg5)

# Step 8: Actor 'a adds element z - broadcast to self
(print "[Step 8] Actor 'a adds element z\n")
define cfg7 := (tps-broadcast cfg6 ('a :: nil) (TwoPhaseSetSpec.add 'z))

# Step 9: Deliver to 'a
(print "[Step 9] Deliver to 'a -> state: ({x, z}, {x})\n")
define cfg8 := (tps-reduce cfg7)

# Final reduction to merge all states
(print "\n[Final] Reduce all pending messages\n")
define cfg-final := (tps-reduce* cfg8)

# Display final state across all actors
(print "\nFinal state structure:\n")
(print "- Actor 'a: added set + removed set\n")
(print "- Actor 'b: added set + removed set\n")
(print "- Actor 'c: added set + removed set\n")
(print "\nDemo completed successfully!\n")
(print "2P-Set property: Once removed, element cannot be re-added\n")
(print "Final visible elements = added \\ removed\n")
(print "Expected: {y, z} (x is removed, cannot reappear)\n")
(print "========================================\n")
