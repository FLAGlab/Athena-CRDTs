load "../../crdts/crdt_lww_register.ath"

open LWWRegisterCRDT
open LWWRegisterPayload
open Backbone
open VCCore

# Test if network patterns match

define ids := (gen-fresh (string->id "rep") 2)

define ActorA := match ids { (a :: _) => a | _ => (string->id "rep0") }

define InitCfg := (LWWRegisterCRDT.init ids)

define AfterIssue := (lww-register-issue InitCfg ActorA (string->id "test") ids)

(print "\nNetwork after issue:")
(eval (cfg-net AfterIssue))

# Test pattern match on the network
define net-is-empty := match (cfg-net AfterIssue) {
  MSet.null => true
| (MSet.insert _ _) => false
}

(print "\nIs network empty?")
(eval net-is-empty)

# Test if we can extract the first message
define first-msg := match (cfg-net AfterIssue) {
  MSet.null => NONE
| (MSet.insert m _) => (SOME m)
}

(print "\nFirst message:")
(eval first-msg)

(print "\n=== Test complete ===")
