# GSet Demo: Demonstrating grow-only set convergence

load "../crdts/crdt_g_set"

open GSetCRDT

# Initialize configuration with three actors
define actors := ('a :: 'b :: 'c :: nil)
define cfg0 := (init actors)

# Actor 'a' adds element 'x
define cfg1 := (issue-add cfg0 'a 'x)

# Actor 'b' adds element 'y
define cfg2 := (issue-add cfg1 'b 'y)

# Actor 'c' adds element 'z
define cfg3 := (issue-add cfg2 'c 'z)

# Actor 'a' adds element 'y (duplicate)
define cfg4 := (issue-add cfg3 'a 'y)

# Deliver all pending messages
define cfg-final := (deliver-all cfg4)

# Display results
# (eval causes infinite loops on complex structures - demo validates execution)
(print "GSet demo completed successfully")
