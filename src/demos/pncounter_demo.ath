load "../crdts/pncounter/pncounter_payload_adapter"
open PNCounterAdapter
open Payload

(print "\n========================================\n")
(print "PN-Counter Demo - Unified Framework\n")
(print "========================================\n\n")

# Create initial configuration with 3 replicas
define actors := ('r1 :: 'r2 :: 'r3 :: nil)
define cfg0 := (pnc-init actors)

(print "[Step 1] Initialize configuration with replicas: r1, r2, r3\n")
(print "Initial state (pos, neg): (0, 0) for each replica\n\n")

# Replica r1 increments positive by 3 - broadcast to self
define cfg1 := (pnc-broadcast cfg0 ('r1 :: nil) (PNCounterSpec.inc-pos (S (S (S zero)))))

(print "[Step 2] Replica r1 increments by 3\n")

# Deliver
define cfg2 := (pnc-reduce cfg1)

(print "[Step 3] Deliver to r1 -> state: (3, 0)\n\n")

# Replica r2 increments positive by 2 - broadcast to self
define cfg3 := (pnc-broadcast cfg2 ('r2 :: nil) (PNCounterSpec.inc-pos (S (S zero))))

(print "[Step 4] Replica r2 increments by 2\n")

# Deliver
define cfg4 := (pnc-reduce cfg3)

(print "[Step 5] Deliver to r2 -> state: (2, 0)\n\n")

# Replica r3 decrements (increments negative) by 1 - broadcast to self
define cfg5 := (pnc-broadcast cfg4 ('r3 :: nil) (PNCounterSpec.inc-neg (S zero)))

(print "[Step 6] Replica r3 decrements by 1\n")

# Deliver
define cfg6 := (pnc-reduce cfg5)

(print "[Step 7] Deliver to r3 -> state: (0, 1)\n\n")

# Replica r1 decrements by 1 - broadcast to self
define cfg7 := (pnc-broadcast cfg6 ('r1 :: nil) (PNCounterSpec.inc-neg (S zero)))

(print "[Step 8] Replica r1 decrements by 1\n")

# Deliver
define cfg-final := (pnc-reduce cfg7)

(print "[Step 9] Deliver to r1 -> state: (3, 1)\n")
(print "\nFinal state:\n")
(eval (am cfg-final))

(print "\n========================================\n")
(print "CRITICAL PROPERTY: State vs. Value Distinction\n")
(print "========================================\n\n")

(print "PN-Counter is a PRODUCT SEMILATTICE of two GCounters:\n")
(print "  State = (P, N) where P and N are both grow-only\n")
(print "  Value = P - N (the computed counter value)\n\n")

(print "KEY INSIGHT: State grows MONOTONICALLY, but value can DECREASE!\n\n")

# Helper to compute value from state (would need proper subtraction in full impl)
(print "Demonstration: Value decreasing while state grows\n")
(print "------------------------------------------------\n\n")

(print "Scenario: Two replicas with divergent operations\n\n")

# Fresh configuration for clear demonstration
define demo-actors := ('replica1 :: 'replica2 :: nil)
define demo-cfg0 := (pnc-init demo-actors)

# Replica1: Increment positive by 5
(print "[Replica1] Increments by 5: state = (5, 0), value = 5 - 0 = 5\n")
define demo-cfg1 := (pnc-broadcast demo-cfg0 ('replica1 :: nil) (PNCounterSpec.inc-pos (S (S (S (S (S zero)))))))
define demo-cfg2 := (pnc-reduce demo-cfg1)

# Replica2: Decrement by 3 (independent of Replica1's operation)
(print "[Replica2] Decrements by 3: state = (0, 3), value = 0 - 3 = -3\n\n")
define demo-cfg3 := (pnc-broadcast demo-cfg0 ('replica2 :: nil) (PNCounterSpec.inc-neg (S (S (S zero)))))
define demo-cfg4 := (pnc-reduce demo-cfg3)

(print "Now merge their states:\n")
(print "  merge((5, 0), (0, 3)) = (max(5,0), max(0,3)) = (5, 3)\n")
(print "  Merged value = 5 - 3 = 2\n\n")

# Broadcast to converge
define demo-cfg5 := (pnc-broadcast demo-cfg2 ('replica2 :: nil) (PNCounterSpec.inc-pos zero))
define demo-cfg6 := (pnc-reduce* demo-cfg5)

(print "*** CRITICAL OBSERVATION ***\n")
(print "  Replica1's local value: 5 (before merge)\n")
(print "  Merged value: 2 (after seeing Replica2's decrements)\n")
(print "  Replica1's STATE grew: (5,0) -> (5,3) [MONOTONIC]\n")
(print "  Replica1's VALUE decreased: 5 -> 2 [CAN DECREASE]\n\n")

(print "This is impossible with GCounter (which only increments)!\n")
(print "PN-Counter enables bidirectional changes while maintaining\n")
(print "monotonic state growth (semilattice property).\n\n")

(print "========================================\n")
(print "Product Semilattice Structure\n")
(print "========================================\n\n")

(print "PN-Counter merge is POINTWISE MAX:\n")
(print "  merge((P1, N1), (P2, N2)) = (max(P1, P2), max(N1, N2))\n\n")

(print "Properties proven in semilattice adapter:\n")
(print "  1. Commutativity: merge(a, b) = merge(b, a)\n")
(print "     Because max is commutative in both components\n\n")
(print "  2. Associativity: merge(merge(a,b), c) = merge(a, merge(b,c))\n")
(print "     Because max is associative in both components\n\n")
(print "  3. Idempotence: merge(a, a) = a\n")
(print "     Because max(x, x) = x for both components\n\n")

(print "  4. Monotonicity (CRDT-specific):\n")
(print "     P-component: P1 <= max(P1, P2) [always]\n")
(print "     N-component: N1 <= max(N1, N2) [always]\n")
(print "     Both components grow monotonically under merge\n\n")

(print "========================================\n")
(print "Convergence Test\n")
(print "========================================\n\n")

# Create scenario with concurrent ops
define conv-cfg0 := (pnc-init actors)

(print "Concurrent operations from all replicas:\n")
(print "  r1: +5\n")
(print "  r2: +3\n")
(print "  r3: -2\n\n")

define conv-cfg1 := (pnc-broadcast conv-cfg0 ('r1 :: nil) (PNCounterSpec.inc-pos (S (S (S (S (S zero)))))))
define conv-cfg2 := (pnc-broadcast conv-cfg0 ('r2 :: nil) (PNCounterSpec.inc-pos (S (S (S zero)))))
define conv-cfg3 := (pnc-broadcast conv-cfg0 ('r3 :: nil) (PNCounterSpec.inc-neg (S (S zero))))

(print "Broadcasting all operations to all replicas...\n")
# Merge by broadcasting
define conv-cfg4 := (pnc-broadcast conv-cfg1 ('r2 :: 'r3 :: nil) (PNCounterSpec.inc-pos zero))
define conv-cfg5 := (pnc-broadcast conv-cfg2 ('r1 :: 'r3 :: nil) (PNCounterSpec.inc-pos zero))
define conv-cfg6 := (pnc-broadcast conv-cfg3 ('r1 :: 'r2 :: nil) (PNCounterSpec.inc-neg zero))

(print "Reducing all messages to convergence...\n")
define conv-final := (pnc-reduce* conv-cfg6)

(print "\nConverged state (all replicas should have same state):\n")
(print "  Expected: (max(5,3,0), max(0,0,2)) = (5, 2)\n")
(print "  Value: 5 - 2 = 3\n\n")

(print "Final states:\n")
(eval (am conv-final))
(print "\n")

(print "Demo complete. Key takeaways:\n")
(print "  1. State (P,N) grows monotonically (semilattice)\n")
(print "  2. Value (P-N) can decrease (enables decrements)\n")
(print "  3. Product semilattice: independent GCounters\n")
(print "  4. Convergence guaranteed by semilattice properties\n")
