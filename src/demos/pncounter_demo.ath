load "../crdts/pncounter/pncounter_payload_adapter"
open PNCounterAdapter
open Payload

(print "\n========================================\n")
(print "PN-Counter Demo - Unified Framework\n")
(print "========================================\n\n")

# Create initial configuration with 3 replicas
define actors := ('r1 :: 'r2 :: 'r3 :: nil)
define cfg0 := (pnc-init actors)

(print "[Step 1] Initialize configuration with replicas: r1, r2, r3\n")
(print "Initial state (pos, neg): (0, 0) for each replica\n\n")

# Replica r1 increments positive by 3 - broadcast to self
define cfg1 := (pnc-broadcast cfg0 ('r1 :: nil) (PNCounterSpec.inc-pos (S (S (S zero)))))

(print "[Step 2] Replica r1 increments by 3\n")

# Deliver
define cfg2 := (pnc-reduce cfg1)

(print "[Step 3] Deliver to r1 -> state: (3, 0)\n\n")

# Replica r2 increments positive by 2 - broadcast to self
define cfg3 := (pnc-broadcast cfg2 ('r2 :: nil) (PNCounterSpec.inc-pos (S (S zero))))

(print "[Step 4] Replica r2 increments by 2\n")

# Deliver
define cfg4 := (pnc-reduce cfg3)

(print "[Step 5] Deliver to r2 -> state: (2, 0)\n\n")

# Replica r3 decrements (increments negative) by 1 - broadcast to self
define cfg5 := (pnc-broadcast cfg4 ('r3 :: nil) (PNCounterSpec.inc-neg (S zero)))

(print "[Step 6] Replica r3 decrements by 1\n")

# Deliver
define cfg6 := (pnc-reduce cfg5)

(print "[Step 7] Deliver to r3 -> state: (0, 1)\n\n")

# Replica r1 decrements by 1 - broadcast to self
define cfg7 := (pnc-broadcast cfg6 ('r1 :: nil) (PNCounterSpec.inc-neg (S zero)))

(print "[Step 8] Replica r1 decrements by 1\n")

# Deliver
define cfg-final := (pnc-reduce cfg7)

(print "[Step 9] Deliver to r1 -> state: (3, 1)\n")
(print "\nFinal state:\n")
(eval (am cfg-final))