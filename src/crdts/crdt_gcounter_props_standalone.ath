load "src/framework/payload_examples"
load "src/framework/gcounter_max_props.ath"

extend-module GCounterPayload {
  open N

  # Join inherits associativity from max
  conclude gcounter-join-associative :=
  (forall ?n1:N ?n2:N ?n3:N
    (= (payload-join GCOUNTER_PAYLOAD (payload-join GCOUNTER_PAYLOAD ?n1 ?n2) ?n3)
       (payload-join GCOUNTER_PAYLOAD ?n1 (payload-join GCOUNTER_PAYLOAD ?n2 ?n3))))
  pick-any n1:N n2:N n3:N
    (!chain [(payload-join GCOUNTER_PAYLOAD (payload-join GCOUNTER_PAYLOAD n1 n2) n3)
             = (GCounterPayload.gcounter-max (GCounterPayload.gcounter-max n1 n2) n3) [GCounterPayload.payload-join]
             = (GCounterPayload.gcounter-max n1 (GCounterPayload.gcounter-max n2 n3)) [gmax-associative]
             = (payload-join GCOUNTER_PAYLOAD n1 (payload-join GCOUNTER_PAYLOAD n2 n3)) [GCounterPayload.payload-join]])

  # Join inherits idempotence from max
  conclude gcounter-join-idempotent :=
  (forall ?n:N
    (= (payload-join GCOUNTER_PAYLOAD ?n ?n)
       ?n))
  pick-any n:N
    (!chain [(payload-join GCOUNTER_PAYLOAD n n)
             = (GCounterPayload.gcounter-max n n) [GCounterPayload.payload-join]
             = n [gmax-idempotent]])

  # Payload join preserves order on each argument via the max lemmas
  conclude gcounter-join-left-monotone :=
  (forall ?n1:N ?n2:N
    (<= ?n1 (payload-join GCOUNTER_PAYLOAD ?n1 ?n2)))
  pick-any n1:N n2:N
    (!chain-> [true
               ==> (<= n1 (GCounterPayload.gcounter-max n1 n2))
                   [gmax-left-monotone]
               ==> (<= n1 (payload-join GCOUNTER_PAYLOAD n1 n2))
                   [GCounterPayload.payload-join]])

  conclude gcounter-join-right-monotone :=
  (forall ?n1:N ?n2:N
    (<= ?n2 (payload-join GCOUNTER_PAYLOAD ?n1 ?n2)))
  pick-any n1:N n2:N
    (!chain-> [true
               ==> (<= n2 (GCounterPayload.gcounter-max n1 n2))
                   [gmax-right-monotone]
               ==> (<= n2 (payload-join GCOUNTER_PAYLOAD n1 n2))
                   [GCounterPayload.payload-join]])

} # end extend-module

          (print "\n=== GCounter Property Proofs Complete ===\n")
          (print "Proved: gmax-commutative (via N.Max)\n")
          (print "Proved: gmax-associative (via N.Max)\n")
          (print "Proved: gmax-idempotent (via N.Max)\n")
          (print "Proved: gmax-left-monotone (via N.Max axioms)\n")
          (print "Proved: gmax-right-monotone (via N.Max axioms)\n")
          (print "Proved: gcounter-max-commutative (alias)\n")
          (print "Proved: gcounter-max-associative (alias)\n")
          (print "Proved: gcounter-max-idempotent (alias)\n")
          (print "Proved: gcounter-max-left-monotone (alias)\n")
          (print "Proved: gcounter-max-right-monotone (alias)\n")
          (print "Proved: gcounter-join-associative\n")
          (print "Proved: gcounter-join-idempotent\n")
          (print "Proved: gcounter-join-left-monotone\n")
          (print "Proved: gcounter-join-right-monotone\n")
