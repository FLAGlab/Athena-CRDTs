load "gcounter_specification"
load "../../framework/payload"
module GCounterAdapter {
  open GCounterSpec
  open Payload
  
  # GCounterSpec operations to Payload functions
  define (gc-init ids) := (init gc-initial ids)
  define (gc-reduce cfg) := (reduce gc-apply-update cfg)
  define (gc-reduce* cfg) := (reduce* gc-apply-update cfg)
  define (gc-broadcast cfg to-actors operation) := (broadcast cfg to-actors operation)
  define (gc-merge-states left right) := (merge-states gc-merge left right)
  

  module SemilatticeProofs {
    define commutative-for-gc-merge :=
      (forall ?s1:N ?s2:N . (gc-merge ?s1 ?s2) = (gc-merge ?s2 ?s1))
    
    define associative-for-gc-merge :=
      (forall ?s1:N ?s2:N ?s3:N . 
        (gc-merge (gc-merge ?s1 ?s2) ?s3) = (gc-merge ?s1 (gc-merge ?s2 ?s3)))
    
    define idempotent-for-gc-merge :=
      (forall ?s:N . (gc-merge ?s ?s) = ?s)
    
    conclude commutative := commutative-for-gc-merge
      pick-any s1:N s2:N
        (!chain [(gc-merge s1 s2)
               = (gc-merge s2 s1)  [GCounterSpec.Theory.merge-commutative]])
    
    conclude associative := associative-for-gc-merge
      pick-any s1:N s2:N s3:N
        (!chain [(gc-merge (gc-merge s1 s2) s3)
               = (gc-merge s1 (gc-merge s2 s3))  [GCounterSpec.Theory.merge-associative]])
    
    conclude idempotent := idempotent-for-gc-merge
      pick-any s:N
        (!chain [(gc-merge s s)
               = s  [GCounterSpec.Theory.merge-idempotent]])
  }
} 
