load "../framework/payload"
load "../framework/payload"
load "../framework/backbone"
load "../utils/fmaps"
load "../utils/pair"
load "../utils/list-util"

# Framework-based GCounter examples: a simple payload-only variant and a
# variant that uses the CRDT backbone (with vector clocks). These examples
# are small, self-contained, and intended as templates for migrating ad-hoc
# CRDTs to the reusable framework.

open Payload
open Backbone
open GCounterPayload

# ------------------------------------------------------------------
# SimpleGCounter: uses only the PayloadFramework (no vector clocks).
# ------------------------------------------------------------------
module SimpleGCounter {

  # Reuse the generic GCounter payload instance from payload_examples.

  define PAYLOAD := GCOUNTER_PAYLOAD

  define (normalize-state state) :=
    match state {
      zero => zero
    | (S rest) => (S (normalize-state rest))
    | (Payload.payload-step _ (GCounterPayload.increment delta) previous) =>
        (N.+ delta (normalize-state previous))
    | (Payload.payload-step _ _ previous) =>
        (normalize-state previous)
    | value => value
    }

  define (normalize-map candidate) :=
    match candidate {
      FMap.empty-map => FMap.empty-map
    | (FMap.update (pair actor value) rest) =>
        (FMap.update (pair actor (normalize-state value))
                      (normalize-map rest))
    | value => value
    }

  define (normalize-net candidate) :=
    match candidate {
      (Payload.net (Payload.kfg _ net)) => (normalize-net net)
    | value => value
    }

  define (init ids) := (Payload.init PAYLOAD ids)

  # Broadcast a local increment of `delta` to all actors.
  define (broadcast cfg delta) :=
    match cfg {
      (Payload.kfg am net) =>
        let { add-msg := (lambda (id) (msg id (increment delta) unit)) }
          (Payload.kfg am (map add-msg (FMap.dom am)))
    }

  # The reduce function is the one from Payload.
  define (reduce cfg) := (Payload.reduce PAYLOAD cfg)

  define (reduce* cfg) :=
    match (net cfg) {
      MSet.null => cfg
    | (MSet.insert _ _) => (reduce* (reduce cfg))
    }

  define (issue-increment cfg actor delta) :=
    (enqueue-with cfg actor (increment delta) unit)

  define (snapshot cfg) :=
    match cfg {
      (kfg am _) => (normalize-map am)
    | _ => (normalize-map (Payload.am cfg))
    }

  define (net cfg) :=
    match cfg {
      (kfg _ pending) => (normalize-net pending)
    | _ => (normalize-net (Payload.net cfg))
    }

  define (value-at-map map actor) :=
    match map {
      FMap.empty-map => zero
    | (FMap.update (pair key value) rest) =>
        match (equal? key actor) {
          true => value
        | false => (value-at-map rest actor)
        }
    }

  define (value-at cfg actor) :=
    (value-at-map (snapshot cfg) actor)

  define (deliver-one cfg) :=
    (reduce cfg)

  define (deliver-all cfg) :=
    (reduce* cfg)

} # end module SimpleGCounter

# ------------------------------------------------------------------
# BackboneGCounter: uses CRDTBackbone with vector clocks (VCCore).
# This demonstrates how to combine payloads with clocks for message meta.
# ------------------------------------------------------------------
module BackboneGCounter {

  open Payload
  open Backbone
  open VCCore
  open GCounterPayload

  define PAYLOAD := GCOUNTER_PAYLOAD

  # Configuration type is the one from Backbone. Provide simple
  # init that seeds both states and clock-map.
  define (init ids) := (Backbone.init PAYLOAD ids)

  # Broadcast a local increment using the sender's clock metadata
  define (broadcast cfg delta sender) :=
    (Backbone.broadcast-from cfg sender (increment delta))

  # Reduce uses the backbone reduce which also merges clocks
  define (reduce cfg) := (Backbone.reduce PAYLOAD cfg)

  define (reduce* cfg) := (Backbone.reduce* PAYLOAD cfg)

  define (issue-increment cfg actor delta) :=
    (broadcast cfg delta actor)

  define (normalize-state state) :=
    match state {
      zero => zero
    | (S rest) => (S (normalize-state rest))
    | (Payload.payload-step _ (GCounterPayload.increment delta) previous) =>
        (N.+ delta (normalize-state previous))
    | (Payload.payload-step _ _ previous) =>
        (normalize-state previous)
    | value => value
    }

  define (normalize-state-map entries) :=
    match entries {
      FMap.empty-map => FMap.empty-map
    | (FMap.update (pair actor value) rest) =>
        (FMap.update (pair actor (normalize-state value))
                      (normalize-state-map rest))
    }

  define (snapshot cfg) :=
    (normalize-state-map (Backbone.get-cfg-states cfg))

  define (pending-net cfg) :=
    (Backbone.get-cfg-net cfg)

  define (actor-clock cfg actor) :=
    (Backbone.cfg-actor-clock cfg actor)

  define (state-at cfg actor) :=
    (Backbone.cfg-state-lookup (snapshot cfg) actor zero)

  define (value-at cfg actor) :=
    (state-at cfg actor)

  define (with-states cfg states) :=
    (Backbone.kfg states
                  (Backbone.get-cfg-clocks cfg)
                  (Backbone.get-cfg-net cfg))

  define (normalize cfg) :=
    (let ((drained (reduce* cfg)))
      (with-states drained (snapshot drained)))

  define (map-sum map) :=
    match map {
      FMap.empty-map => zero
    | (FMap.update (pair _ value) rest) =>
        (N.+ value (map-sum rest))
    }

  define (total cfg) :=
    (map-sum (snapshot cfg))

  define (deliver-one cfg) :=
    (reduce cfg)

  define (deliver-all cfg) :=
    (reduce* cfg)

  define (drop-next cfg) :=
    (Backbone.cfg-drop-next-message cfg)

} # end module BackboneGCounter

open SimpleGCounter
open BackboneGCounter
