load "../utils/set-util"
load "../utils/msets-notp"
load "../utils/fmaps"
load "../utils/pair"
load "../utils/list-util"

# athena list type to list sort
define (alist->clist L) :=
  match L {
    [] => nil
  | (list-of x rest) => (x :: (alist->clist rest))
  | _ => L }

# generate an IDE starting by identifier i and followed by number n
define gen-ide := lambda (i n)
                    (string->id ((id->string i) join (val->string n)))

# generate IDEs list ['i0 'i1 ... 'in]
define gen-fresh := lambda (i n)
                      (alist->clist
                       (map (lambda (n) (gen-ide i n)) (from-to 0 n)))

module CRDT{

define [empty-map empty-mset empty-set] := [FMap.empty-map MSet.null Set.null]

define ++ := FMap.++
overload ++ MSet.++
overload ++ Set.++

define at  := FMap.at
define dom := FMap.dom

define -  := MSet.-
overload - FMap.-

define in := MSet.in
overload in Set.in
overload in List.in

define \/ := MSet.\/
overload \/ Set.\/

define [l rest dm id id1 id2 text] := [?l:(List Ide) ?rest:(List Ide) ?dm:(Set.Set Ide)
					  ?id:Ide ?id1:Ide ?id2:Ide ?text:Ide]

define-sort State := (List Ide)

datatype Value := (insert Ide)
               |  (delete Ide)
		     
datatype Message := (msg Ide Value)
		     
datatype Configuration := (kfg am:(FMap.Map Ide State) net:(MSet.MSet Message))

assert kfg-se-axioms := (selector-axioms "Configuration")

define [k amap n v m s s'] :=
        [?k: Configuration
	 ?amap:(FMap.Map Ide State)
	 ?n:(MSet.MSet Message)
	 ?v:Value
	 ?m:Message
	 ?s:State
	 ?s':State]
    
declare reduce : [Configuration] -> Configuration

assert* reduce-def :=
[(reduce (kfg amap ((msg id (insert text)) ++ n)) =
	  (kfg ([id (text :: l)] ++
		(amap - id))
	       n)
	  <== (amap at id = SOME l))
]

# denotes a potentially infinite computation using "schedule"
declare reduce* : [Configuration] -> Configuration

assert* reduce*-def :=
[((reduce* (kfg amap empty-mset)) = (kfg amap empty-mset))
 ((reduce* (kfg amap (m ++ n))) = (reduce* (reduce (kfg amap (m ++ n)))))]

# for each actor in config, create a msg w/payload
declare msgs: [(Set.Set Ide) Value] -> (MSet.MSet Message)

assert* msgs-def :=
[((msgs empty-set v) = empty-mset)
 ((msgs (id ++ dm) v) = ((msg id v) ++ (msgs dm v)))]

# broadcast a message with payload v to all actors in config
declare broadcast : [Configuration Value] -> Configuration

assert* broadcast-def :=
[((broadcast k v) = (kfg (am k) (msgs (dom (am k)) v) \/ (net k)))]

declare init-map : [(List Ide)] -> (FMap.Map Ide State)

assert* init-map-def :=
[ ((init-map nil) = empty-map)
  ((init-map (id :: rest)) = [id nil] ++ (init-map rest))]

declare init : [(List Ide)] -> Configuration
assert* init-def :=
[ ((init l) = (kfg (init-map l) empty-mset)) ]


define K0 := (eval (init (gen-fresh 'a 2)))

define K1 := (kfg (init-map (gen-fresh 'a 2)) ((msg 'a1 (insert 'v0)) ++ empty-mset))

(eval (reduce K1))

define K2 := (broadcast K0 (insert 'v1))

(eval K2)

define K3 := (broadcast (broadcast K0 (insert 'v1)) (insert 'v2))

(eval K3)

define K3reduced := (eval (reduce K3))

(eval (reduce (eval K2)))

(eval (reduce* (eval K2)))
      
      
# following def is non-constructive: cannot use eval!
declare equal-state : [Configuration] -> Boolean

assert* equal-state-def :=
[((equal-state k) <==> forall id1 id2 . ((id1 in (dom (am k)) & id2 in (dom (am k)))
					==> ((am k) at id1 = (am k) at id2)))
 ]

declare equal-state-v-c : [Configuration State] -> Boolean

assert* equal-state-v-c-def :=
[(equal-state-v-c (kfg empty-map n) s)
 ((equal-state-v-c (kfg ([id s] ++ amap) n) s) <==> (equal-state-v-c (kfg amap n) s))
 ((~ (equal-state-v-c (kfg ([id s] ++ amap) n) s')) <== (s =/= s'))
 ]

declare equal-state-c : [Configuration] -> Boolean

assert* equal-state-c-def :=
[(equal-state-c (kfg empty-map n))
 ((equal-state-c (kfg ([id s] ++ amap) n)) <==> (equal-state-v-c (kfg amap n) s))
 ]

(eval equal-state-c K0)

#(eval equal-state-c K3reduced)

define correctness-conjecture :=
(forall k .
	(equal-state-c
	 (reduce* (broadcast (broadcast k (insert 'v1)) (insert 'v2)))))

(falsify correctness-conjecture 30)
} # end module CRDT
open CRDT