define other-create-2 :=
  (forall T0 s0 id0 ls0 fr0 c0 id id1 .
    config T0 = s0 ++ (actor id0 ls0) ++ (message fr0 id0 c0) &
    Enabled (T0 then (create id id1)) &
    id =/= id0
    ==> exists s . config (T0 then (create id id1)) = 
                     s ++ (actor id0 ls0) ++ (message fr0 id0 c0))

 define proof :=
 method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        R*L := (!lemma ['-->> R*-lemma]);
        [LS0 next ready-to new-ls unique-ids before after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before 
		      after config]);
        [T-sort s-sort id-sort ls-sort _ _ _ _] :=
          (map sort-of (qvars-of (adapt theorem)))}
  conclude (adapt theorem)
     pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort 
              fr0:id-sort c0:Ide id:id-sort id1:id-sort
       let {a0 := (actor id0 ls0);
            a0' := (actor' id0 ls0);
            M0 := (One (message' fr0 LS0 id0 c0));
            M0' := match M0 {(One x) => x};
            A1 := (config T0 = s0 ++ a0 ++ M0);
            A2 := (Enabled (T0 then (create id id1)));
	    A3 := (id =/= id0)}
       assume (A1 & A2 & A3)
	 let {B1 := (!chain-> 
		    [A2
		     ==> (Enabled T0 & 
			   exists ?s ?ls .
			     (before T0 (create id id1) ?s ?ls))
		                             [enabled-step]]);
              UI2 := (!lemma unique-ids2);
	      3T := (!lemma Three-Together);
	      ECA := (exclusive-constructors "Actor-Cfg.Actor")}
         pick-witnesses s ls for (!right-and B1) B1-w
           let {a1 := (actor id ls);
                a1' := (actor' id ls);
                C1 := (!chain->
		       [B1-w
			==> (config T0 = s ++ a1)
			      [before.creating left-and]]);
	        C3 := (!chain-> 
		       [A3 ==> (a1' =/= a0')    [UI2]]);
                C5 := (!chain->
		       [true ==> (a1' =/= M0') [ECA]]);
                C7 := (!chain->
		       [(C1 & A1 & C3 & C5)
			==> (exists ?s2 .
                              config T0 = ?s2 ++ a1 ++ a0 ++ M0)
		      	   	            [3T]])}
           pick-witness s2 for C7 C7-w
             let {a2 := (actor id1 (new-ls ls));
		  D0 := (!chain->
			 [B1-w ==> ((count id1 config T0) = zero) 
			       [before.creating 
				method (p) (!left-and (!right-and p))]]);
		  D1 := (!chain->
			[B1-w ==> (ls ready-to (create id id1))
			              [before.creating right-and]])}
             (!chain-> 
	      [(config T0)
	       = (s2 ++ a1 ++ a0 ++ M0)    [C7-w]
	       = ((s2 ++ a0 ++ M0) ++ a1)  [++A ++C]
	       ==> (config T0 = (s2 ++ a0 ++ M0) ++ a1 & D0 & D1)
                                           [augment]
               ==> (before T0 (create id id1) 
			   (s2 ++ a0 ++ M0) ls)
	                                [before.creating]
               ==> (after T0 (create id id1) 
			  (s2 ++ a0 ++ M0) ls)
	                                [transition-step]
	       ==> (config (T0 then (create id id1))
		    = (s2 ++ a0 ++ M0) ++
                      (actor id (next ls (create id id1))) ++ a2)
			                [after.creating]
                    = ((s2 ++ (actor id (next ls (create id id1))) ++ a2)
		       ++ a0 ++ M0)     [++A ++C]
	       ==> (exists ?s .
		     config (T0 then (create id id1))
		     = ?s ++ a0 ++ M0) [existence]])

(evolve Theory [[other-create-2] proof])

#========================================================================

declare focus: (Id) [(Step Id)] -> Id

assert focus-definition :=
  (fun [(focus (receive id fr c)) = id 
	(focus (send id to c)) = id    
	(focus (create id id1)) = id])

define other-step-1 :=
  (forall T0 s0 id0 ls0 step .
    config T0 = s0 ++ (actor id0 ls0) &
    Enabled (T0 then step) &
    focus step =/= id0
    ==> exists s . config (T0 then step) = s ++ (actor id0 ls0))

define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain-> := method (L) (!chain-help given L 'last);
        config := (adapt config);
        [T-sort s-sort id-sort ls-sort step-sort] :=
          (map sort-of (qvars-of (adapt theorem)))}
   pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort step:step-sort
     let {A1 := (config T0 = s0 ++ (actor id0 ls0));
          A2 := (Enabled (T0 then step));
          A3 := (focus step =/= id0)}
     assume (A1 & A2 & A3)
       let {proof := 
             method (a-step id)
               let {B1 := (!chain-> [A3 ==> (focus a-step =/= id0) [(step = a-step)]
					   ==> (id =/= id0)           [focus-definition]]);
                    L1 := (!lemma match a-step {
                                    (receive _ _ _) => other-receive-1 
                                  | (send _ _ _) => other-send-1
                                  | (create _ _) => other-create-1
                                  })}
               (!chain->
		[A2 ==> (Enabled (T0 then a-step))           [(step = a-step)]
		    ==> (A1 & Enabled (T0 then a-step) & B1) [augment]
		    ==> (exists ?s . 
		          config (T0 then a-step) = ?s ++ (actor id0 ls0)) [L1]])}
       datatype-cases (exists ?s . config (T0 then step) = ?s ++ (actor id0 ls0))
                      on step {
         (receive id fr c) => (!proof (receive id fr c) id)
       | (send id to c) => (!proof (send id to c) id)
       | (create id id1) => (!proof (create id id1) id)
       }

(evolve Theory [[other-step-1] proof])

#========================================================================

 define actor-persistence :=
  (forall T T0 s0 id ls0 .
    config T0 = s0 ++ (actor id ls0) &
    T0 -->>* T
    ==> exists s ls . config T = s ++ (actor id ls))

 define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        R*L := (!lemma ['-->> R*-lemma]);
        [LS0 next ready-to new-ls unique-ids before after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before after config]);
        [T-sort _ s-sort id-sort ls-sort] := (map sort-of (qvars-of (adapt theorem)))}
   by-induction (adapt theorem) {
     (I as Initial:T-sort) =>
       pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort
         let {A1 := (config T0 = s0 ++ (actor id0 ls0));
              A2 := (T0 -->>* I)}
         assume (A1 & A2)
           let {goal := (exists ?s ?ls . config I = ?s ++ (actor id0 ?ls));
                B1 := (!chain-> [A2 ==> (T0 = I | T0 -->>+ I)  [R*L]])}
           (!cases B1
	     assume B1a := (T0 = I)
	       (!chain-> [A1 ==> (config I = s0 ++ (actor id0 ls0))  [B1a]
			        ==> goal 	                     [existence]])
             assume B1b := (T0 -->>+ I)
               (!from-complements goal B1b
		  (!chain-> [true ==> (~ B1b) [nothing-leads-to-Initial]])))
   | (T' as (T:T-sort then step)) =>
     let {ind-hyp := (forall ?T0 ?s0 ?id ?ls0 .
                        config ?T0 = ?s0 ++ (actor ?id ?ls0) &
			?T0 -->>* T
			==> exists ?s ?ls . config T = ?s ++ (actor ?id ?ls))}
     pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort
       let {A1 := (config T0 = s0 ++ (actor id0 ls0));
	    A2 := (T0 -->>* T')}
       assume (A1 & A2)
         let {B1 := (!chain-> [A2 ==> (T0 = T' | T0 -->>+ T')  [R*L]])}
         (!cases B1
           assume B1a := (T0 = T')
             (!chain-> [A1 ==> (config T' = s0 ++ (actor id0 ls0))  [B1a]
		              ==> (exists ?s ?ls .
			            config T' = ?s ++ (actor id0 ?ls)) [existence]])
           assume B1b := (T0 -->>+ T')
	     let {goal := (exists ?s:(Cfg (Actor 'Id 'LS)) ?ls:'LS .
                            config T' = ?s ++ (actor id0 ?ls));
                  LT := (!lemma leads-to);
		  C := (!chain-> 
			[B1b ==> (T0 -->>* T & Enabled T')          [LT]
			 ==> (T0 -->>* T)                           [left-and]
			 ==> (A1 & T0 -->>* T)                      [augment]
			 ==> (exists ?s1 ?ls1 . 
			       config T = ?s1 ++ (actor id0 ?ls1))  [ind-hyp]])}
             pick-witnesses s1 ls1 for C C-witnessed
	       let {D1 := (!chain-> 
		  	   [B1b ==> (T0 -->>* T & Enabled T')  [LT]
			    ==> (Enabled T')          [right-and]]);
                    D2 := (!chain->
			   [D1 ==> (Enabled T & 
			             exists ?s ?ls . (before T step ?s ?ls))   
                                                                 [enabled-step]])}
               pick-witnesses s ls for (!right-and D2) D2-witnessed
                 let {E1 := (!chain->
			     [D2-witnessed ==> (after T step s ls) [transition-step]])}

                 (!two-cases
                  assume F1 := (focus step = id0)
                    datatype-cases goal on step {
                      (Receive as (receive id:id-sort fr:id-sort c)) =>
                       let {G1 := (!chain [id = (focus Receive) [focus-definition]
					      = id0           [(step = Receive) F1]])}
   		       (!chain->    
			[E1 ==> (after T Receive s ls)  [(step = Receive)]
	                 ==> (config (T then Receive)
			      = s ++ (actor id (next ls Receive)))   [after.receiving]
			      = (s ++ (actor id0 (next ls Receive))) [G1]
		         ==> (exists ?s ?ls .
                               config (T then Receive) = ?s ++ (actor id0 ?ls)) 
                                                      [existence]])
                    | (Send as (send id:id-sort to:id-sort c)) => 
                       let {M := (One (message' id LS0 to c));
                            G1 := (!chain [id = (focus Send) [focus-definition]
					      = id0           [(step = Send) F1]])}
		       (!chain->
			[E1 ==> (after T Send s ls)   [(step = Send)]
		         ==> (config (T then Send)
			      = s ++ (actor id (next ls Send)) ++ M)     [after.sending]
			      = (s ++ (actor id0 (next ls Send)) ++ M)   [G1]
			      = ((s ++ M) ++ (actor id0 (next ls Send))) [++A ++C]
	                 ==> (exists ?s ?ls . 
                               config (T then Send) = ?s ++ (actor id0 ?ls)) [existence]])
                    | (Create as (create id:id-sort id1:id-sort)) => 
                       let {G1 := (!chain [id = (focus Create) [focus-definition]
					      = id0          [(step = Create) F1]])}
		       (!chain->
		        [E1 ==> (after T Create s ls)  [(step = Create)]
		         ==> (config (T then Create)
			      = s ++ (actor id (next ls Create))
			         ++ (actor id1 (new-ls ls)))     [after.creating]
			      = (s ++ (actor id0 (next ls Create))
			         ++ (actor id1 (new-ls ls)))     [G1]
			      = ((s ++ (actor id1 (new-ls ls))) ++
			         (actor id0 (next ls Create)))   [++A ++C]
		         ==> (exists ?s ?ls .
			      config (T then Create) = ?s ++ (actor id0 ?ls)) [existence]])
                    }
                  assume (focus step =/= id0)
                    let {OS1 := (!lemma other-step-1);
		         G1 := (!chain-> 
				[(C-witnessed & D1 & focus step =/= id0)
				 ==> (exists ?s2 . config T' =
                                                    ?s2 ++ (actor id0 ls1)) [OS1]])}
                    pick-witness s2 for G1 G1-w
                      (!chain-> [G1-w ==> goal [existence]])))
   } # close by-induction

 (evolve Theory [[actor-persistence] proof])

} # close module Transition-Path-Relation

