define other-send-2 :=
  (forall T0 s0 id0 ls0 fr0 c0 id to c .
    config T0 = s0 ++ (actor id0 ls0) ++ (message fr0 id0 c0) &
    Enabled (T0 then (send id to c)) &
    id =/= id0
    ==>
    exists s . 
      config (T0 then (send id to c)) = 
        s ++ (actor id0 ls0) ++ (message fr0 id0 c0))

 define proof :=
 method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        R*L := (!lemma ['-->> R*-lemma]);
        [LS0 next ready-to new-ls unique-ids before after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before 
		      after config]);
        [T-sort s-sort id-sort ls-sort _ _ _ _ _] :=
          (map sort-of (qvars-of (adapt theorem)))}
  conclude (adapt theorem)
     pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort 
              fr0:id-sort c0:Ide id:id-sort to:id-sort c:Ide
       let {a0 := (actor id0 ls0);
            a0' := (actor' id0 ls0);
            M0 := (constrain-sort (One (message' fr0 LS0 id0 c0)) ++ a0);
            M0' := match M0 {(One x) => x};
            A1 := (config T0 = s0 ++ a0 ++ M0);
            A2 := (Enabled (T0 then (send id to c)));
	    A3 := (id =/= id0)}
       assume (A1 & A2 & A3)
	 let {B1 := (!chain-> 
		    [A2
		     ==> (Enabled T0 & 
			   exists ?s ?ls .
			     (before T0 (send id to c) ?s ?ls))
		                             [enabled-step]]);
              UI2 := (!lemma unique-ids2);
	      3T := (!lemma Three-Together);
	      ECA := (exclusive-constructors "Actor-Cfg.Actor")}
         pick-witnesses s ls for (!right-and B1) B1-w
           let {a1 := (actor id ls);
                a1' := (actor' id ls);
                C1 := (!chain->
		       [B1-w
			==> (config T0 = s ++ a1)
			      [before.sending left-and]]);
	        C3 := (!chain-> 
		       [A3 ==> (a1' =/= a0')    [UI2]]);
                C5 := (!chain->
		       [true ==> (a1' =/= M0') [ECA]]);
                C7 := (!chain->
		       [(C1 & A1 & C3 & C5)
			==> (exists ?s2 .
                              config T0 = ?s2 ++ a1 ++ a0 ++ M0)
		      	   	            [3T]])}
           pick-witness s2 for C7 C7-w
             let {D1 := (!chain->
			[B1-w ==> (ls ready-to (send id to c))
			              [before.sending right-and]]);
                  M := (One (message' id LS0 to c))}
             (!chain-> 
	      [(config T0)
	       = (s2 ++ a1 ++ a0 ++ M0)    [C7-w]
	       = ((s2 ++ a0 ++ M0) ++ a1)  [++A ++C]
	       ==> (config T0 = (s2 ++ a0 ++ M0) ++ a1 & D1)
                                           [augment]
               ==> (before T0 (send id to c) 
			   (s2 ++ a0 ++ M0) ls)
	                                [before.sending]
               ==> (after T0 (send id to c) 
			  (s2 ++ a0 ++ M0) ls)
	                                [transition-step]
	       ==> (config (T0 then (send id to c))
		    = (s2 ++ a0 ++ M0) ++
                      (actor id (next ls (send id to c))) ++ M)
			                [after.sending]
                    = ((s2 ++ (actor id (next ls (send id to c))) ++ M)
		       ++ a0 ++ M0)     [++A ++C]
	       ==> (exists ?s .
		     config (T0 then (send id to c))
		     = ?s ++ a0 ++ M0) [existence]])

 (evolve Theory [[other-send-2] proof])

