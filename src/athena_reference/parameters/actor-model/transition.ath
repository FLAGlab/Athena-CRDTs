define other-send-1 :=
  (forall T0 s0 id0 ls0 id to c .
    config T0 = s0 ++ (actor id0 ls0) &
    Enabled (T0 then (send id to c)) &
    id =/= id0
    ==> 
    (exists s . 
      config (T0 then (send id to c)) = s ++ (actor id0 ls0)) &
    forall id' . (count id' config (T0 then (send id to c))) = 
                 (count id' config T0))

 define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        R*L := (!lemma ['-->> R*-lemma]);
        [LS0 next ready-to new-ls unique-ids before after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before 
		      after config]);
        [T-sort s-sort id-sort ls-sort _ _ _] :=
          (map sort-of (qvars-of (adapt theorem)))}
  conclude (adapt theorem)
     pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort 
              id:id-sort to:id-sort c:Ide
       let {a0 := (actor id0 ls0);
            a0' := (actor' id0 ls0);
            A1 := (config T0 = s0 ++ a0);
            A2 := (Enabled (T0 then (send id to c)));
	    A3 := (id =/= id0)}
       assume (A1 & A2 & A3)
	 let {B1 := (!chain-> 
		    [A2
		     ==> (Enabled T0 & 
			   exists ?s ?ls .
			     (before T0 (send id to c) ?s ?ls))
		                             [enabled-step]]);
              UI2 := (!lemma unique-ids2);
              2T := (!lemma Together);
              CI := (!constructor-injectivity message');
	      ECA := (exclusive-constructors "Actor-Cfg.Actor")}
         pick-witnesses s ls for (!right-and B1) B1-w
           let {a1 := (actor id ls);
                a1' := (actor' id ls);
                M := (One (message' id LS0 to c));
                C1 := (!chain->
		      [B1-w ==> (config T0 = s ++ a1)
			    [before.sending left-and]]);
	        C2 := (!chain-> 
		       [A3 ==> (id0 =/= id)     [sym]
			   ==> (a0' =/= a1')    [UI2]]);
                C4 := (!chain->
		      [(A1 & C1 & C2)
		       ==> (exists ?s2 .
                             config T0 = ?s2 ++ a0 ++ a1) [2T]])}
           pick-witness s2 for C4 C4-w
             let {D1 := (!chain->
			[B1-w ==> (ls ready-to (send id to c))
			              [before.sending right-and]]);
                  ls' := (next ls (send id to c));
                  D2 := 
		   (!chain-> 
		    [(config T0)
		     = (s2 ++ a0 ++ a1)     [C4-w]
		     = ((s2 ++ a0) ++ a1)   [++A]
		     ==> (config T0 = (s2 ++ a0) ++ a1 & D1)
                                            [augment]
                     ==> (before T0 (send id to c) 
				 (s2 ++ a0) ls)
	                                    [before.sending]
                     ==> (after T0 (send id to c) 
			         (s2 ++ a0) ls)
	                                [transition-step]
	             ==> (config (T0 then (send id to c))
		          = (s2 ++ a0) ++ (actor id ls') ++ M)
			                [after.sending]
                          = ((s2 ++ (actor id ls') ++ M) ++ a0)
		                        [++A ++C]]);
                  CIM := count.ignore-messages;
                  CILS := (!lemma count.ignore-local-state);
                  D4 := pick-any id'
		          (!chain
			   [(count id' config (T0 then (send id to c)))
			    = (count id' ((s2 ++ (actor id ls') ++ M) ++ a0)) [D2]
			    = (count id' ((s2 ++ (actor id ls') ++ a0) ++ M)) [++A ++C]
			    = (count id' (s2 ++ (actor id ls') ++ a0))        [CIM]
			    = (count id' ((s2 ++ a0) ++ (actor id ls')))      [++A ++C]
			    = (count id' ((s2 ++ a0) ++ a1))                  [CILS]
			    = (count id' (s2 ++ a0 ++ a1))                    [++A]
			    = (count id' config T0)                           [C4-w]]);
                  D5 := (!chain-> 
			 [D2 ==> (exists ?s .
			           config (T0 then (send id to c)) = ?s ++ a0)
			  [existence]])}
             (!both D5 D4)

 (evolve Theory [[other-send-1] proof])

