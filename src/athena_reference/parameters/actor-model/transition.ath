define other-create-1 :=
  (forall T0 s0 id0 ls0 id id1 .
    config T0 = s0 ++ (actor id0 ls0) &
    Enabled (T0 then (create id id1)) &
    id =/= id0
    ==>
    (exists s . 
      config (T0 then (create id id1)) = s ++ (actor id0 ls0)) &
    (count id1 config (T0 then (create id id1))) = one &
    forall id' . 
      (id' =/= id1 ==>
        (count id' config (T0 then (create id id1))) = 
	(count id' config T0)))

 define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        R*L := (!lemma ['-->> R*-lemma]);
        [LS0 next ready-to new-ls unique-ids before after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before 
		      after config]);
        [T-sort s-sort id-sort ls-sort _ _] :=
          (map sort-of (qvars-of (adapt theorem)))}
  conclude (adapt theorem)
     pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort 
              id:id-sort id1:id-sort
       let {a0 := (actor id0 ls0);
            a0' := (actor' id0 ls0);
            A1 := (config T0 = s0 ++ a0);
            A2 := (Enabled (T0 then (create id id1)));
	    A3 := (id =/= id0)}
       assume (A1 & A2 & A3)
	 let {B1 := (!chain-> 
		    [A2
		     ==> (Enabled T0 & 
			   exists ?s ?ls .
			     (before T0 (create id id1) ?s ?ls))
		                             [enabled-step]]);
              UI2 := (!lemma unique-ids2);
              2T := (!lemma Together);
              CI := (!constructor-injectivity message');
	      ECA := (exclusive-constructors "Actor-Cfg.Actor")}
         pick-witnesses s ls for (!right-and B1) B1-w
           let {a1 := (actor id ls);
                a1' := (actor' id ls);
                a3 := (actor id1 (new-ls ls));
                C1 := (!chain->
		      [B1-w
		       ==> (config T0 = s ++ a1)
			    [before.creating left-and]]);
	        C2 := (!chain-> 
		       [A3 ==> (id0 =/= id)     [sym]
			   ==> (a0' =/= a1')    [UI2]]);
                C4 := (!chain->
		      [(A1 & C1 & C2)
		       ==> (exists ?s2 .
                             config T0 = ?s2 ++ a0 ++ a1) [2T]])}
           pick-witness s2 for C4 C4-w
             let {D0 := (!chain->
			 [B1-w ==> ((count id1 config T0) = zero)
			       [before.creating 
				method (p) (!left-and (!right-and p))]]);
		  D1 := (!chain->
			[B1-w ==> (ls ready-to (create id id1))
		              [before.creating
			       method (p) (!left-and (!right-and (!right-and p)))]]);
                  ls' := (next ls (create id id1));
                  D2 :=
                   (!chain-> 
		    [(config T0)
		     = (s2 ++ a0 ++ a1)     [C4-w]
		     = ((s2 ++ a0) ++ a1)   [++A]
		     ==> (config T0 = (s2 ++ a0) ++ a1 & D0 & D1)
                                            [augment]
                     ==> (before T0 (create id id1) 
				 (s2 ++ a0) ls)
	                                    [before.creating]
                     ==> (after T0 (create id id1) 
			         (s2 ++ a0) ls)
	                                    [transition-step]
	             ==> (config (T0 then (create id id1))
			  = (s2 ++ a0) ++ (actor id ls') ++ a3)
			                [after.creating]
                          = ((s2 ++ (actor id ls') ++ a3) ++ a0) 
                                        [++A ++C]]);
                  CILS := (!lemma count.ignore-local-state);
                  D5 := (!chain
			 [(count id1 config (T0 then (create id id1)))
			  = (count id1 ((s2 ++ (actor id ls') ++ a3) ++ a0)) [D2]
			  = (count id1 ((s2 ++ a3 ++ a0) ++ (actor id ls'))) [++A ++C]
			  = (count id1 ((s2 ++ a3 ++ a0) ++ a1))             [CILS]
			  = (count id1 ((s2 ++ a0 ++ a1) ++ a3))             [++A ++C]
			  = (S (count id1 (s2 ++ a0 ++ a1)))                 [count.more]
			  = (S (count id1 (config T0)))                      [C4-w]
			  = (S zero)                                         [D0]
			  = one                                              [(one = S zero)]]);
                  D6 := pick-any id'
                          assume (id' =/= id1)
			    (!chain
			     [(count id' config (T0 then (create id id1)))
			      = (count id' ((s2 ++ (actor id ls') ++ a3) ++ a0)) [D2]
			      = (count id' ((s2 ++ a3 ++ a0) ++ (actor id ls'))) [++A ++C]
			      = (count id' ((s2 ++ a3 ++ a0) ++ a1))             [CILS]
			      = (count id' ((s2 ++ a0 ++ a1) ++ a3))             [++A ++C]
			      = (count id' (s2 ++ a0 ++ a1))                     [count.same]
			      = (count id' (config T0))                          [C4-w]]);
                  D7 := (!chain-> 
			 [D2 ==> (exists ?s .
			           config (T0 then (create id id1)) = ?s ++ a0)
			  [existence]])}
             (!both D7 (!both D5 D6))

 (evolve Theory [[other-create-1] proof])

