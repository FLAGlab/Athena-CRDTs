load "actors.ath"
load "transitive-closure.ath"
#----------------------------------------------------------------------------

datatype (Step Id) := (receive Id Id Ide) | (send Id Id Ide) | (create Id Id) 

datatype (TP Id LS) := Initial | (then (TP Id LS) (Step Id))

assert (datatype-axioms "Step")
assert (datatype-axioms "TP")

module Transition-Path {
open Actor-Cfg

declare config: (Id, LS) [(TP Id LS)] -> (Cfg (Actor Id LS))
declare ready-to: (Id, LS) [LS (Step Id)] -> Boolean
declare next: (Id, LS) [LS (Step Id)] -> LS
declare new-ls: (LS) [LS] -> LS

declare before, after: (Id, LS) 
  [(TP Id LS) (Step Id) (Cfg (Actor Id LS)) LS] -> Boolean

define [T T0 id id' ls fr to c s step] := 
  [?T:(TP 'Id 'LS) ?T0:(TP 'Id 'LS) ?id:'Id ?id':'Id ?ls:'LS 
   ?fr:'Id ?to:'Id ?c:Ide ?s:(Cfg (Actor 'Id 'Ls)) ?step:(Step 'Id)]

module before {
  define receiving := 
    (forall T id ls fr c s .
      (before T (receive id fr c) s ls) <==> 
        config T = s ++ (actor id ls) ++ (message fr id c) &
        ls ready-to (receive id fr c))
  define sending :=
    (forall T id ls to c s .
      (before T (send id to c) s ls) <==> 
        config T = s ++ (actor id ls) & 
        ls ready-to (send id to c))
  define creating :=
    (forall T id ls id' s .
      (before T (create id id') s ls) <==>
        config T = s ++ (actor id ls) & 
        (count id' config T) = zero &
        ls ready-to (create id id'))
  define axioms := [receiving sending creating]
} # close module before
module after {
  define receiving :=
    (forall T id ls fr c s .
      (after T (receive id fr c) s ls) <==>
        config (T then (receive id fr c)) = 
        s ++ (actor id (next ls (receive id fr c))))
  define sending :=
    (forall T id ls to c s .
      (after T (send id to c) s ls) <==> 
        config (T then (send id to c)) = 
        s ++ (actor id (next ls (send id to c)))
        ++ (message id to c))
  define creating :=
    (forall T id ls id' s .
      (after T (create id id') s ls) <==> 
        config (T then (create id id')) = 
  	s ++ (actor id (next ls (create id id')))
        ++ (actor id' (new-ls ls)))

  define axioms := [receiving sending creating]
} # close module after

define transition-step :=
   (forall T s ls step .
     (before T step s ls) ==> (after T step s ls))

define Theory :=
  (theory [Actor-Cfg.Theory] 
    (join [transition-step] before.axioms after.axioms)
    'Transition-Path)

define trans-receive :=
  (forall T id s ls fr c .
    config T = s ++ (actor id ls) ++ (message fr id c) &
    ls ready-to (receive id fr c)
    ==> 
    config (T then (receive id fr c)) =
    s ++ (actor id (next ls (receive id fr c))))

define trans-send :=
  (forall T id s ls to c .
    config T = s ++ (actor id ls) & 
    ls ready-to (send id to c)
    ==> config (T then (send id to c)) = 
	s ++ (actor id (next ls (send id to c)))
	++ (message id to c))

define trans-create :=
  (forall T id s ls id' .
    config T = s ++ (actor id ls) &
    (count id' config T) = zero & 
    ls ready-to (create id id')
    ==> config (T then (create id id')) = 
        s ++ (actor id (next ls (create id id'))) ++
        (actor id' (new-ls ls)))

define proofs := 
  method (theorem adapt)
    let {given := lambda (P) (get-property P adapt Theory);
         chain := method (L) (!chain-help given L 'none);
         chain-> := method (L) (!chain-help given L 'last);
         [LS0 config before after next ready-to new-ls unique-ids] :=
           (adapt [LS0 config before after next ready-to new-ls unique-ids])}
    match theorem {
      (val-of trans-receive) =>
      let {[T-sort id-sort s-sort ls-sort _ _] := 
             (map sort-of (qvars-of (adapt theorem)))}
      pick-any T:T-sort id:id-sort s:s-sort ls:ls-sort fr:id-sort c:Ide
        let {A1 := (config T = s ++ (actor id ls) ++ (One (message' fr LS0 id c)));
             A2 := (ls ready-to (receive id fr c))}
        (!chain
	 [(A1 & A2) 
	  ==> (before T (receive id fr c) s ls)
	            [before.receiving]
          ==> (after T (receive id fr c) s ls)
	            [transition-step]
	  ==> (config (T then (receive id fr c)) = 
                s ++ (actor id (next ls (receive id fr c))))
	            [after.receiving]])
    | (val-of trans-send) =>
      let {[T-sort id-sort s-sort ls-sort _ _] := 
             (map sort-of (qvars-of (adapt theorem)))}
      pick-any T:T-sort id:id-sort s:s-sort ls:ls-sort to:id-sort c:Ide
        let {A1 := (config T = s ++ (actor id ls));
             A2 := (ls ready-to (send id to c))}
        (!chain
	 [(A1 & A2) 
	  ==> (before T (send id to c) s ls)
	            [before.sending]
          ==> (after T (send id to c) s ls)
	            [transition-step]
	  ==> (config (T then (send id to c)) = 
                s ++ (actor id (next ls (send id to c)))
                ++ (One (message' id LS0 to c)))
	            [after.sending]])
    | (val-of trans-create) =>
      let {[T-sort id-sort s-sort ls-sort _] := 
             (map sort-of (qvars-of (adapt theorem)))}
      pick-any T:T-sort id:id-sort s:s-sort ls:ls-sort id':id-sort
        let {A1 := (config T = s ++ (actor id ls));
             A2 := ((count id' config T) = zero);
             A3 := (ls ready-to (create id id'))}
        assume (A1 & A2 & A3)
        (!chain->
	 [(A1 & A2 & A3) 
	  ==> (before T (create id id') s ls)
	            [before.creating]
          ==> (after T (create id id') s ls)
	            [transition-step]
	  ==> (config (T then (create id id')) = 
                s ++ (actor id (next ls (create id id')))
                ++ (actor id' (new-ls ls)))
	            [after.creating]])
    }

(evolve Theory [[trans-receive trans-send trans-create] proofs])

define unique-ids-step-persistence :=
  (forall T step s ls .
    (before T step s ls) & (unique-ids config T)
    ==> (unique-ids config (T then step)))

define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        _ := (!lemma uids-ignore-messages);
        _ := (!lemma unique-ids0);
        [LS0 next ready-to new-ls unique-ids before 
	     after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before 
		      after config]);
	theorem' := (adapt theorem);
        T-sort := (sort-of (first (qvars-of theorem')));
        dummy := pick-any T:T-sort s id ls 
                    (!reflex ((config T) = s ++ (actor id ls)));
        id-sort := (sort-of (third (qvars-of dummy)))}
   match theorem {
    (val-of unique-ids-step-persistence) =>
    conclude theorem'
     let {step-sort := (sort-of (second (qvars-of theorem')))}
     pick-any T:T-sort step:step-sort s ls
       let {A1 := (before T step s ls);
            A2 := (unique-ids config T);
            goal := (unique-ids config (T then step))}
       assume (A1 & A2)
         datatype-cases goal on step {
           (Receive as (receive id fr c)) => 
             let {M := (One (message' fr LS0 id c));
                  B1 := (!chain-> [A1 ==> (before T Receive s ls) 
                                              [(step = Receive)]]);
                  B2 := (!chain-> [B1 ==> (config T = s ++ (actor id ls) ++ M) 
			                      [before.receiving left-and]]);
                  B3 := (!chain-> 
			 [B1
		      ==> (after T Receive s ls)  [transition-step]
		      ==> (config (T then Receive) =
			   s ++ (actor id (next ls Receive)))
                                                          [after.receiving]])}
             (!chain-> [A2
		    ==> (unique-ids s ++ (actor id ls) ++ M)   [B2]
		    ==> (unique-ids (s ++ (actor id ls)) ++ M) [++A]
		    ==> (unique-ids s ++ (actor id ls))
		                                 [uids-ignore-messages]
                    ==> ((unique-ids s) & (count id s) = zero)
 		                                 [unique-ids0]
                    ==> (unique-ids s ++ (actor id (next ls Receive)))
		                                 [unique-ids0]
		    ==> (unique-ids config (T then Receive)) [B3]])
         | (Send as (send id to c)) => 
             let {M := (One (message' id LS0 to c));
		  B1 := (!chain-> 
			 [A1 ==> (before T Send s ls)
                                     [(step = Send)]]);
                  B2 := (!chain-> [B1 ==> (config T = s ++ (actor id ls)) 
			                      [before.sending left-and]]);
                  B3 := (!chain-> 
			 [B1 
		      ==> (after T Send s ls)  [transition-step]
		      ==> (config (T then Send) =
			   s ++ (actor id (next ls Send)) ++ M)
                                                       [after.sending]])}
             (!chain-> [A2
		   ==> (unique-ids s ++ (actor id ls))   [B2]
                   ==> ((unique-ids s) & (count id s) = zero)
		                                 [unique-ids0]
                   ==> (unique-ids s ++ (actor id (next ls Send)))
		                                 [unique-ids0]
		   ==> (unique-ids (s ++ (actor id (next ls Send))) ++ M)
		                                 [uids-ignore-messages]
		   ==> (unique-ids s ++ (actor id (next ls Send)) ++ M)
		                                 [++A]
		   ==> (unique-ids config (T then Send)) [B3]])
         | (Create as (create id id')) => 
             let {B1 := (!chain->
			 [A1 ==> (before T Create s ls)
                                      [(step = Create)]]);
                  B2 := (!chain-> [B1 ==> (config T = s ++ (actor id ls))
                                               [before.creating left-and]]);
                  B3 := (!chain->
			 [B1
		       ==> (after T Create s ls)  [transition-step]
		       ==> (config (T then Create) =
                            s ++ (actor id (next ls Create))
                            ++ (actor id' (new-ls ls)))    [after.creating]])}
             (!chain-> [B1 ==> ((count id' config T) = zero)  
                                                 [before.creating left-and]
		     ==> (A2 & (count id' config T) = zero)   [augment]
		     ==> (unique-ids (config T) ++ (actor id' new-ls ls))
                                                        [unique-ids0]
		     ==> (unique-ids 
                           (s ++ (actor id ls)) ++ (actor id' (new-ls ls))) 
                                                        [B2]
		     ==> (unique-ids 
                           (s ++ (actor id' (new-ls ls))) ++ (actor id ls)) 
                                                        [++A ++C]
		     ==> ((unique-ids s ++ (actor id' (new-ls ls))) & 
			  (count id (s ++ (actor id' (new-ls ls)))) = zero)
		                                        [unique-ids0]
		     ==> (unique-ids (s ++ (actor id' (new-ls ls))) ++
				     (actor id (next ls  Create)))
		                                        [unique-ids0]
		     ==> (unique-ids 
                           s ++ (actor id (next ls Create)) ++
		           (actor id' (new-ls ls)))     [++A ++C]
		     ==> (unique-ids config (T then Create)) [B3]])
         } # close datatype-cases
   } # close match 

(evolve Theory [[unique-ids-step-persistence] proof])

#............................................................
declare Enabled: (Id, LS) [(TP Id LS)] -> Boolean

define enabled-Initial := (Enabled Initial)

define enabled-step :=
  (forall T step .
    Enabled (T then step) <==>
    Enabled T & exists s ls . (before T step s ls))

(evolve Theory [[enabled-Initial enabled-step] Axiom])

} # close module Transition-Path

#===========================================================

module Transition-Step-Relation {
 open Transition-Path

 # -->>, a binary predicate on transition paths.
 declare -->>: (Id, LS) [(TP Id LS) (TP Id LS)] -> Boolean

 define directly-leads-to :=
  (forall T0 T step .
    T0 -->> (T then step) ==> T0 = T & Enabled (T then step))

 define Theory := 
  (theory [Transition-Path.Theory] [directly-leads-to]
    'Transition-Step-Relation)					      
} # close module Transition-Step-Relation

#............................................................
# -->>+ and -->>*, binary predicates on transition paths (the 
# irreflexive and reflexive transitive closures of -->>).

module Transition-Path-Relation {
 open Transition-Step-Relation
 open Transitive-Closure
 declare -->>+, -->>*: 
  (Id, LS) [(TP Id LS) (TP Id LS)] -> Boolean
 declare -->>**: 
  (Id, LS) [N (TP Id LS) (TP Id LS)] -> Boolean
 define nothing-leads-to-Initial := 
  (forall T . ~ T -->>+ Initial)
 define Theory :=
  (theory [Transition-Step-Relation.Theory
	   [Transitive-Closure.Theory 
	    '-->> [R -->>  R+ -->>+  R* -->>*  R** -->>**]]]
          [nothing-leads-to-Initial]
	  'Transition-Path-Relation)

define leads-to :=
  (forall T0 T step .
    T0 -->>+ (T then step)
    ==> (T0 -->>* T & Enabled (T then step)))

 define proof :=
  method (theorem adapt)
    let {given := lambda (P) (get-property P adapt Theory);
	 lemma := method (P) (!property P adapt Theory);
         chain-> := method (L)(!chain-help given L 'last);
         RR*I := (!lemma ['-->> R+R*-inclusion]);
         R+L := (!lemma ['-->> R+-lemma]);
         R*L := (!lemma ['-->> R*-lemma]);
         directly := directly-leads-to}
    pick-any T0 T step
      assume A := (T0 -->>+ (T then step))
            let {B1 := (!chain->
			[A ==> 
			   (T0 -->> (T then step) |
			    (exists ?T1 . 
                              T0 -->>+ ?T1 & 
			      ?T1 -->> (T then step)))
                                              [R+L]])}
            (!cases B1
              assume C1 := (T0 -->> (T then step))
                let {(and D1 D2) :=
		       (!chain->
			[C1 ==> (T0 = T & 
				 Enabled (T then step))
                                              [directly]])}
		(!chain->
		 [D1 ==> (D1 | T0 -->>+ T)    [alternate]
		     ==> (T0 -->>* T)         [R*L]
		     ==> (T0 -->>* T & D2)    [augment]
		     ==> (T0 -->>* T & 
			  Enabled (T then step)) [D1]])
              assume C2 := (exists ?T1 . 
			     T0 -->>+ ?T1 & 
			     ?T1 -->> (T then step))
                pick-witness T1 for C2 C2-w
                  let {C2-w1 := (T0 -->>+ T1);
                       C2-w2 := (T1 -->> (T then step));
                       (and D1 D2) := 
		         (!chain->
			  [C2-w2 
			   ==> (T1 = T & 
				Enabled (T then step))
                                                [directly]]);
                       RR*I := (!lemma 
				  ['-->> R+R*-inclusion])}
                  (!chain->
		   [C2-w1 ==> (T0 -->>+ T)      [D1]
			  ==> (T0 -->>* T)      [RR*I]
			  ==> (T0 -->>* T & D2) [augment]
			  ==> (T0 -->>* T & 
			       Enabled (T then step))
                                                [D1]]))

(evolve Theory [[leads-to] proof])

define unique-ids-persistence :=
  (forall T T0 . 
    (unique-ids config T0) & T0 -->>* T ==> (unique-ids config T))

define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        R*L := (!lemma ['-->> R*-lemma]);
        [LS0 next ready-to new-ls unique-ids before 
	     after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before 
		      after config]);
	theorem' := (adapt theorem);
        T-sort := (sort-of (first (qvars-of theorem')));
        dummy := pick-any T:T-sort s id ls 
                    (!reflex ((config T) = s ++ (actor id ls)));
        id-sort := (sort-of (third (qvars-of dummy)))}
   match theorem {
    (val-of unique-ids-persistence) =>
    by-induction theorem' {
     (I as Initial:T-sort) =>
     pick-any T0:T-sort
       let {A1 := (unique-ids config T0);
            A2 := (T0 -->>* I)}
       assume (A1 & A2)
         let {B1 := (!chain-> 
		     [A2 ==> (T0 = I | 
			      T0 -->>+ I) [R*L]])}
         (!cases B1
          assume C1 := (T0 = I)
           (!chain-> 
            [A1 ==> (unique-ids config I) [C1]])
          assume C2 := (T0 -->>+ I)
           (!from-complements (unique-ids config I)
	    C2
	    (!chain-> 
	     [true ==> (~ C2) [nothing-leads-to-Initial]])))
   | (T' as (T:T-sort then step)) =>
     let {ind-hyp := (forall ?T0  .
                        (unique-ids config ?T0) & 
                        (?T0 -->>* T)
			==> (unique-ids config T));
          goal := (unique-ids config T');
	  LT := (!lemma leads-to)}
     pick-any T0:T-sort
       let {A1 := (unique-ids config T0);
	    A2 := (T0 -->>* T')}
       assume (A1 & A2)
         let {B1 := (!chain-> [A2 ==> (T0 = T' | T0 -->>+ T')   [R*L]])}
         (!cases B1
           assume B1a := (T0 = T')
             (!chain-> [A1 ==> (unique-ids config T')  [B1a]])
           assume B1b := (T0 -->>+ T')
	     let {D := (!chain-> 
			[B1b 
			 ==> (T0 -->>* T & Enabled T')  [LT]
			 ==> (T0 -->>* T & Enabled T & 
			      exists ?s ?ls . (before T step ?s ?ls))
                                            [enabled-step]]);
                  D1 := (!left-and D);
                  D2 := (!chain-> [(A1 & D1) ==> (unique-ids config T) 
				                   [ind-hyp]]);
                  UISP := (!lemma unique-ids-step-persistence)}
             pick-witnesses s ls for (!right-and (!right-and D)) D-w
               (!chain-> [(D-w & D2) ==> goal [UISP]]))
   } # close by-induction
 } # match theorem

(evolve Theory [[unique-ids-persistence] proof])

#========================================================================

define [s0 id0 ls0] := [?s0:(Cfg (Actor 'Id 'LS)) ?id0:'Id ?ls0:'LS]

define other-receive-1 :=
  (forall T0 s0 id0 ls0 id fr c .
    config T0 = s0 ++ (actor id0 ls0) &
    Enabled (T0 then (receive id fr c)) &
    id =/= id0
    ==>
    (exists s . 
      config (T0 then (receive id fr c)) = s ++ (actor id0 ls0)) &
    forall id' . (count id' config (T0 then (receive id fr c))) = 
                  (count id' config T0))

 define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        R*L := (!lemma ['-->> R*-lemma]);
        [LS0 next ready-to new-ls unique-ids before after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before 
		      after config]);
        [T-sort s-sort id-sort ls-sort _ _ _] :=
          (map sort-of (qvars-of (adapt theorem)))}
  conclude (adapt theorem)
     pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort 
              id:id-sort fr:id-sort c:Ide
       let {a0 := (actor id0 ls0);
            a0' := (actor' id0 ls0);
            A1 := (config T0 = s0 ++ a0);
            A2 := (Enabled (T0 then (receive id fr c)));
	    A3 := (id =/= id0)}
       assume (A1 & A2 & A3)
	 let {B1 := (!chain-> 
		    [A2
		     ==> (Enabled T0 & 
			   exists ?s ?ls .
			     (before T0 (receive id fr c) ?s ?ls))
		                             [enabled-step]]);
              UI2 := (!lemma unique-ids2);
              3T := (!lemma Three-Together);
              CI := (!constructor-injectivity message');
	      ECA := (exclusive-constructors "Actor-Cfg.Actor")}
         pick-witnesses s ls for (!right-and B1) B1-w
           let {a1 := (actor id ls);
                a1' := (actor' id ls);
                M := (One (message' fr LS0 id c));
                M' := match M {(One x) => x};
                C1 := (!chain->
		      [B1-w
		       ==> (config T0 = s ++ a1 ++ M)
			    [before.receiving left-and]]);
	        C2 := (!chain-> 
		       [A3 ==> (id0 =/= id)     [sym]
			   ==> (a0' =/= a1')    [UI2]]);
                C3 := (!chain->
		       [true ==> (a0' =/= M')   [ECA]]);
                C4 := (!chain->
		      [(A1 & C1 & C2 & C3)
		       ==> (exists ?s2 .
                             config T0 = ?s2 ++ a0 ++ a1 ++ M)
		      	   	            [3T]])}
           pick-witness s2 for C4 C4-w
             let {D1 := (!chain->
			[B1-w ==> (ls ready-to (receive id fr c))
			              [before.receiving right-and]]);
                  ls' := (next ls (receive id fr c));
                  D2 := 
                   (!chain-> 
		    [(config T0)
		     = (s2 ++ a0 ++ a1 ++ M)     [C4-w]
		     = ((s2 ++ a0) ++ a1 ++ M)   [++A]
		     ==> (config T0 = (s2 ++ a0) ++ a1 ++ M & D1)
		                                 [augment]
                     ==> (before T0 (receive id fr c) 
				 (s2 ++ a0) ls)
	                                [before.receiving]
                     ==> (after T0 (receive id fr c) 
				(s2 ++ a0) ls)
	                                [transition-step]
	             ==> (config (T0 then (receive id fr c))
			  = (s2 ++ a0) ++ (actor id ls'))
			                [after.receiving]
                          = ((s2 ++ (actor id ls')) ++ a0)
                                        [++A ++C]]);
                  CIM := count.ignore-messages;
                  CILS := (!lemma count.ignore-local-state);
                  D4 := pick-any id'
		          (!chain
			   [(count id' config (T0 then (receive id fr c)))
			    = (count id' ((s2 ++ (actor id ls')) ++ a0))   [D2]
			    = (count id' ((s2 ++ a0) ++ (actor id ls')))   [++A ++C]
			    = (count id' ((s2 ++ a0) ++ a1))               [CILS]
			    = (count id' (s2 ++ a0 ++ a1))                 [++A]
			    = (count id' ((s2 ++ a0 ++ a1) ++ M))          [CIM]
			    = (count id' (s2 ++ a0 ++ a1 ++ M))            [++A]
			    = (count id' config T0)                        [C4-w]]);
                  D5 := (!chain-> 
			 [D2 ==> (exists ?s .
			           config (T0 then (receive id fr c)) = ?s ++ a0)
			  [existence]])}
             (!both D5 D4)

 (evolve Theory [[other-receive-1] proof])

#========================================================================

define constrain-sort :=
  lambda (x op y)
    match (op x y) {
      (op _x _y) => _x
   }

define [fr0 c0] := [?fr0:'Id ?c0:Ide]

define other-receive-2 :=
  (forall T0 s0 id0 ls0 fr0 c0 id fr c .
    config T0 = s0 ++ (actor id0 ls0) ++ (message fr0 id0 c0) &
    Enabled (T0 then (receive id fr c)) &
    id =/= id0
    ==> exists s . 
         config (T0 then (receive id fr c)) = 
           s ++ (actor id0 ls0) ++ (message fr0 id0 c0))

 define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        ++A := (given ['++ Associative]);
	++C := (given ['++ Commutative]);
        R*L := (!lemma ['-->> R*-lemma]);
        [LS0 next ready-to new-ls unique-ids before after config] := 
          (adapt [LS0 next ready-to new-ls unique-ids before 
		      after config]);
        [T-sort s-sort id-sort ls-sort _ _ _ _ _] :=
          (map sort-of (qvars-of (adapt theorem)))}
   conclude (adapt theorem)
     pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort 
              fr0:id-sort c0:Ide id:id-sort fr:id-sort c:Ide
       let {a0 := (actor id0 ls0);
            a0' := (actor' id0 ls0);
            M0 := (constrain-sort (One (message' fr0 LS0 id0 c0)) ++ a0);
            M0' := match M0 {(One x) => x};
            A1 := (config T0 = s0 ++ a0 ++ M0);
            A2 := (Enabled (T0 then (receive id fr c)));
	    A3 := (id =/= id0)}
       assume (A1 & A2 & A3)
	 let {B1 := (!chain-> 
		    [A2
		     ==> (Enabled T0 & 
			   exists ?s ?ls .
			     (before T0 (receive id fr c) ?s ?ls))
		                             [enabled-step]]);
              UI2 := (!lemma unique-ids2);
	      4T := (!lemma Four-Together);
              CI := (!constructor-injectivity message');
	      ECA := (exclusive-constructors "Actor-Cfg.Actor")}
         pick-witnesses s ls for (!right-and B1) B1-w
           let {a1 := (actor id ls);
                a1' := (actor' id ls);
                M := (constrain-sort 
		      (One (message' fr LS0 id c)) ++ a1);
                M' := match M {(One x) => x};
                C1 := (!chain->
		       [B1-w
			==> (config T0 = s ++ a1 ++ M)
			      [before.receiving left-and]]);
                C2 := (!chain->
		       [true ==> (a0' =/= M0') [ECA]]);
	        C3 := (!chain-> 
		       [A3 ==> (id0 =/= id)     [sym]
			   ==> (a0' =/= a1')    [UI2]]);
                C4 := (!chain->
		       [true ==> (a0' =/= M')   [ECA]]);
                C5 := (!chain->
		       [true ==> (a1' =/= M0')  [ECA]
		             ==> (M0' =/= a1')  [sym]]);
                C6 := (!by-contradiction (M0' =/= M')
		       assume (M0' = M')
                         let {C6z := (!mp (!left-iff (!uspec* CI 
							      [fr0 LS0 id0 c0 
								   fr LS0 id c]))
					  (M0' = M'));
                              C6a := (!chain->
				      [C6z
#                               C6a := (!chain->
# 				      [(M0' = M')
# 				       ==> (and (fr0 = fr)
# 						(LS0 = LS0)
# 						(id0 = id)
# 						(c0 = c))
#  				              [CI]
				       ==> (id0 = id)
				              [method (p) 
						(!left-and 
						 (!right-and 
						  (!right-and p)))]])}
                         (!absurd (!sym C6a) (id =/= id0)));
                C7 := (!chain->
		       [(A1 & C1 & C2 & C3 & C4 & C5 & C6)
			==> (exists ?s2 .
                              config T0 = ?s2 ++ a0 ++ M0 ++ a1 ++ M)
		      	   	            [4T]])}
           pick-witness s2 for C7 C7-w
             let {D1 := (!chain->
			[B1-w ==> (ls ready-to (receive id fr c))
			              [before.receiving right-and]])}
             (!chain-> 
	      [(config T0)
	       = (s2 ++ a0 ++ M0 ++ a1 ++ M)     [C7-w]
	       = ((s2 ++ a0 ++ M0) ++ a1 ++ M)   [++A]
	       ==> (config T0 = (s2 ++ a0 ++ M0) ++ a1 ++ M & D1)
                                                 [augment]
               ==> (before T0 (receive id fr c) 
			   (s2 ++ a0 ++ M0) ls)
	                                [before.receiving]
               ==> (after T0 (receive id fr c) 
			  (s2 ++ a0 ++ M0) ls)
	                                [transition-step]
	       ==> (config (T0 then (receive id fr c))
		    = (s2 ++ a0 ++ M0) ++
                      (actor id (next ls (receive id fr c))))
			                [after.receiving]
                    = ((s2 ++ (actor id (next ls (receive id fr c))))
		       ++ a0 ++ M0)     [++A ++C]
	       ==> (exists ?s .
		     config (T0 then (receive id fr c))
		     = ?s ++ a0 ++ M0) [existence]])

 (evolve Theory [[other-receive-2] proof])

