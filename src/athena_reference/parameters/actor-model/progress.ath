load "fairness.ath"

module Progress {
open IOE-Fair-Transition-Path

define n0 := ?n0:N

define eventually-ready-to-receive :=
  (forall T n0 s0 ls0 c .
    config (itp T n0) = 
      s0 ++ (actor receiver ls0) ++ (message sender receiver c) &
    (unique-ids config (itp T n0))
    ==>
    exists n s ls . 
      n >= n0 &
      config (itp T n) = 
        s ++ (actor receiver ls) ++ (message sender receiver c) &
        ls ready-to (receive receiver sender c))

define Theory := 
  (theory [IOE-Fair-Transition-Path.Theory]
     [eventually-ready-to-receive] 'Progress)

define guaranteed-message-reception :=
  (forall T n0 s0 ls0 ls1 c .
    config (itp T n0) = 
      s0 ++ (actor sender ls0) ++ (actor receiver ls1) &
    ls0 ready-to (send sender receiver c) &
    (unique-ids config (itp T n0))
    ==>
    exists n s ls2 ls3 . 
      n >= n0 &
      config (itp T n) = 
        (s ++ (actor sender ls2)) ++ (actor receiver ls3) ++ 
        (message sender receiver c) &
      ls3 ready-to (receive receiver sender c) &
      (itp T (S n)) = (itp T n) then (receive receiver sender c))

define proof :=
  method (theorem adapt)
    let {given := lambda (P) (get-property P adapt Theory);
         lemma := method (P) (!property P adapt Theory);
         ++A := (given ['++ Associative]);
         ++C := (given ['++ Commutative]);
         [sender receiver contents LS0 itp next ready-to unique-ids config] := 
           (adapt [sender receiver contents LS0 itp next ready-to unique-ids config]);
         [T-sort _ s-sort ls-sort _ _] := 
            (map sort-of (qvars-of (adapt theorem)))}
    match theorem {
      (val-of guaranteed-message-reception) =>
      pick-any T:T-sort n0 s0:s-sort ls0:ls-sort ls1:ls-sort c:Ide
        let {A1 := (config (itp T n0) = 
                     s0 ++ (actor sender ls0) ++ (actor receiver ls1));
             A2 := (ls0 ready-to (send sender receiver c));
             A3 := (unique-ids config (itp T n0));
             MM := (One (message' sender LS0 receiver c))}
        assume (A1 & A2 & A3)
          let {goal := (exists ?n ?s ?ls2 ?ls3 .
                         ?n >= n0 &
                         config (itp T ?n) = 
                           (?s ++ (actor sender ?ls2)) ++ 
                           (actor receiver ?ls3) ++ MM &
                         ?ls3 ready-to (receive receiver sender c) &
                         (itp T (S ?n)) = 
                           (itp T ?n) then (receive receiver sender c));
               UI3 := (!lemma unique-ids3);
               B0 := (!chain->
                      [A3 
                       ==> (unique-ids 
                             s0 ++ (actor sender ls0) ++ (actor receiver ls1))
                                          [A1]
                       ==> (sender =/= receiver)    [UI3]]);
               B1 := (!chain->
                      [A1 ==> (config (itp T n0) = 
                                 ((s0 ++ (actor receiver ls1)) ++ 
                                 (actor sender ls0)))   [++A ++C]]);
               SH := (!lemma send-happens);
               B2 := (!chain->
                      [(B1 & A2) 
                       ==> (exists ?k ?s' ?ls' .
                             ?k >= n0 &
                             config (itp T ?k) = 
                               ?s' ++ (actor sender ?ls') &
                             ?ls' ready-to (send sender receiver c) &
                             (itp T (S ?k)) = 
                               (itp T ?k) then (send sender receiver c))
                                                    [SH]])}
          pick-witnesses n1 s' ls' for B2
           let {B2-w1 := (n1 >= n0);
                B2-w2 := (config (itp T n1) = s' ++ (actor sender ls'));
                B2-w3 := (ls' ready-to (send sender receiver c));
                B3-w4 := ((itp T (S n1)) = 
                          (itp T n1) then (send sender receiver c));
                C1 := (!chain
                       [(config (itp T (S n1)))
                        = (config ((itp T n1) then (send sender receiver c)))  
                                                   [B3-w4]]);
                C2 := (!chain->
                       [A1 ==> (config (itp T n0) =
                                  (s0 ++ (actor sender ls0)) ++ 
                                  (actor receiver ls1))    [++A]]);
                ITPC := (!lemma itp-connected);
                C3 := (!chain->
                       [B2-w1 ==> ((itp T n0) -->>* (itp T n1)) [ITPC]]);
                AP := (!lemma actor-persistence);
                C4 := (!chain-> 
                       [(C2 & C3) 
                        ==> (exists ?s ?ls . 
                              config (itp T n1) = ?s ++ (actor receiver ?ls))
                                                     [AP]])}
           pick-witnesses s'' ls'' for C4
            let {C4-w := (config (itp T n1) = s'' ++ (actor receiver ls''));
                 UIP := (!lemma unique-ids-persistence);
                 UI2 := (!lemma unique-ids2);
                 D1 := (!chain-> 
                        [(sender =/= receiver)
                         ==> ((actor' sender ls') =/= (actor' receiver ls'')) 
                        [UI2]]);
                 TG := (!lemma Together);
                 D2 := (!chain->
                        [(B2-w2 & C4-w & D1) 
                         ==> (exists ?s3 .
                               config (itp T n1) = 
                                ?s3 ++ (actor sender ls') ++ 
                                (actor receiver ls''))       [TG]])}
            pick-witness s3 for D2 D2-w
             let {E1 := (!chain
                         [(config (itp T n1))
                          = (s3 ++ (actor sender ls') ++ 
                             (actor receiver ls''))      [D2-w]
                          = ((s3 ++ (actor receiver ls'')) ++ 
                             (actor sender ls'))             [++A ++C]]);
                  TS := (!lemma trans-send);
                  E2 := (!chain->
                         [(E1 & B2-w3)
                          ==> (config ((itp T n1) then 
                                       (send sender receiver c))
                               = (s3 ++ (actor receiver ls''))
                                  ++ (actor sender 
                                       (next ls' (send sender receiver c)))
                                  ++ MM)         [TS]
                          ==> (config (itp T (S n1))
                               = (s3 ++ (actor receiver ls''))
                                  ++ (actor sender 
                                       (next ls' (send sender receiver c)))
                                  ++ MM)         [C1]
                               = ((s3 ++ (actor sender 
                                           (next ls' 
					      (send sender receiver c))))
                                  ++ (actor receiver ls'') ++ MM)
                                                 [++A ++C]]);
                  E2a := (!chain->
                          [true ==> (n1 <= (S n1)) [Less=.S3]]);
                  E2b := (!combine-inequalities
                          [(n1 >= n0)        # B2-w1
                           ((S n1) >= n1)]); # E2a
                  UIP := (!lemma unique-ids-persistence);
                  E3a := (!chain-> 
                          [(A3 & E2b) 
                           ==> (unique-ids config (itp T (S n1))) [UIP]]);
                  E3 := (!chain->
                         [E3a
                          ==> (E2 & E3a)                 [augment]
                          ==> (exists ?n ?s ?ls . 
                                ?n >= (S n1) &
                                config (itp T ?n) = 
                                  ?s ++ (actor receiver ?ls) ++ MM &
                                ?ls ready-to (receive receiver sender c))
                             [(given eventually-ready-to-receive)]])}
             pick-witnesses n2 s2 ls2 for E3
              let {E3-w1 := (n2 >= (S n1));
                   E3-w2 := (config (itp T n2) =
                               s2 ++ (actor receiver ls2) ++ MM);
                   E3-w3 := (ls2 ready-to (receive receiver sender c));
                   RH := (!lemma receive-happens);
                   F1a := (!chain->
                           [(E3a & E3-w1)
                            ==> (unique-ids config (itp T n2)) [UIP]]);
                   F1 := (!chain->
                          [(F1a & E3-w2 & E3-w3)
                           ==> (exists ?k ?s' ?ls' .
                                 ?k >= n2 &
                                 config (itp T ?k) = 
                                   ?s' ++ (actor receiver ?ls') ++ MM &
                                 ?ls' ready-to (receive receiver sender c) &
                                 (itp T (S ?k)) = 
                                  (itp T ?k) then (receive receiver sender c))
                                                [RH]])}
              pick-witnesses n3 s3 ls3 for F1
               let {F1-w1 := (n3 >= n2);
                    F1-w2 := (config (itp T n3) =
                                s3 ++ (actor receiver ls3) ++ MM);
                    F1-w3 := (ls3 ready-to (receive receiver sender c));
                    F1-w4 := ((itp T (S n3)) = 
                              (itp T n3) then (receive receiver sender c));
                    G2 := (!combine-inequalities
                           [((S n1) >= n0)  # E2b
                            (n2 >= (S n1))  # E3-w1
                            (n3 >= n2)      # F1-w1
                           ]);
                    G3 := (!chain->
                           [G2 ==> ((itp T n0) -->>* (itp T n3)) [ITPC]]);
                    G4 := (!chain->
                           [(B1 & G3) ==>
                            (exists ?s4 ?ls4 .
                              config (itp T n3) = 
                                ?s4 ++ (actor sender ?ls4)) [AP]])}
               pick-witnesses s4 ls4 for G4
                let {G4-w1 := (config (itp T n3) =
                               s4 ++ (actor sender ls4));
                     3T := (!lemma Three-Together);
                     H0 := (!chain-> 
                            [true 
                             ==> ((actor' sender ls4) =/= 
                                  (message' sender LS0 receiver c))
                             [(exclusive-constructors 
                               "Actor-Cfg.Actor")]]);
                     H1 := (!chain->
                            [(sender =/= receiver)
                             ==> ((actor' sender ls4) =/=
                                  (actor' receiver ls3))
                                        [UI2]
                             ==> (G4-w1 & F1-w2 & 
                                       (actor' sender ls4) =/=
                                       (actor' receiver ls3) & H0)
                                        [augment]
                             ==> (exists ?s5 .
                                   (config (itp T n3)) =
                                   ?s5 ++ (actor sender ls4) ++
                                   (actor receiver ls3) ++ MM)
                                        [3T]])}
                pick-witness s5 for H1 H1-w
                 let {I1 := (!chain->
                             [H1-w ==> (config (itp T n3) =
                                        (s5 ++ (actor sender ls4)) ++
                                        (actor receiver ls3) ++ MM)
                                                [++A]])}
                 (!chain->
                  [(G2 & I1 & F1-w3 & F1-w4) ==> goal [existence]])
    } # match theorem 

(evolve Theory [[guaranteed-message-reception] proof])

} # Progress
