load "transition.ath"

module Monotonic-Transition {
open Transition-Path-Relation
open Preorder

define Theory := 
  (theory [Transition-Path-Relation.Theory Preorder.Theory] 
    [] 'Monotonic-Transition)

define actor-monotonicity :=
  (forall T T0 s0 id ls0 .
    (forall ?ls ?step . ?ls R (next ?ls ?step))
    ==> ((unique-ids config T0) &
         config T0 = s0 ++ (actor id ls0) &
         T0 -->>* T
         ==> exists s ls .
               config T = s ++ (actor id ls) & ls0 R ls))

define proof :=
 method (theorem adapt)
   let {given := lambda (P) (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        [LS0 R next ready-to unique-ids before after config new-ls]:= 
          (adapt [LS0 R next ready-to unique-ids before after 
		      config new-ls]);
        R*L := (!lemma ['-->> R*-lemma]);
        ++A := (given ['++ Associative]);
        ++C := (given ['++ Commutative]);
        theorem' := (adapt theorem);
        [T-sort _ s-sort id-sort ls-sort] := 
          (map sort-of (qvars-of theorem'))}
   by-induction theorem' {
     (I as Initial:T-sort) =>
       pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort
         let {next-higher := 
                (forall ?ls ?step . ?ls R (next ?ls ?step))}
         assume next-higher
          let {A0 := (unique-ids config T0);
               A1 := (config T0 = s0 ++ (actor id0 ls0));
               A2 := (T0 -->>* I)}
          assume A := (A0 & A1 & A2)
           let {goal := (exists ?s ?ls .
                          config I = ?s ++ (actor id0 ?ls) &
                          ls0 R ?ls);
                _ := (!chain-> [true ==> (ls0 R ls0) [Reflexive]]);
                B1 := (!chain-> 
                       [A2 ==> (T0 = I | T0 -->>+ I)
                           [R*L]])}
           (!cases B1
             assume B1a := (T0 = I)
               (!chain-> [A1 ==> (config I = 
                                     s0 ++ (actor id0 ls0)) [B1a]
                             ==> (config I = 
                                     s0 ++ (actor id0 ls0) &
                                     ls0 R ls0)   [augment]
                             ==> goal          [existence]])
             assume B1b := (T0 -->>+ I)
               (!from-complements goal B1b
                  (!chain-> [true ==> (~ B1b)
                                     [nothing-leads-to-Initial]])))
   | (T:T-sort then step) =>
     let {ind-hyp := (forall ?T0 ?s0 ?id0 ?ls0 .
                        (forall ?ls ?step . ?ls R (next ?ls ?step))
                        ==> 
                        (unique-ids config ?T0) &
                        config ?T0 = ?s0 ++ (actor ?id0 ?ls0) &
                        ?T0 -->>* T
                        ==> exists ?s ?ls .
                              config T = ?s ++ (actor ?id0 ?ls) &
                              ?ls0 R ?ls)}
     pick-any T0:T-sort s0:s-sort id0:id-sort ls0:ls-sort
       let {next-higher := (forall ?ls ?step . ?ls R (next ?ls ?step))}
       assume next-higher
       let {ind-hyp' := 
              pick-any T0:T-sort s0:s-sort
                (!chain->
                 [next-higher
                  ==> 
                  ((unique-ids config T0) &
                   config T0 = s0 ++ (actor id0 ls0) &
                   T0 -->>* T
                   ==> exists ?s ?ls .
                         config T = ?s ++ (actor id0 ?ls) &
                         ls0 R ?ls)   [ind-hyp]])}
       let {A0 := (unique-ids config T0);
            A1 := (config T0 = s0 ++ (actor id0 ls0));
            A2 := (T0 -->>* (T then step))}
       assume (A0 & A1 & A2)
         let {_ := (!chain-> [true ==> (ls0 R ls0) [Reflexive]]);
              B1 := (!chain-> 
                     [A2 ==> (T0 = (T then step) |
                                 T0 -->>+ (T then step)) [R*L]])}
         (!cases B1
           assume B1a := (T0 = (T then step))
             (!chain-> [A1 ==> (config (T then step) = 
                                   s0 ++ (actor id0 ls0)) [B1a]
                           ==> (config (T then step) = 
                                   s0 ++ (actor id0 ls0) &
                                   ls0 R ls0)             [augment]
                           ==> (exists ?s ?ls .
                                 config (T then step) = 
                                 ?s ++ (actor id0 ?ls) &
                                 ls0 R ?ls)          [existence]])
           assume B1b := (T0 -->>+ (T then step))
            let {goal := (exists ?s ?ls .
                           config (T then step) = 
                           ?s ++ (actor id0 ?ls) &
                           ls0 R ?ls);
                 LT := (!lemma leads-to);
                 C := (!chain-> 
                       [B1b
                        ==> (T0 -->>* T)           [LT left-and]
                        ==> (A0 & A1 & T0 -->>* T) [augment]
                        ==> (exists ?s1 ?ls1 . 
                              config T = ?s1 ++ (actor id0 ?ls1) &
                              ls0 R ?ls1)          [ind-hyp']])}
            pick-witnesses s1 ls1 for C C-w
             let {D := (!chain-> 
                        [B1b 
                         ==> (T0 -->>* T & 
                              Enabled (T then step)) [LT]
                         ==> (T0 -->>* T & Enabled T & 
                              exists ?s ?ls .
                                (before T step ?s ?ls))
                                                     [enabled-step]
                         ==> (Enabled T & 
                              exists ?s ?ls .
                                (before T step ?s ?ls)) [right-and]]);
                  C-w1 := (!left-and C-w);
                  C-w2 := (!right-and C-w);
                  UIP := (!lemma unique-ids-persistence);
                  D1 := (!chain->
                          [B1b
                           ==> (T0 -->>* T)          [LT left-and]
                           ==> (A0 & T0 -->>* T)     [augment]
                           ==> (unique-ids config T) [UIP]]);
                  D2 := (!chain->
			 [B1b
		          ==> (Enabled (T then step)) [LT right-and]]);
                  other-case :=
                    method (id Step other-lemma goal)
                      let {F1 := (!chain->
				  [D2 ==> (Enabled (T then Step))
				              [(step = Step)]]);
                           F2 := (!chain->
				  [(C-w1 & F1 & id =/= id0)
				   ==> (exists ?s2 .
                                         config (T then Step)
					 = ?s2 ++ (actor id0 ls1)) 
				              [other-lemma]])}
                      pick-witness s2 for F2 F2-w
                         (!chain->
			  [F2-w 
			   ==> (F2-w & ls0 R ls1) [augment]
			   ==> goal               [existence]])}
             pick-witnesses s ls for (!right-and D) D-w
               let {UI1 := (!lemma unique-ids1)}
               datatype-cases goal on step {
                 (Receive as (receive id:id-sort fr:id-sort c)) =>
                   let {receive-goal :=
                          (exists ?s ?ls .
                            config (T then Receive) = ?s ++ (actor id0 ?ls) &
                            ls0 R ?ls);
                        M := (One (message' fr LS0 id c));
                        E := (!chain->
                               [D-w ==> (before T Receive s ls)
                                              [(step = Receive)]]);
                        E' := (!chain->
                               [E ==> (config T = s ++ (actor id ls) ++ M)
                                                    [before.receiving left-and]
                                                = ((s ++ M) ++ (actor id ls))
                                                    [++A ++C]])}
                   (!two-cases
                    assume (id = id0)
                      let {_ := (!chain->
                                 [E' ==> (config T = (s ++ M) ++
                                                       (actor id0 ls))
                                                        [(id = id0)]
                                     ==> (D1 & 
                                          config T = (s ++ M) ++
                                                     (actor id0 ls) &
                                          config T = s1 ++ (actor id0 ls1) &
                                          id0 = id0)    [augment]
                                     ==> (ls = ls1)     [UI1]]);
                           E0 := (!chain->
                                  [true ==> (ls1 R (next ls1 Receive))
                                                            [next-higher]
                                        ==> (ls1 R (next ls1 Receive) &
                                             ls0 R ls1)     [augment]
                                        ==> (ls0 R (next ls1 Receive))
                                                            [Transitive]
                                        ==> (ls0 R (next ls Receive))
                                                            [(ls = ls1)]]);
                           E1 :=
                            (!chain-> 
			     [E ==> (after T Receive s ls)
				          [transition-step]
				==> (config (T then Receive)
				     = s ++ (actor id (next ls Receive)))
				          [after.receiving]
				     = (s ++ (actor id0 (next ls Receive)))
				          [(id = id0)]]);
                          E2 := (!both E1 E0)}
                       (!chain-> [E2 ==> receive-goal [existence]])
                    assume (id =/= id0)
                      let {OR1 := (!lemma other-receive-1)}
                      (!other-case id Receive OR1 receive-goal))
               | (Send as (send id:id-sort to:id-sort c)) => 
                 conclude send-goal := (exists ?s ?ls .
                                         config (T then Send) =
                                          ?s ++ (actor id0 ?ls) &
                                         ls0 R ?ls)
                   let {M := (One (message' id LS0 to c));
                        E := (!chain->
                                [D-w ==>
                                     (before T Send s ls)
                                          [(step = Send)]]);
                        E' := (!chain->
                                [E ==> (config T = s ++ (actor id ls))
                                          [before.sending left-and]])}
                   (!two-cases
                    assume (id = id0)
                      let {_ := (!chain->
                                  [E' ==> (config T = s ++ (actor id0 ls))
                                                         [(id = id0)]
                                      ==> (D1 &
                                           config T = s ++ (actor id0 ls) &
                                           config T = s1 ++ (actor id0 ls1) &
                                           id0 = id0)    [augment]
                                      ==> (ls = ls1)     [UI1]]);
                           E0 := (!chain->
                                   [true ==> (ls1 R (next ls1 Send))
                                                         [next-higher]
                                         ==> (ls0 R ls1 & 
                                              ls1 R (next ls1 Send))
                                                         [augment]
                                         ==> (ls0 R (next ls1 Send))
                                                         [Transitive]
                                         ==> (ls0 R (next ls Send))
                                                         [(ls = ls1)]])}
                      (!chain->
                       [E ==> (after T Send s ls)    [transition-step]
			  ==> (config (T then Send)
			       = s ++ (actor id (next ls Send)) ++ M)
			                              [after.sending]
			       = (s ++ (actor id0 (next ls Send)) ++ M)
			                              [(id = id0)]
			       = ((s ++ M) ++ (actor id0 (next ls Send)))
			                              [++A ++C]
			  ==> (config (T then Send) =
			       (s ++ M) ++ (actor id0 (next ls Send)) & E0)
			                              [augment]
			  ==> send-goal               [existence]])
		    assume (id =/= id0)
                      let {OS1 := (!lemma other-send-1)}
                      (!other-case id Send OS1 send-goal))
               | (Create as (create id:id-sort id':id-sort)) => 
                   let {create-goal :=
                          (exists ?s ?ls . config (T then Create) =
                                            ?s ++ (actor id0 ?ls) &
                                           ls0 R ?ls);
                        E := (!chain->
                               [D-w ==> (before T Create s ls)
                                           [(step = Create)]]);
                        E' := (!chain->
                                [E ==> (config T = s ++ (actor id ls))
                                           [before.creating left-and]])}
                   (!two-cases
                    assume (id = id0)
                      let {_ := (!reflex id0);
                           _ := (!chain->
                                  [E' ==> (config T = s ++ (actor id0 ls))
                                                       [(id = id0)]
                                      ==> (D1 &
                                           config T = s ++ (actor id0 ls) &
                                           config T = s1 ++ (actor id0 ls1) &
                                          (id0 = id0)) [augment]
                                      ==> (ls = ls1)   [UI1]]);
                           E0 := (!chain->
                                   [true ==> (ls1 R (next ls1 Create))
                                                       [next-higher]
                                         ==> (ls0 R ls1 & 
                                              ls1 R (next ls1 Create))
                                                       [augment]
                                         ==> (ls0 R (next ls1 Create))
                                                       [Transitive]
                                         ==> (ls0 R (next ls Create))
                                                       [(ls = ls1)]])}
                      (!chain->
                       [E ==> (after T Create s ls)        [transition-step]
                          ==> (config (T then Create)
                               = s ++ (actor id (next ls Create)) ++
                                 (actor id' (new-ls ls)))  [after.creating]
                               = (s ++ (actor id0 (next ls Create)) ++
				  (actor id' (new-ls ls))) [(id = id0)]
                               = ((s ++ (actor id' (new-ls ls))) ++
				  (actor id0 (next ls Create)))   [++A ++C]
                          ==> (config (T then Create)
                               = (s ++ (actor id' (new-ls ls))) ++
				  (actor id0 (next ls Create)) & E0)
                                                           [augment]
                          ==> create-goal                  [existence]])
                    assume (id =/= id0)
                      let {OC1 := (!lemma other-create-1)}
                      (!other-case id Create OC1 create-goal))
    }) # close datatype-cases, close cases B1
   } # close by-induction

(evolve Theory [[actor-monotonicity] proof])

} # Monotonic-Transition
