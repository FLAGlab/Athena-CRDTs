load "config.ath"

open Cfg

assert (theory-axioms Theory)

(!property-test Isolate1 no-renaming Theory)
(!property-test Isolate2 no-renaming Theory)

#(set-debug-mode "rewriting")

(!property-test Together no-renaming Theory)
(!property-test Three-Together no-renaming Theory)
(!property-test Four-Together no-renaming Theory)
(!property-test Locate no-renaming Theory)