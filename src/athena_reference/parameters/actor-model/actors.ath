load "config.ath"
load "nat-less.ath"
#----------------------------------------------------------------------------

module Actor-Cfg {
 open Cfg
 open N

 datatype (Actor Id LS) :=  
  (actor' Id LS) | (message' Id LS Id Ide)

 assert (structure-axioms "Actor-Cfg.Actor")

 declare LS0: (LS) [] -> LS

 define actor := lambda (id ls) (One (actor' id ls))
 define message := lambda (fr to c) (One (message' fr LS0 to c))

 define [id id' id1 id2 ls ls' ls1 ls2 fr to c s'] := 
        [?id:'S ?id':'S ?id1:'S ?id2:'S ?ls:'T ?ls':'T ?ls1:'T ?ls2:'T 
         ?fr:'S ?to:'S ?c:Ide ?s':(Cfg (Actor 'S 'T))]

 declare count: (Id, LS) [Id (Cfg (Actor Id LS))] -> N

 module count {
  define (axioms as [empty more same ignore-messages]) :=
    (fun [(count id Null) = zero
	  (count id (s ++ (actor id' ls'))) =
	      [(S (count id s))  when (id = id') 
	       (count id s)      when (id =/= id')]
          (count id (s ++ (message fr to c))) = (count id s)])
 } # close module count

 declare unique-ids: (Id, LS) [(Cfg (Actor Id LS))] -> Boolean

 module unique-ids {
 define definition :=
  (forall s . (unique-ids s) <==> forall id . (count id s) <= one)
 }

 define Theory := 
   (theory [Cfg.Theory] (join [unique-ids.definition] count.axioms)
   'Actor-Cfg)

 extend-module count {
  define ignore-local-state :=
   (forall s id id1 ls1 ls2 .
     (count id (s ++ (actor id1 ls1))) =
     (count id (s ++ (actor id1 ls2))))

  define proof :=
   method (theorem adapt)
    let {given := lambda (P)  (get-property P adapt Theory);
         chain := method (L) (!chain-help given L 'none)}
    match theorem {
     (val-of ignore-local-state) =>
     pick-any s id id1 ls1 ls2
       (!two-cases
	assume (id = id1)
          (!chain
	   [(count id (s ++ (actor id1 ls1)))
	    = (S (count id s))                     [more]
	    = (count id (s ++ (actor id1 ls2)))    [more]])
	assume (id =/= id1)
          (!chain
	   [(count id (s ++ (actor id1 ls1)))
	    = (count id s)                         [same]
	    = (count id (s ++ (actor id1 ls2)))    [same]]))
   }

  (evolve Theory [[ignore-local-state] proof])
 } # close module count

 define uids-empty := (unique-ids Null)

 define uids-nonempty := 
  (forall s id ls .
    (unique-ids s ++ (actor id ls)) ==>
    ~ exists s' ls' . s = s' ++ (actor id ls'))

 define uids-ignore-messages :=
  (forall s fr to c . 
    (unique-ids s ++ (message fr to c)) <==> (unique-ids s))

 define uids-ignore-local-state :=
  (forall s id ls1 ls2 .
    (unique-ids s ++ (actor id ls1)) <==>
    (unique-ids s ++ (actor id ls2)))

 define unique-ids0 :=
  (forall s id ls . 
    (unique-ids s ++ (actor id ls)) <==> 
    (unique-ids s) & (count id s) = zero)

 define unique-ids1 :=  
  (forall s s1 s2 id1 ls1 id2 ls2 . 
    (unique-ids s) &
    s = s1 ++ (actor id1 ls1) &
    s = s2 ++ (actor id2 ls2) &
    id1 = id2
    ==> s1 = s2 & ls1 = ls2)

 define unique-ids2 :=
  (forall id1 ls1 id2 ls2 . 
    id1 =/= id2 ==> (actor' id1 ls1) =/= (actor' id2 ls2))

 define unique-ids3 :=
  (forall s id1 ls1 id2 ls2 . 
    (unique-ids s ++ (actor id1 ls1) ++ (actor id2 ls2))
    ==> id1 =/= id2)

 define unique-ids4 :=
  (forall s id1 ls1 id2 ls2 . 
    (unique-ids s ++ (actor id1 ls1)) &
    (unique-ids s ++ (actor id2 ls2)) &
    id1 =/= id2
    ==> (unique-ids s ++ (actor id1 ls1) ++ (actor id2 ls2)))

 define proofs :=
  method (theorem adapt)
   let {given := lambda (P)  (get-property P adapt Theory);
        lemma := method (P) (!property P adapt Theory);  
        chain := method (L) (!chain-help given L 'none);
        chain-> := method (L) (!chain-help given L 'last);
        [LS0 unique-ids Null] := (adapt [LS0 unique-ids Null]);
        ++A := (given ['++ Associative]);
        ++C := (given ['++ Commutative])}
   match theorem {
     (val-of uids-empty) =>
     let {C := pick-any id
                (!chain->
		 [true ==> ((count id Null:(Cfg (Actor 'Id 'LS))) = zero)  
		       [count.empty]
		       ==> ((count id Null:(Cfg (Actor 'Id 'LS))) <= one)
		       [Less=.zero<=one]])}
      (!chain->
       [C ==> (unique-ids Null:(Cfg (Actor 'Id 'LS))) [unique-ids.definition]])
   | (val-of uids-nonempty) =>
     let {[s-sort id-sort ls-sort] := 
	     (map sort-of (qvars-of (adapt theorem)))}
     pick-any s:s-sort id:id-sort ls:ls-sort
       assume A := (unique-ids s ++ (actor id ls))
         let {B := (exists ?s1 ?ls1 . s = ?s1 ++ (actor id ?ls1))}
         (!by-contradiction (~ B)
          assume B
            let {_ := (!reflex id)}
            pick-witnesses s1 ls1 for B B-w
              let {C := (!chain
			 [(count id s) 
			  = (count id (s1 ++ (actor id ls1))) [B-w]
			  = (S (count id s1))          [count.more]])}
              (!absurd
	       (!chain->
 		[A ==> (forall ?id . (count ?id (s ++ (actor id ls))) <= one)
 		   [unique-ids.definition]
		   ==> ((count id (s ++ (actor id ls))) <= one) [(specify [id])]
		   ==> ((S (count id s)) <= (S zero))  [count.more (one = S zero)]
		   ==> ((count id s) <= zero)          [Less=.injective]
		   ==> (S (count id s1) <= zero)       [C]])
	       (!chain->
		[true ==> (~ (S (count id s1) <= zero)) [Less=.not-S-zero]])))
    | (val-of uids-ignore-messages) =>
      let {[s-sort id-sort _ _] := (map sort-of (qvars-of (adapt theorem)))}
      pick-any s:s-sort fr:id-sort to:id-sort c
        (!chain
	 [(unique-ids s ++ (One (message' fr LS0 to c)))
	  <==> (forall ?id . 
		 (count ?id (s ++ (One (message' fr LS0 to c)))) <= one)
	                       [unique-ids.definition]
	  <==> (forall ?id . (count ?id s) <= one)
	                       [count.ignore-messages]
	  <==> (unique-ids s)  [unique-ids.definition]])
  | (val-of uids-ignore-local-state) =>
      let {[s-sort id-sort ls-sort _] := 
 	     (map sort-of (qvars-of (adapt theorem)));
           UI0 := (!lemma unique-ids0)}
      pick-any s:s-sort id:id-sort ls1:ls-sort ls2:ls-sort
       (!chain
	[(unique-ids s ++ (actor id ls1))
	 <==> ((unique-ids s) & (count id s) = zero)  [UI0]
	 <==> (unique-ids s ++ (actor id ls2))        [UI0]])
  | (val-of unique-ids0) => 
    let {[s-sort id-sort ls-sort] := 
            (map sort-of (qvars-of (adapt theorem)))}
    pick-any s:s-sort id:id-sort ls:ls-sort
      (!equiv
       assume A := (unique-ids s ++ (actor id ls))
         let {B1 := (!chain->
		     [A ==> (forall ?id . 
			      (count ?id (s ++ (actor id ls))) <= one)
			             [unique-ids.definition]]);
              B1a := (!chain->
		      [B1 ==> ((count id (s ++ (actor id ls))) <= one) 
			             [(specify [id])]]);
              B2a := (!chain
		     [(count id (s ++ (actor id ls)))
		      = (S (count id s))                  [count.more]]);
              B2 := (!chain->
		     [B1a ==> (S (count id s) <= S zero)  [B2a (one = S zero)]
			  ==> ((count id s) <= zero)      [Less=.injective]
			  ==> ((count id s) = zero)       [Less=.zero2]]);
              B3 := conclude (forall ?id1 . (count ?id1 s) <= one)
                      pick-any id1:id-sort
		        (!two-cases
			 assume (id1 = id)
			   (!chain->
			    [true 
			     ==> ((count id1 (s ++ (actor id ls))) <= one) [B1]
			     ==> ((S (count id1 s)) <= one)      [count.more]
			     ==> ((S (count id1 s)) <= (S zero)) [(one = S zero)]
			     ==> ((count id1 s) <= zero)         [Less=.injective]
			     ==> ((count id1 s) = zero)          [Less=.zero2]
			     ==> ((count id1 s) <= one)          [Less=.zero<=one]])
			 assume (id1 =/= id)
			   (!chain->
			    [true 
			     ==> ((count id1 (s ++ (actor id ls))) <= one) [B1]
			     ==> ((count id1 s) <= one)          [count.same]]));
              B4 := (!chain->
		     [B3 ==> (unique-ids s)  [unique-ids.definition]])}
          (!both B4 B2)
        assume ((unique-ids s) & (count id s) = zero)
          let {C1 := (!chain->
		      [(unique-ids s)
		       ==> (forall ?id1 . (count ?id1 s) <= one)
		       [unique-ids.definition]]);
               C2 := pick-any id1:id-sort
                       conclude ((count id1 (s ++ (actor id ls))) <= one)
                         (!two-cases
			  assume (id1 = id)
			    (!chain-> 
			     [(count id1 (s ++ (actor id ls)))
			      = (S (count id1 s))   [count.more]
			      = (S (count id s))    [(id1 = id)]
			      = (S zero)            [((count id s) = zero)]
			      = one                 [(one = S zero)]
			      ==> ((count id1 (s ++ (actor id ls))) <= one)
			      [Less=.Implied-by-equal]])
			  assume (id1 =/= id)
			    (!chain-> 
			     [true ==> ((count id1 s) <= one)  [C1]
				   ==> ((count id1 (s ++ (actor id ls))) <= one)
				   [count.same]]))}
          (!chain-> [C2 ==> (unique-ids s ++ (actor id ls)) 
			   [unique-ids.definition]]))
   | (val-of unique-ids1) =>
     let {[s-sort _ _ id-sort ls-sort _ _] := 
             (map sort-of (qvars-of (adapt theorem)))}
     pick-any s:s-sort s1:s-sort s2:s-sort id1:id-sort 
              ls1:ls-sort id2:id-sort ls2:ls-sort
       let {A1 := (unique-ids s);
	    A2 := (s = s1 ++ (actor id1 ls1));
	    A3 := (s = s2 ++ (actor id2 ls2));
	    A4 := (id1 = id2)}
       assume (A1 & A2 & A3 & A4)
        let {F1 := 
         (!by-contradiction (ls1 = ls2)
          assume (ls1 =/= ls2)
            let {CI := (!constructor-injectivity actor');
	         B1 := (!by-contradiction 
			  ((actor' id1 ls1) =/= 
                           (actor' id2 ls2))
			assume C1 := ((actor' id1 ls1) = 
				      (actor' id2 ls2))
			  (!absurd 
			   (!chain->
			    [C1 ==> (id1 = id2 & ls1 = ls2) 
                                               [CI]
				==> (ls1 = ls2)[right-and]])
			   (ls1 =/= ls2)));
                 TR := (!lemma Together);
		 B2 := (!chain->
			[(A2 & A3 & B1) 
			 ==> (exists ?s3 . 
			       s = ?s3 ++ (actor id1 ls1) ++ 
			           (actor id2 ls2)) [TR]])}
            pick-witness s3 for B2 B2-w
             let {_ := (!lemma uids-nonempty);
		  s4 := (s3 ++ (actor id1 ls1));
	          C1 := (!chain->
			 [A1 ==> 
			   (unique-ids s3 ++ (actor id1 ls1)
				       ++ (actor id1 ls2))
			                            [B2-w A4]
			     ==> (unique-ids 
                                  s4 ++ (actor id1 ls2))[++A]
			     ==> (~ exists ?s' ?ls' .
				     s4 = ?s' ++ 
                                          (actor id1 ?ls'))
				           [uids-nonempty]]);
                  C2 := (!chain->
			 [(s4 = s4)
			  ==> (exists ?s' ?ls' .
				s4 = ?s' ++ (actor id1 ?ls'))
			              [existence]])}
             (!absurd C2 C1))}
        (!chain->
	 [(s1 ++ (actor id1 ls1))
	  = s                        [A2]
          = (s2 ++ (actor id2 ls2))  [A3]
	  = (s2 ++ (actor id1 ls1))  [A4 F1]
	  ==> (s1 = s2)              [in.cancellation]
	  ==> (s1 = s2 & ls1 = ls2)  [augment]])
   | (val-of unique-ids2) =>
     let {[id-sort ls-sort _ _] := 
       (map sort-of (qvars-of (adapt theorem)))}
     pick-any id1:id-sort ls1:ls-sort id2:id-sort ls2:ls-sort 
       assume A := (id1 =/= id2)
         (!by-contradiction 
	     ((actor' id1 ls1) =/= (actor' id2 ls2))
          assume B := ((actor' id1 ls1) = 
		       (actor' id2 ls2))
	    let {CI := (!constructor-injectivity actor')}
	      (!absurd 
	       (!chain-> 
		[B ==> (id1 = id2 & ls1 = ls2)  [CI]
		   ==> (id1 = id2)        [left-and]])
	       A))
   | (val-of unique-ids3) =>
     let {[s-sort id-sort ls-sort _ _] := 
            (map sort-of (qvars-of (adapt theorem)))}
     pick-any s:s-sort id1:id-sort ls1:ls-sort 
              id2:id-sort ls2:ls-sort
       assume A := (unique-ids 
		     s ++ (actor id1 ls1) ++ (actor id2 ls2))
       let {_ := (!lemma uids-nonempty);
            s1 := (s ++ (actor id1 ls1))}
       (!by-contradiction (id1 =/= id2)
        assume (id1 = id2)
          (!absurd
	   (!chain-> [(s1 = s ++ (actor id1 ls1))
		      ==> (s1 = s ++ (actor id2 ls1))  
                                                [(id1 = id2)]
		      ==> (exists ?s' ?ls' . 
                             s1 = ?s' ++ (actor id2 ?ls'))
				                [existence]])
	   (!chain->
	    [A ==> (unique-ids s1 ++ (actor id2 ls2)) [++A]
	       ==> (~ exists ?s' ?ls' . 
                       s1 = ?s' ++ (actor id2 ?ls'))
		                                [uids-nonempty]])))
   | (val-of unique-ids4) =>
     let {[s-sort id-sort ls-sort _ _] := 
             (map sort-of (qvars-of (adapt theorem)));
          _ := (!lemma unique-ids0)}
     pick-any s:s-sort id1:id-sort ls1:ls-sort id2:id-sort ls2:ls-sort
       let {A1 := (unique-ids s ++ (actor id1 ls1));
            A2 := (unique-ids s ++ (actor id2 ls2));
            A3 := (id1 =/= id2)}
       assume (A1 & A2 & A3)
         let {goal := (unique-ids s ++ (actor id1 ls1) ++ (actor id2 ls2));
              (and B1 B2) := (!chain->
			      [A2 ==> ((unique-ids s) & (count id2 s) = zero)
				  [unique-ids0]]);
              B3 := conclude ((count id2 (s ++ (actor id1 ls1))) = zero)
                      let {_ := (!sym A3)}
	              (!chain
		       [(count id2 (s ++ (actor id1 ls1)))
			= (count id2 s)   [A3 count.same]
			= zero            [B2]])}
         (!chain-> [(A1 & B3) 
		    ==> (unique-ids (s ++ (actor id1 ls1)) ++ (actor id2 ls2))
		                     [unique-ids0]
		    ==> goal      [++A]])
  } # close match theorem

 define theorems := [uids-empty uids-nonempty uids-ignore-messages 
		     uids-ignore-local-state unique-ids0 unique-ids1 
		     unique-ids2 unique-ids3 unique-ids4]

 (evolve Theory [theorems proofs])
} # close module Actor-Cfg

