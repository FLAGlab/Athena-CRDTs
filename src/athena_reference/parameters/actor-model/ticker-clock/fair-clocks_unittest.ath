
load "fair-clocks.ath"

#======================================================================

module Test {
open Fair-Clock-System

assert (theory-axioms FC-Theory)

define IOE-axiom := ((renaming CA) IOE)

retract IOE-axiom

load "ioe-theorems.ath"

#======================================================================
# We now have all we need to prove the Clock progress theorems:

# It is not necessary to prove the following lemmas in advance,
# but it speeds things up a bit.
define lemma := 
  method (name) (!property name no-renaming FC-Theory)
(!lemma ['Clone1 ['Clock send-happens]])
(!lemma ['Clock trans-send])
(!lemma ['Clock unique-ids-persistence])
(!lemma ['Clone2 ['Clock send-happens]])
(!lemma ['Clone1 ['Clock receive-happens]])
(!lemma ['Clock trans-receive])
(!lemma ['Clock ['-->> R*-lemma]])
(!lemma ['Clock unique-ids1])
(!lemma ['Clock actor-persistence])
(!lemma ['Clock leads-to])
(!lemma ['Clock Transition-Path-Relation.unique-ids-persistence])
(!lemma ['Clock unique-ids2])
(!lemma ['Clock other-receive-1])
(!lemma ['Clock other-receive-2])
(!lemma ['Clock other-send-1])
(!lemma ['Clock other-send-2])
(!lemma ['Clock other-create-1])
(!lemma ['Clock other-create-2])
(!lemma ['Clock itp-connected])
(!lemma Ticker-continue-message-persists)
(!lemma Ticker-eventually-ready-to-send-tick)
(!lemma Monotonicity.clock-monotonicity)
(!lemma ['Clock unique-ids2])
(!lemma ['Clock Together])
(!lemma ['Clone2 ['Clock guaranteed-message-reception]])
(!lemma Monotonicity.clock-monotonicity-1)
(!lemma ['Clock trans-receive])
(!lemma Monotonicity.ticker-monotonicity-1)

(!property-test Clock-progress no-renaming FC-Theory)

(!property-test Clock-Time-progress no-renaming FC-Theory)

} # Test