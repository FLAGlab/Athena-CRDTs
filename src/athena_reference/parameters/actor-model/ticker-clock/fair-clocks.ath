load "clock-actors.ath"
#=========================================================================

module Fair-Clock-System {

define FC-Theory := 
  (theory [Monotonicity.CM-Theory 
           Clock-Actors.Progress.Theory1
           Clock-Actors.Progress.Theory2
           Clock-Actors.Progress.Theory]
    [] 'Fair-Clock-System)

open Clock-Actors

#=========================================================================
define [n0 t0 u] := [?n0:N ?t0:N ?u:N]

define Clock-eventually-ready-to-receive :=
  (forall T n0 s0 t0 c .
    config (citp T n0) = 
      s0 ++ (actor Clock (clock local t0)) ++ (message Ticker Clock c) &
    (unique-ids config (citp T n0))
    ==>
    (exists n s t . 
      n >= n0 &
      config (citp T n) = 
        s ++ (actor Clock (clock local t)) ++ (message Ticker Clock c) &
      (clock local t) ready-to (receive Clock Ticker c)))

define Clock-eventually-ready-to-receive-proof :=
 method (theorem adapt)
  let {given := lambda (P) (get-property P adapt FC-Theory);
       lemma := method (P) (!property P adapt FC-Theory);          
       chain := method (L) (!chain-help given L 'none);
       chain-last := method (L) (!chain-help given L 'last);
       [LS0 next unique-ids config] := 
         (adapt [LS0 next unique-ids config])}
  conclude (adapt theorem)
  pick-any T n0 s0 t c 
    let {A1 := (config (citp T n0) = 
                 s0 ++ (actor Clock (clock local t)) ++ 
                 (message Ticker Clock c));
         A2 := (unique-ids config (citp T n0))}
    assume A := (A1 & A2)
      let {B1 := (!chain-last [true ==> (n0 >= n0) [Less=.reflexive]]);
           B2 := (!chain-last
                  [(clock local t = clock local t)
		   ==> (exists ?t' . clock local t = clock local ?t')
		        [existence]
		   ==> (clock t ready-to (receive Clock Ticker c))
                        [Clock.ready-to-definition]])}
      (!chain-last
      [B2 ==> (B1 & A1 & B2)               [augment]
          ==> (exists ?n ?s ?t .
                ?n >= n0 &
                config (citp T ?n) = 
                  ?s ++ (actor Clock (clock local ?t)) ++ 
                  (message Ticker Clock c) &
                clock local ?t ready-to (receive Clock Ticker c)) 
                                           [existence]])

(evolve FC-Theory [[Clock-eventually-ready-to-receive]
                Clock-eventually-ready-to-receive-proof])

#=========================================================================
define CM := (One (message' Ticker tcls0 Ticker 'continue))

define Ticker-eventually-ready-to-send-tick :=
  (forall ls0 T n0 s0 .
    config (citp T n0) = s0 ++ (actor Ticker (ticker ls0)) &
    (unique-ids config (citp T n0)) &
    (ls0 =/= local1 ==> exists s1 . s0 = s1 ++ CM)
    ==>
    exists n s ls .
      n >= n0 &
      config (citp T n) = s ++ (actor Ticker ls) & 
      ls ready-to (send Ticker Clock 'tick))

define proof :=
  method (theorem adapt)
   let {given := lambda (P) (get-property P adapt FC-Theory);
        lemma := method (P) (!property P adapt FC-Theory);          
        chain := method (L) (!chain-help given L 'none);
        chain-last := method (L) (!chain-help given L 'last);
        [LS0 next ready-to new-ls unique-ids config before after] := 
          (adapt [LS0 next ready-to new-ls unique-ids config 
                      before after]);
        ++A := (given ['Clock ['++ Associative]]);
        ++C := (given ['Clock ['++ Commutative]]);
        [_ T-sort _ s-sort] := (map sort-of (qvars-of (adapt theorem)))}
   letrec {proof1 :=
     method (T:T-sort n0 s0:s-sort A1 A2 A3)
       let {goal := (exists ?n ?s ?ls .
                      ?n >= n0 &
                      config (citp T ?n) = ?s ++ (actor Ticker ?ls) &
                      ?ls ready-to (send Ticker Clock 'tick));
            B1 := (!chain-last
                   [(ticker local1 = ticker local1)
                     ==> (ticker local1 ready-to (send Ticker Ticker 'continue))
                    [Ticker.ready-to-definition]]);
            SH := (!lemma ['Clone1 ['Clock send-happens]]);
            B2 := (!chain-last
                   [(A1 & B1) 
                    ==> (exists ?k ?s' ?ls' .
                          ?k >= n0 &
                          config (citp T ?k) = ?s' ++ (actor Ticker ?ls') &
                          ?ls' ready-to (send Ticker Ticker 'continue) &
                          (citp T (S ?k)) = 
                            (citp T ?k) then (send Ticker Ticker 'continue))
                   [SH]])}
       pick-witnesses k s' ls' for B2 B2-w
         let {B2-w1 := (k >= n0);
              B2-w2 := (config (citp T k) = s' ++ (actor Ticker ls'));
              B2-w3 := (ls' ready-to (send Ticker Ticker 'continue));
              B2-w4 := ((citp T (S k)) = 
                          (citp T k) then (send Ticker Ticker 'continue));
              C1 := (!chain-last
                     [B2-w3 ==> (ls' = ticker local1)
                            [Ticker.ready-to-definition]]);
              TS := (!lemma ['Clock trans-send]);
              A1' := (!chain-last
                      [(B2-w2 & B2-w3)
                       ==> (config ((citp T k) then (send Ticker Ticker 'continue)) =
                             s' ++ (actor Ticker (next ls' (send Ticker Ticker 'continue)))
                             ++ CM)              [TS]
                      ==> (config (citp T (S k)) =
                           s' ++ (actor Ticker 
                                        (next (ticker local1) (send Ticker Ticker 'continue)))
                           ++ CM)              [B2-w4 C1]
                      ==> (config (citp T (S k)) =
                            s' ++ (actor Ticker (ticker local2)) ++ CM)
                                              [Ticker.next-definition]
                      ==> (config (citp T (S k)) =
                           (s' ++ CM) ++ (actor Ticker (ticker local2)))
                                              [++A ++C]]);
              C3 := (!chain-last 
                     [true ==> ((S k) >= k)           [N.Less=.S3]
                           ==> ((S k) >= k & k >= n0) [augment]
                           ==> ((S k) >= n0)          [N.Less=.transitive]]);
              UIP := (!lemma ['Clock unique-ids-persistence]);
              A2' := (!chain-last
                      [(A2 & C3) 
                       ==> (unique-ids config (citp T (S k))) [UIP]]);
              s0' := (s' ++ CM);
              A3' := assume (local2 =/= local1)
                            (!chain-last
                        [(s0' = s' ++ CM)
                         ==> (exists ?s1 . s0' = ?s1 ++ CM)
                                                      [existence]]);
              C5 := conclude 
                        (exists ?n ?s ?ls .
                          ?n >= (S k) &
                          config (citp T ?n) = ?s ++ (actor Ticker ?ls) &
                          ?ls ready-to (send Ticker Clock 'tick))
                      (!proof2 T (S k) s0' A1' A2' A3')}
           pick-witnesses n s ls for C5 C5-w
             let {C5-w1 := (n >= (S k));
                  C5-w2 := (config (citp T n) = s ++ (actor Ticker ls));
                  C5-w3 := (ls ready-to (send Ticker Clock 'tick));
                  D1 := (!chain-last [(C3 & C5-w1) ==> (n >= n0) 
                                         [N.Less=.transitive]])}
             (!chain-last
              [(D1 & C5-w2 & C5-w3) ==> goal  [existence]]);
     proof2 :=
       method (T:T-sort n0 s0:s-sort A1 A2 A3)
        let {goal := (exists ?n ?s ?ls .
                       ?n >= n0 &
                       config (citp T ?n) = ?s ++ (actor Ticker ?ls) &
                       ?ls ready-to (send Ticker Clock 'tick));
             B1 := (!chain-last
                    [(ticker local2 = ticker local2)
                     ==> (ticker local2 ready-to (send Ticker Clock 'tick))
                               [Ticker.ready-to-definition]]);
             SH := (!lemma ['Clone2 ['Clock send-happens]]);
             B2 := (!chain-last
                    [(A2 & A1 & B1) 
                     ==> (exists ?k ?s' ?ls' .
                           ?k >= n0 &
                           config (citp T ?k) = ?s' ++ (actor Ticker ?ls') &
                           ?ls' ready-to (send Ticker Clock 'tick) &
                           (citp T (S ?k)) = 
                             (citp T ?k) then (send Ticker Clock 'tick))
                     [SH]])}
        pick-witnesses k s' ls' for B2 B2-w
          let {B2-w1 := (k >= n0);
               B2-w2 := (config (citp T k) = s' ++ (actor Ticker ls'));
               B2-w3 := (ls' ready-to (send Ticker Clock 'tick))}
          (!chain-last
           [(B2-w1 & B2-w2 & B2-w3) ==> goal [existence]]);
     proof3 :=
       method (T:T-sort n0 s0:s-sort A1 A2 A3)
        let {goal := (exists ?n ?s ?ls .
                       ?n >= n0 &
                       config (citp T ?n) = ?s ++ (actor Ticker ?ls) &
                       ?ls ready-to (send Ticker Clock 'tick));
             B1 := (!chain-last
                    [(ticker local3 = ticker local3)
                     ==> (ticker local3 ready-to 
                           (receive Ticker Ticker 'continue))
                                    [Ticker.ready-to-definition]]);
             B2 := (!chain-last
                    [(local3 =/= local1)
                     ==> (exists ?s1 . s0 = ?s1 ++ CM)  [A3]])}
        pick-witness s1 for B2 B2-w
          let {C1 := (!chain-last
                      [A1 ==> (config (citp T n0) = 
                               (s1 ++ CM) ++ (actor Ticker (ticker local3)))
                                    [B2-w]
                          ==> (config (citp T n0) = 
                               s1 ++ (actor Ticker (ticker local3)) ++ CM)
                                    [++A ++C]]);
               RH := (!lemma ['Clone1 ['Clock receive-happens]]);
               C2 := (!chain-last
                      [(A2 & C1 & B1)
                       ==> (exists ?k ?s' ?ls' .
                             ?k >= n0 &
                             config (citp T ?k) = 
                               ?s' ++ (actor Ticker ?ls') ++ CM &
                             ?ls' ready-to (receive Ticker Ticker 'continue) &
                             (citp T (S ?k)) = 
                               (citp T ?k) then (receive Ticker Ticker 'continue))
                     [RH]])}
          pick-witnesses k s' ls' for C2 C2-w
            let {C2-w1 := (k >= n0);
                 C2-w2 := (config (citp T k) = s' ++ (actor Ticker ls') ++ CM);
                 C2-w3 := (ls' ready-to (receive Ticker Ticker 'continue));
                 C2-w4 := ((citp T (S k)) = 
                             (citp T k) then (receive Ticker Ticker 'continue));
                 D1 := (!chain-last
                        [C2-w3 ==> (ls' = ticker local3)
                               [Ticker.ready-to-definition]]);
                 TR := (!lemma ['Clock trans-receive]);
                 A1' := (!chain-last
                         [(C2-w2 & C2-w3)
                          ==> (config ((citp T k) then 
                                       (receive Ticker Ticker 'continue)) =
                               s' ++ (actor Ticker (next ls' (receive Ticker Ticker 'continue))))
                                         [TR]
                          ==> ((config (citp T (S k))) =
                               s' ++ (actor Ticker (next (ticker local3) 
                                                         (receive Ticker Ticker 'continue))))
                                         [D1 C2-w4]
                          ==> (config (citp T (S k)) =
                               s' ++ (actor Ticker ticker local1))
                                         [Ticker.next-definition]]);
                 D2 := (!chain-last 
                        [true ==> ((S k) >= k)           [N.Less=.S3]
                              ==> ((S k) >= k & k >= n0) [augment]
                              ==> ((S k) >= n0)          [N.Less=.transitive]]);
                 UIP := (!lemma ['Clock unique-ids-persistence]);
                 A2' := (!chain-last
                         [(A2 & D2) 
                          ==> (unique-ids config (citp T (S k))) [UIP]]);
                 A3' := assume (local1 =/= local1)
                          (!from-complements
                           (exists ?s . s' = ?s ++ CM)
                           (!reflex local1)
                           (local1 =/= local1));
                 D3 := conclude
                           (exists ?n ?s ?ls .
                             ?n >= (S k) &
                             config (citp T ?n) = ?s ++ (actor Ticker ?ls) &
                             ?ls ready-to (send Ticker Clock 'tick))
                         (!proof1 T (S k) s' A1' A2' A3')}
            pick-witnesses n s ls for D3 D3-w
              let {D3-w1 := (n >= (S k));
                   D3-w2 := (config (citp T n) = s ++ (actor Ticker ls));
                   D3-w3 := (ls ready-to (send Ticker Clock 'tick));
                   E1 := (!chain-last [(D2 & D3-w1) ==> (n >= n0) 
                                       [N.Less=.transitive]])}
              (!chain-last
               [(E1 & D3-w2 & D3-w3) ==> goal  [existence]]);
     setup :=
       method (proof-case state)
         pick-any T:T-sort n0 s0:s-sort
           let {A1 := (config (citp T n0) = s0 ++ (actor Ticker (ticker state)));
                A2 := (unique-ids config (citp T n0));
                A3 := (state =/= local1 ==> exists ?s1 . s0 = ?s1 ++ CM)}
           assume (A1 & A2 & A3)
             (!proof-case T n0 s0 A1 A2 A3)}
   datatype-cases (adapt theorem) {
     local1 => (!setup proof1 local1)
   | local2 => (!setup proof2 local2)
   | local3 => (!setup proof3 local3)
   }

(evolve FC-Theory [[Ticker-eventually-ready-to-send-tick] proof])

#=========================================================================
define Ticker-continue-message-persists :=
  (forall T T0 s0 ls0 .
    config T0 = s0 ++ (actor Ticker (ticker ls0)) &
    (unique-ids config T0) &
    (ls0 =/= local1 ==> exists s1 . s0 = s1 ++ CM) &
    T0 -->>* T
    ==>
    exists s ls .  
      config T = s ++ (actor Ticker (ticker ls)) &
      (ls =/= local1 ==> exists s1 . s = s1 ++ CM))
    
define TM := (One (message' Ticker tcls0 Clock 'tick))

define proof :=
 method (theorem adapt)
  let {given := lambda (P) (get-property P adapt FC-Theory);
       lemma := method (P) (!property P adapt FC-Theory);          
       chain := method (L) (!chain-help given L 'none);
       chain-last := method (L) (!chain-help given L 'last);
       ++A := (given ['Clock ['++ Associative]]);
       ++C := (given ['Clock ['++ Commutative]]);
       R*L := (!lemma ['Clock ['-->> R*-lemma]]);
       UI1 := (!lemma ['Clock unique-ids1]);
       AP := (!lemma ['Clock actor-persistence]);
       [LS0 next ready-to new-ls unique-ids config before after] := 
         (adapt [LS0 next ready-to new-ls unique-ids config 
                     before after]);
       id-sort := (sort-of Ticker);
       theorem' := (adapt theorem);
       [T-sort _ s-sort ls-sort] := 
          (map sort-of (qvars-of theorem'));
       TM' := match TM {(One M') => M'};
       CM' := match CM {(One M') => M'};
       send-tick := (send Ticker Clock 'tick);
       receive-tick := (receive Clock Ticker 'tick);
       send-continue := (send Ticker Ticker 'continue);
       receive-continue := (receive Ticker Ticker 'continue)}
  by-induction theorem' {
    (I as Initial:T-sort) => 
      pick-any T0:T-sort s0:s-sort ls0:ls-sort
        let {A1 := (config T0 = s0 ++ (actor Ticker (ticker ls0)));
             A2 := (unique-ids config T0);
             A3 := (ls0 =/= local1 ==> exists ?s1 . s0 = ?s1 ++ CM);
             A4 := (T0 -->>* I)}
        assume (A1 & A2 & A3 & A4)
          let {goal := (exists ?s ?ls .
                        config I = ?s ++ (actor Ticker (ticker ?ls)) &
                        (?ls =/= local1 ==> exists ?s1 . ?s = ?s1 ++ CM));
               B1 := (!chain-last
                     [A4 ==> (T0 = I | T0 -->>+ I) [R*L]])}
          (!cases B1
           assume C1 := (T0 = I)
             let {D1 := (!chain
                        [(config I) 
                         = (config T0)                          [C1]
                         = (s0 ++ (actor Ticker (ticker ls0)))  [A1]])}
             (!chain-last 
              [(D1 & A3) ==> goal        [existence]])
           assume C1 := (T0 -->>+ I)  
             (!from-complements goal
              C1
              (!chain-last
               [true ==> (~ T0 -->>+ I) [nothing-leads-to-Initial]])))
  | (T:T-sort then step) =>
      pick-any T0:T-sort s0:s-sort ls0:ls-sort 
        let {A1 := (config T0 = s0 ++ (actor Ticker (ticker ls0)));
             A2 := (unique-ids config T0);
             A3 := (ls0 =/= local1 ==> exists ?s1 . s0 = ?s1 ++ CM);
             A4 := (T0 -->>* (T then step));
             LT := (!lemma ['Clock leads-to])}
        assume (A1 & A2 & A3 & A4)
          let {goal := (exists ?s ?ls .
                         config (T then step) = ?s ++ (actor Ticker (ticker ?ls)) &
                         (?ls =/= local1 ==> exists ?s1 . ?s = ?s1 ++ CM));
               induction-hypothesis := 
                 (forall ?T0 ?s0 ?ls0 .
                     config ?T0 = ?s0 ++ (actor Ticker (ticker ?ls0)) &
                     (unique-ids config ?T0) &
                     (?ls0 =/= local1 ==> 
                           exists ?s1 . ?s0 = ?s1 ++ CM) &
                     ?T0 -->>* T
                     ==>
                     (exists ?s ?ls .
                       config T = ?s ++ (actor Ticker (ticker ?ls)) &
                       (?ls =/= local1 ==> exists ?s1 . ?s = ?s1 ++ CM)));

              B1 := (!chain-last 
                     [A4 ==> (T0 = T then step | 
                              T0 -->>+ T then step) [R*L]])}
          (!cases B1
           assume B1a := (T0 = T then step)
             let {D1 := (!chain
                         [(config (T then step)) 
                          = (config T0)                          [B1a]
                          = (s0 ++ (actor Ticker (ticker ls0)))  [A1]])}
             (!chain-last
              [(D1 & A3) ==> goal            [existence]])
           assume B1b := (T0 -->>+ T then step)
               let {C1 := (!chain-last
                           [B1b ==> (T0 -->>* T)        [LT left-and]]);
                    C2 := (!chain-last
                           [(A1 & A2 & A3 & C1)
                            ==> (exists ?s1 ?ls1 . 
                                  config T = 
                                    ?s1 ++ (actor Ticker (ticker ?ls1)) &
                                  (?ls1 =/= local1 ==> 
                                    exists ?s2 . ?s1 = ?s2 ++ CM))
                                       [induction-hypothesis]])}
               pick-witnesses s1 ls1 for C2 
                let {IHa := (config T = s1 ++ (actor Ticker (ticker ls1)));
                     IHb := (ls1 =/= local1 ==> exists ?s2 . s1 = ?s2 ++ CM);
                     D1 := (!chain-last
			   [B1b ==> (Enabled (T then step)) [LT right-and]]);
                     D2 := (!chain-last
			    [D1
			    ==> (Enabled T &
                                 exists ?s ?ls .
                                   (before T step ?s ?ls))
                                       [(given ['Clock enabled-step])]]);
                     UIP := (!lemma 
                             ['Clock Transition-Path-Relation.unique-ids-persistence]);
                     D3 := (!chain-last
			    [(A2 & C1) ==> (unique-ids config T) [UIP]]);
                     TR := (!lemma ['Clock trans-receive]);
                     UI2 := (!lemma ['Clock unique-ids2]);
                     ECA := (exclusive-constructors "Actor-Cfg.Actor");
                     a1 := (actor Ticker (ticker ls1));
                     a1' := (actor' Ticker (ticker ls1));
                     # Following method does the proof for cases where 
                     # transition step involves some actor other than Ticker
                     other-case :=  
                       method (id Step other-1 other-2 goal)
                        (!two-cases
                         assume (ls1 = local1)
                           let {E1 := (!chain-last
				       [D1 ==> (Enabled (T then Step))
					   [(step = Step)]]);
			        E2 := (!chain-last
				       [(IHa & E1 & id =/= Ticker)
					==> (exists ?s2 .
					      config (T then Step) =
					      ?s2 ++ a1)   [other-1]])}
                           pick-witness s2 for E2 E2-w
                             let {F1 := assume (ls1 =/= local1)
                                          (!from-complements
					   (exists ?s3 . s2 = ?s3 ++ CM)
					   (ls1 = local1) (ls1 =/= local1))}
                             (!chain-last
			      [(E2-w & F1) ==> goal [existence]])
                         assume (ls1 =/= local1)
                           let {G1 := (!chain-last
                                       [(ls1 =/= local1) 
                                        ==> (exists ?s2 . s1 = ?s2 ++ CM) [IHb]])}
                           pick-witness s2 for G1 G1-w
                             let {H1 := (!chain
                                         [(config T) 
                                          = (s1 ++ a1) [IHa]
                                          = ((s2 ++ CM) ++ a1) [G1-w]
                                          = (s2 ++ a1 ++ CM)   [++A ++C]]);
                                  H2 := (!chain-last
		     	   		 [D1
		     	   		  ==> (Enabled (T then Step))
		     	   		                  [(step = Step)]]);
                                  H3 := (!chain-last
		     	   		 [(H1 & H2 & id =/= Ticker)
		     	   		  ==> (exists ?s3 .
                                                config (T then Step) = 
                                                ?s3 ++ a1 ++ CM)  [other-2]])}
                             pick-witness s3 for H3 H3-w
                               let {I1 := (!chain
		     	   		   [(config (T then Step))
		     	   		    = (s3 ++ a1 ++ CM)   [H3-w]
		     	   		    = ((s3 ++ CM) ++ a1) [++A ++C]]);
                                    I2 := assume (ls1 =/= local1)
                                            (!chain-last
		     	   		     [(s3 ++ CM = s3 ++ CM)
		     	   		      ==> (exists ?s4 . s3 ++ CM = ?s4 ++ CM)
		     	   		      [existence]])}
                               (!chain-last
		     	   	[(I1 & I2) ==> goal [existence]]))}
               pick-witnesses s ls for (!right-and D2) D2-w
                datatype-cases goal on step {
                  (Receive as (receive id:id-sort fr:id-sort c)) =>
                     let {receive-goal := 
                            (exists ?s ?ls .
                              config (T then Receive) = 
                                ?s ++ (actor Ticker (ticker ?ls)) &
                              (?ls =/= local1 ==> exists ?s1 . ?s = ?s1 ++ CM));
                          M' := (message' fr tcls0 id c);
                          M := (One M');
                          a2 := (actor id ls);
                          a2' := (actor' id ls);
                          J1 := (!chain-last
				 [D2-w ==>
				    (before T Receive s ls)
				    [(step = Receive)]
				    ==> (config T = s ++ a2 ++ M &
					 ls ready-to Receive)
				    [(given ['Clock before.receiving])]]);
			  J2 := (!chain-last
				 [J1 ==> (config T = s ++ a2 ++ M)
				     [left-and]]);
                          J3 := (!chain-last
				 [J1 ==> (ls ready-to Receive)
				     [right-and]]);
			  J4 := (!chain
				 [(config T) = (s ++ a2 ++ M)   [J2]
				             = ((s ++ M) ++ a2) [++A ++C]])}
                     (!two-cases
                      assume J5a := (~ (id = Ticker & fr = Ticker & c = 'continue))
                        let {J6 := (!chain-last 
				    [J5a ==> (id =/= Ticker | 
					      (id = Ticker & ~ (fr = Ticker & c = 'continue)))
						    [prop-taut]])}
                        (!cases J6
                          assume (id =/= Ticker)
                            let {OR1 := (!lemma ['Clock other-receive-1]);
			         OR2 := (!lemma ['Clock other-receive-2])}
                            (!other-case id Receive OR1 OR2 receive-goal)
                          assume (id = Ticker & ~ (fr = Ticker & c = 'continue))
                            let {K1 := (!chain-last 
					[(~ (fr = Ticker & c = 'continue))
					 ==> (ls ready-to (receive Ticker fr c) <==> false)
					      [Ticker.ready-to-definition]
					 ==> (~ ls ready-to (receive Ticker fr c))
					      [prop-taut]
					 ==> (~ ls ready-to Receive)
					      [(id = Ticker)]])}
                            (!from-complements receive-goal J3 K1))
                      assume (id = Ticker & fr = Ticker & c = 'continue)
                        let {J7 := (!chain-last
                                    [(D3 & J4 & IHa & id = Ticker)
                                     ==> (ls = ticker ls1)         [UI1]])}
                        (!two-cases
                         assume (ls1 = local3)
                           let {K1 := (!chain-last
                                       [J1 ==> (config (T then Receive)
                                                = s ++ (actor id (next ls Receive)))
                                                        [TR]
                                                = (s ++ (actor Ticker (next ls Receive)))
                                                        [(id = Ticker)]
                                                = (s ++ (actor Ticker (next (ticker ls1) Receive)))
                                                        [J7]
                                                = (s ++ (actor Ticker (next (ticker local3) 
									    receive-continue)))
                                                        [(ls1 = local3) (id = Ticker) 
							 (fr = Ticker) (c = 'continue)]
                                                = (s ++ (actor Ticker (ticker local1)))
                                                        [Ticker.next-definition]]);
                                K2 := assume A := (local1 =/= local1)
                                        (!from-complements (exists ?s1 . s = ?s1 ++ CM)
                                         A (!reflex local1))}
                           (!chain-last
                            [(K1 & K2) ==> receive-goal [existence]])
                         assume (ls1 =/= local3)
                           let {L1 := (!chain-last
                                       [(ls1 =/= local3)
                                        ==> (ticker ls1 =/= ticker local3)  
                                                 [(!constructor-injectivity ticker)]
                                        ==> (~ ticker ls1 ready-to (receive Ticker fr c))
                                                 [Ticker.not-ready-to-receive]]);
                                L2 := (!chain-last
                                       [J3 ==> (ticker ls1 ready-to (receive Ticker fr c))
                                                 [J7 (id = Ticker)]])}
                           (!from-complements receive-goal L1 L2)))
                | (Send as (send id:id-sort to:id-sort c)) =>
                     let {send-goal := (exists ?s ?ls .
                                         config (T then Send) = 
                                           ?s ++ (actor Ticker (ticker ?ls)) &
                                         (?ls =/= local1 ==> exists ?s1 . ?s = ?s1 ++ CM));
                          a2 := (actor id ls);
                          a2' := (actor' id ls);
                          E := (!chain-last
                                [D2-w ==> 
				      (before T Send s ls)
				              [(step = Send)]
                                      ==> (config T = s ++ a2 &
                                           ls ready-to Send)
                                     [(given ['Clock before.sending])]]);
                          H1 := (!chain-last
                                 [E ==> (config T = s ++ a2) [left-and]]);
                          H2 := (!chain-last
                                 [E ==> (ls ready-to Send) [right-and]]);
                          TS := (!lemma ['Clock trans-send])}
                     (!two-cases
                      assume (id =/= Ticker)
                        let {OS1 := (!lemma ['Clock other-send-1]);
			     OS2 := (!lemma ['Clock other-send-2])}
                        (!other-case id Send OS1 OS2 send-goal)
                      assume (id = Ticker)
                        let {J1 := (!chain-last
                                    [(D3 & H1 & IHa & id = Ticker)
                                     ==> (s = s1 & ls = ticker ls1)  [UI1]]);
                             J2 := (!chain-last
                                    [H2 ==> (ticker ls1 ready-to Send)
                                        [J1]])}
                        (!two-cases
                         assume self-case := (to = Ticker & c = 'continue)
                           let {K1 := (!chain-last
                                       [J2 ==> (ticker ls1 ready-to send-continue)
                                           [(id = Ticker) (to = Ticker) (c = 'continue)]]);
                                K2 := (!chain-last
                                       [(IHa & K1)
                                        ==> (config (T then send-continue) =
                                             s1 ++ (actor Ticker 
                                                          (next (ticker ls1) send-continue))
                                             ++ CM)        [TS]
                                        ==> (config (T then Send) =
                                             s1 ++ (actor Ticker (next (ticker ls1) Send))
                                             ++ CM)
                                                [(id = Ticker) (to = Ticker) (c = 'continue)]
                                        ==> (config (T then Send) =
                                             (s1 ++ CM) ++ 
                                             (actor Ticker (next (ticker ls1) Send)))
                                                [++A ++C]]);
                                K3 := (!chain-last 
                                       [true ==> (exists ?ls2 . 
                                                   (next (ticker ls1) Send) = ticker ?ls2)
                                                            [Ticker.next-ticker]])}
                            pick-witness ls2 for K3 K3-w
                                 let {L1 := (!chain-last
                                             [K2 ==> (config (T then Send) =
                                                      (s1 ++ CM) ++ (actor Ticker (ticker ls2)))
                                                            [K3-w]]);
                                      L2 := assume (ls2 =/= local1)
                                              (!chain-last
                                               [(s1 ++ CM = s1 ++ CM)
                                                ==> (exists ?s2 . s1 ++ CM = ?s2 ++ CM)
                                                            [existence]])}
                                 (!chain-last
                                  [(L1 & L2) ==> send-goal [existence]])
                         assume not-self-case := (~ (to = Ticker & c = 'continue))
                           (!two-cases
                            assume clock-case := (to = Clock & c = 'tick)
                              let {M1 := (!chain-last
                                          [J2 ==> (ticker ls1 ready-to send-tick)
                                              [(id = Ticker) (to = Clock) (c = 'tick)]]);
                                   M2 := (!chain-last
                                          [M1 ==> (ticker ls1 = ticker local2) 
                                                   [Ticker.ready-to-definition]
                                              ==> (ls1 = local2) 
                                                   [(!constructor-injectivity ticker)]]);
                                   M3 := (!chain-last
                                          [(IHa & M1)
                                           ==> (config (T then send-tick) =
                                                s1 ++ (actor Ticker (next (ticker ls1) send-tick))
                                                ++ TM)   [TS]
                                           ==> (config (T then Send)
                                                 = s1 ++ (actor Ticker (next (ticker local2) send-tick))
                                                   ++ TM)
                                                       [(id = Ticker) (to = Clock) (c = 'tick) M2]
                                                = ((s1 ++ TM) ++
                                                   (actor Ticker (next (ticker local2) send-tick)))
                                                      [++A ++C]
                                                = ((s1 ++ TM) ++ (actor Ticker (ticker local3)))
                                                      [Ticker.next-definition]]);
                                   M4 := assume (local3 =/= local1)
                                           let {N1 := (!chain-last
                                                       [(local2 =/= local1)
                                                        ==> (ls1 =/= local1) [M2]
                                                        ==> (exists ?s2 . s1 = ?s2 ++ CM) [IHb]])}
                                           pick-witness s2 for N1 N1-w
                                             (!chain-last
                                              [(s1 ++ TM)
                                               = ((s2 ++ CM) ++ TM)
                                                       [N1-w]
                                               = ((s2 ++ TM) ++ CM)
                                                       [++A ++C]
                                               ==> (exists ?s3 . 
                                                     s1 ++ TM = ?s3 ++ CM)
                                                       [existence]])}
                               (!chain-last
                                [(M3 & M4) ==> send-goal [existence]])
                            assume not-clock-case := (~ (to = Clock & c = 'tick))
                              let {M1 := (!chain-last
                                           [(not-self-case & not-clock-case)
                                           ==> (ticker ls1 ready-to (send Ticker to c) <==> false)
                                                 [Ticker.ready-to-definition]
                                           ==> (~ ticker ls1 ready-to (send Ticker to c))
                                                 [prop-taut]
                                           ==> (~ ticker ls1 ready-to Send)
                                                 [(id = Ticker)]])}
                              (!from-complements send-goal J2 M1))))
                | (Create as (create id:id-sort id':id-sort)) =>
                     let {create-goal := 
                           (exists ?s ?ls .
                             config (T then Create) = 
                                ?s ++ (actor Ticker (ticker ?ls)) &
                             (?ls =/= local1 ==> exists ?s1 . ?s = ?s1 ++ CM));
                          a1 := (actor Ticker (ticker ls1));
                          a1' := (actor' Ticker (ticker ls1));
                          a2 := (actor id ls);
                          a2' := (actor' id ls);
                          E := (!chain-last
                                [D2-w ==> 
				      (before T Create s ls)
				             [(step = Create)]
                                      ==> (config T = s ++ a2 &
                                           (count id' config T) = zero &
                                           ls ready-to Create)
                                     [(given ['Clock before.creating])]]);
                          H1 := (!chain-last
                                 [E ==> (config T = s ++ a2) [left-and]]);
                          H2 := (!chain-last
                                 [E ==> (ls ready-to Create) 
                                    [(compose right-and right-and)]])}
                     (!two-cases
                      assume (id =/= Ticker)
                        let {OC1 := (!lemma ['Clock other-create-1]);
			     OC2 := (!lemma ['Clock other-create-2])}
                        (!other-case id Create OC1 OC2 create-goal)
                      assume (id = Ticker)
                        let {J1 := (!chain-last
                                    [(D3 & H1 & IHa & id = Ticker)
                                     ==> (ls = ticker ls1)         [UI1]]);
                             J2 := (!chain-last
                                    [H2 ==> (ticker ls1 ready-to Create)
                                                                   [J1]]);
                             J30 := (!instance (last Ticker.ready-to-definition) 
					       [(ticker ls1) id']);
                             J3 := (!chain-last
                                    [J30
                                     ==> (~ (ticker ls1 ready-to (create Ticker id')))
                                     [prop-taut]
                                     ==> (~ (ticker ls1 ready-to Create))
                                     [(id = Ticker)]])}
                        (!from-complements create-goal J2 J3))
         }) # close datatype-cases, close cases B1
  }  # close by-induction

(evolve FC-Theory [[Ticker-continue-message-persists] proof])

#=========================================================================
# For fair transition sequences as defined by Fair-Clock-System, we
# try to prove various progress theorems about the clock system, such
# as the following (the first should be a simple corollary of the
# second). The proof of the second theorem will be by induction on the
# natural number time value ?t.  The proof depends on the
# clock-monotonicity lemmas from clock-monotonicity.ath.

define Clock-Time-progress :=
  (forall t T n0 s0 ls0 t0 .
    config (citp T n0) = s0 ++ (actor Ticker (ticker ls0))
                         ++ (actor Clock (clock local t0)) &
    (unique-ids config (citp T n0)) &
    (ls0 =/= local1 ==> exists s1 . s0 = s1 ++ CM)
    ==> exists n . n >= n0 & 
          (Time Clock config (citp T n)) >= t)

define Clock-progress :=
  (forall t T n0 s0 ls0 t0 .
    config (citp T n0) = s0 ++ (actor Ticker (ticker ls0))
                         ++ (actor Clock (clock local t0)) &
    (unique-ids config (citp T n0)) &
    (ls0 =/= local1 ==> exists s1 . s0 = s1 ++ CM)
    ==> exists n s ls u . 
          n >= n0 &
          config (citp T n) = 
            s ++ (actor Ticker (ticker ls))
            ++ (actor Clock (clock local u)) &
          u >= t)

define Clock-progress-proof :=
  method (theorem adapt) 
    let {given := lambda (P) (get-property P adapt FC-Theory);
         lemma := method (P) (!property P adapt FC-Theory);          
         chain := method (L) (!chain-help given L 'none);
         chain-last := method (L) (!chain-help given L 'last);
         ++A := (given ['Clock ['++ Associative]]);
         ++C := (given ['Clock ['++ Commutative]]);
         send-tick := (send Ticker Clock 'tick);
         receive-tick := (receive Clock Ticker 'tick);
         send-continue := (send Ticker Ticker 'continue);
         receive-continue := (receive Ticker Ticker 'continue)}
    by-induction (adapt theorem) {
      zero => 
          pick-any T:(TP Name TCLS) n0 s0 ls0 t0
            let {A1 := (config (citp T n0) = 
                         s0 ++ (actor Ticker (ticker ls0)) ++
                         (actor Clock (clock local t0)));
                 A2 := (unique-ids config (citp T n0));
                 A3 := (ls0 =/= local1 ==> 
                         exists ?s1 . s0 = ?s1 ++ CM)}
            assume (A1 & A2 & A3)
              conclude goal := 
                  (exists ?n ?s ?ls ?u . 
                    ?n >= n0 &
                    config (citp T ?n) = 
                      ?s ++ (actor Ticker (ticker ?ls)) ++
                      (actor Clock (clock local ?u)) &
                    ?u >= zero)
                let {C := (!chain-last
                           [true ==> (n0 >= n0) 
                                   [N.Less=.reflexive]])}
                (!chain-last 
                 [true ==> (t0 >= zero)      [N.Less=.zero<=]
                       ==> (C & A1 & t0 >= zero) [augment]
                       ==> goal              [existence]])
    | (S t) => 
        let {ind-hyp :=
              (forall ?T ?n0 ?s0 ?ls0 ?t0 .
                  config (citp ?T ?n0) = 
                  ?s0 ++ (actor Ticker (ticker ?ls0)) ++
                  (actor Clock (clock local ?t0)) &
                (unique-ids config (citp ?T ?n0)) &
                (?ls0 =/= local1 ==> exists ?s1 . ?s0 = ?s1 ++ CM)
                ==>
                exists ?n ?s ?ls ?u . 
                  ?n >= ?n0 &
                  config (citp ?T ?n) = 
                    ?s ++ (actor Ticker (ticker ?ls)) ++ 
                    (actor Clock (clock local ?u)) &
                  ?u >= t)}
        pick-any T:(TP Name TCLS) n0 s0 ls0:TLS t0
          let {A1 := (config (citp T n0) = 
                      s0 ++ (actor Ticker (ticker ls0)) ++ 
                      (actor Clock (clock local t0)));
               A2 := (unique-ids config (citp T n0));
               A3 := (ls0 =/= local1 ==> exists ?s1 . s0 = ?s1 ++ CM)}
          assume (A1 & A2 & A3)
            let {goal := (exists ?n ?s ?ls ?u . 
                           ?n >= n0 &
                           config (citp T ?n) = 
                             ?s ++ (actor Ticker (ticker ?ls)) ++ 
                             (actor Clock (clock local ?u)) &
                           ?u >= (S t));
                 B := (!chain-last 
                       [(A1 & A2 & A3) ==> 
                        (exists ?n1 ?s1 ?ls1 ?t1 . 
                          ?n1 >= n0 &
                          config (citp T ?n1) = 
                          ?s1 ++ (actor Ticker (ticker ?ls1)) ++
                          (actor Clock (clock local ?t1)) &
                          ?t1 >= t)                  [ind-hyp]])}
            pick-witnesses n' s' ls' t' for B 
              let {B-w0 := (n' >= n0);
                   B-w1 := (config (citp T n') = 
                             s' ++ (actor Ticker (ticker ls')) ++
                             (actor Clock (clock local t')));
                   B-w2 := (t' >= t);
                   TSC := (!lemma ['Clock itp-connected]);
                   C1 := (!chain-last
                          [B-w0 ==> ((citp T n0) -->>* (citp T n')) [TSC]]);
                   A1' := (!chain-last
                           [A1 ==> (config (citp T n0) = 
                                       (s0 ++ (actor Clock (clock local t0)))
                                       ++ (actor Ticker (ticker ls0)))
                               [++A ++C]]);
                   A3' := assume (ls0 =/= local1)
                            let {A3'a := 
                                 (!chain-last
                                  [(ls0 =/= local1)
                                   ==> (exists ?s1 . s0 = ?s1 ++ CM) [A3]])}
                            pick-witness s1' for A3'a
                              let {A3'a-w := (s0 = s1' ++ CM)}
                              (!chain-last
                                [(s0 ++ (actor Clock (clock local t0)))
                                = ((s1' ++ CM) ++ (actor Clock (clock local t0)))
                                                 [A3'a-w]
                                = ((s1' ++ (actor Clock (clock local t0))) ++ CM)
                                                 [++A ++C]
                                ==> (exists ?s2 . 
                                      s0 ++ (actor Clock (clock local t0)) = 
                                      ?s2 ++ CM) [existence]]);
                   TCMP := (!lemma Ticker-continue-message-persists);
                   C2 := (!chain-last 
                          [(A1' & A2 & A3' & C1)
                           ==> (exists ?s1 ?ls1 .
                                 config (citp T n') = ?s1 ++ (actor Ticker (ticker ?ls1)) &
                                 (?ls1 =/= local1 ==> exists ?s2 . ?s1 = ?s2 ++ CM))
                           [TCMP]])}
              pick-witnesses s1 ls1 for C2 C2-w
                let {C2-w1:= (!left-and C2-w);
                     C2-w2 := (!right-and C2-w);
                     UIP := (!lemma 
                             ['Clock Transition-Path-Relation.unique-ids-persistence]);
                     C3 := (!chain-last
                            [(A2 & C1) 
                           ==> (unique-ids config (citp T n')) [UIP]]);
                     TERTST := (!lemma Ticker-eventually-ready-to-send-tick);
                     C2a := (!chain-last
                             [(C2-w1 & C3 & C2-w2)
                            ==> (exists ?n ?s ?ls .
                                  ?n >= n' &
                                  config (citp T ?n) = 
                                    ?s ++ (actor Ticker ?ls) &
                                    ?ls ready-to send-tick)
                                                [TERTST]])}
              pick-witnesses n1 s1 ls1 for C2a
                let {C2a-w1 := (n1 >= n');
                     C2a-w2 := (config (citp T n1) = s1 ++ (actor Ticker ls1));
                     C2a-w3 := (ls1 ready-to send-tick);
                     D1 := (!chain-last
                            [(n1 >= n') ==> ((citp T n') -->>* (citp T n1)) [TSC]]);
                     B-w1' := (!chain-last
                                [B-w1 ==> (config (citp T n') = 
                                           (s' ++ (actor Ticker (ticker ls')))
                                           ++ (actor Clock (clock local t')))
                                               [++A ++C]]);
                     Cmono := (!lemma Monotonicity.clock-monotonicity);
                     D2 := (!chain-last
                            [(C3 & B-w1' & D1)
                             ==> (exists ?s ?t .
                                   config (citp T n1) = 
                                     ?s ++ (actor Clock (clock local ?t)) &
                                   ?t >= t')       [Cmono]])}
                pick-witnesses s1 t1 for D2
                  let {D2-w1 := (config (citp T n1) = 
                                 s1 ++ (actor Clock (clock local t1)));
                       D2-w2 := (t1 >= t');
                       UI2 := (!lemma ['Clock unique-ids2]);
                       E1 := (!chain-last 
                              [(Ticker =/= Clock)
                               ==> ((actor' Ticker ls1) =/= 
                                    (actor' Clock (clock local t1)))
                               [UI2]]);
                       CT := (!lemma ['Clock Together]);
                       E2 := (!chain-last
                              [(C2a-w2 & D2-w1 & E1)
                               ==> (exists ?s3 . 
                                     config (citp T n1) = 
                                       ?s3 ++ (actor Ticker ls1) ++
                                       (actor Clock (clock local t1)))
                                                   [CT]])}
                  pick-witness s3 for E2 E2-w
                    let {IRTSTER := 
                           (!lemma 
                            ['Clone2 ['Clock guaranteed-message-reception]]);
                         UIP := (!lemma ['Clock unique-ids-persistence]);
                         F1 := (!chain-last
                                [(C3 & n1 >= n') 
                                 ==> (unique-ids config (citp T n1)) [UIP]]);
                         F2 := 
                           (!chain-last
                            [(E2-w & C2a-w3 & F1) 
                             ==> 
                             (exists ?n2 ?s2 ?ls3 ?ls4 . 
                               ?n2 >= n1 &
                               config (citp T ?n2) =
                                 (?s2 ++ (actor Ticker ?ls3)) ++ 
                                 (actor Clock ?ls4) ++ TM &
                               ?ls4 ready-to receive-tick &
                               (citp T (S ?n2)) = 
                                 ((citp T ?n2) then receive-tick)) [IRTSTER]])}
                      pick-witnesses n2 s2 ls3 ls4 for F2
                        let {F2-w1 := (n2 >= n1);
                             F2-w2 := (config (citp T n2) = 
                                         (s2 ++ (actor Ticker ls3)) ++ 
                                         (actor Clock ls4) ++ TM);
                             F2-w3 := (ls4 ready-to receive-tick);
                             F2-w4 := ((citp T (S n2)) = 
                                        ((citp T n2) then receive-tick));
                             G1 := (!chain-last 
                                    [F2-w1 ==> ((citp T n1) -->>* (citp T n2)) 
                                                                  [TSC]]);
                             G2 := (!chain-last
                                    [(config (citp T n1))
                                     = (s3 ++ (actor Ticker ls1) 
                                           ++ (actor Clock (clock local t1)))  
                                                                        [E2-w]
                                     = ((s3 ++ (actor Ticker ls1))
                                        ++ (actor Clock 
                                                  (clock local t1)))        [++A ++C]]);
                             G3 := (!chain-last 
                                    [(config (citp T n2))
                                     = ((s2 ++ (actor Ticker ls3)) ++ 
                                        (actor Clock ls4) ++ TM)  [F2-w2]
                                     = (((s2 ++ (actor Ticker ls3)) ++ TM)
                                        ++ (actor Clock ls4))    [++A ++C]]);
                             Cmono-1 := (!lemma Monotonicity.clock-monotonicity-1);
                             G4 := (!chain-last
                                     [(F1 & G2 & G1 & G3)
                                     ==> (exists ?t .
                                           ls4 = (clock local ?t) & 
                                           ?t >= t1)    [Cmono-1]])}
                        pick-witness t2 for G4
                          let {G4-w1 := (ls4 = (clock local t2));
                               G4-w2 := (t2 >= t1);
                               TR := (!lemma ['Clock trans-receive]);
                               H1 := (!chain-last
                                      [(F2-w2 & F2-w3)
                                       ==> (config ((citp T n2) then receive-tick) =
                                            (s2 ++ (actor Ticker ls3)) ++ 
                                            (actor Clock
                                                   (next ls4 receive-tick))) [TR]
                                       ==> (config (citp T (S n2))
                                            = (s2 ++ (actor Ticker ls3)) ++ 
                                               (actor Clock
                                                   (next (clock local t2)
                                                         receive-tick)))
                                                      [F2-w4 G4-w1]
                                            = ((s2 ++ (actor Ticker ls3)) ++ 
                                               (actor Clock (clock local (S t2))))
                                                      [Clock.next-definition]
                                            = (s2 ++ (actor Ticker ls3) ++ 
                                               (actor Clock (clock local (S t2))))
                                                      [++A]]);
                             H2 := (!chain-last 
                                    [true ==> ((S n2) >= n2)  [N.Less=.S3]]);
                             H3 := (!combine-inequalities 
                                    [(n' >= n0)        #
                                     (n1 >= n')        # 
                                     (n2 >= n1)        # F2-w1
                                     ((S n2) >= n2)]); # H2
                             H4 := (!chain-last
                                    [H1 
                                     ==> (config (citp T (S n2)) =
                                            (s2 ++ (actor Clock 
                                                          (clock local (S t2))))
                                            ++ (actor Ticker ls3)) [++A ++C]]);
                             H5 := (!chain-last
                                    [(A2 & H3)
                                     ==> (unique-ids config (citp T (S n2)))
                                                                   [UIP]]);
                             H6 := (!chain-last 
                                    [H3 ==> ((citp T n0) -->>* (citp T (S n2)))
                                                                   [TSC]]);
                             Tmono-1 := (!lemma Monotonicity.ticker-monotonicity-1);
                             H7 := (!chain-last
                                    [(A2 & A1' & H6 & H4)
                                     ==> (exists ?ls . ls3 = ticker ?ls)
                                               [Tmono-1]])}
                          pick-witness ls for H7 H7-w
                            let {J1 := (!combine-inequalities
                                        [(t' >= t)         # B-w2
                                         (t1 >= t')        # G2-w2
                                         (t2 >= t1)]);     # G4-w2
                                 J2 := (!chain-last
                                        [H1 ==> (config (citp T (S n2)) =
                                                 s2 ++ (actor Ticker (ticker ls)) ++ 
                                                 (actor Clock (clock local (S t2))))
                                                        [H7-w]])}
                            (!chain-last
                             [J1 ==> ((S t2) >= (S t))  [N.Less=.injective]
                                 ==> (H3 & J2 & (S t2) >= (S t)) [augment]
                                 ==> goal               [existence]])
    } # close by-induction

(evolve FC-Theory [[Clock-progress] Clock-progress-proof])

define Clock-Time-progress-proof :=
  method (theorem adapt) 
    let {given := lambda (P) (get-property P adapt FC-Theory);
         lemma := method (P) (!property P adapt FC-Theory);          
         chain := method (L) (!chain-help given L 'none);
         chain-last := method (L) (!chain-help given L 'last);
         ++A := (given ['Clock ['++ Associative]]);
         ++C := (given ['Clock ['++ Commutative]])}
    pick-any t T:(TP Name TCLS) n0 s0 ls0 t0
      assume A := (config (citp T n0) = s0 ++ (actor Ticker (ticker ls0)) ++
                    (actor Clock (clock local t0)) &
                   (unique-ids config (citp T n0)) &
                   (ls0 =/= local1 ==> exists ?s1 . s0 = ?s1 ++ CM))
        let {CP := (!lemma Clock-progress);
             B := (!chain-last 
                   [A ==> (exists ?n ?s ?ls ?u .
                            ?n >= n0 &
                            config (citp T ?n) =
                             ?s ++ (actor Ticker (ticker ?ls))
                             ++ (actor Clock (clock local ?u)) &
                            ?u >= t)          [CP]])}
        pick-witnesses n s ls u for B
          let {w0 := (n >= n0);
               w1 := (config (citp T n) =
                       s ++ (actor Ticker (ticker ls)) ++
                       (actor Clock (clock local u)));
               w2 := (u >= t);
               C := (!chain
                     [(Time Clock (config (citp T n)))
                      = (Time Clock 
                              (s ++ (actor Ticker (ticker ls))
                                 ++ (actor Clock (clock local u))))
                                             [w1]
                      = (Time Clock
                              ((s ++ (actor Ticker (ticker ls)))
                               ++ (actor Clock (clock local u))))
                                             [++A ++C]
                      = u                    [Time.read]])}
          (!chain-last 
           [w2 
            ==> ((Time Clock config (citp T n)) >= t) [C]
            ==> (w0 & (Time Clock config (citp T n)) >= t)
                                             [augment]
            ==> (exists ?n . 
                  ?n >= n0 & 
                  (Time Clock config (citp T ?n)) >= t)
                                             [existence]])

(evolve FC-Theory [[Clock-Time-progress] Clock-Time-progress-proof])

} # close module Fair-Clock-System


