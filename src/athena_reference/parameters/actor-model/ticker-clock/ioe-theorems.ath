# These theorems prove that the Ticker and Clock implementations have
# the infinitely-often-enabled (IOE) send, receive, and create properties
# needed to prove the receive-happens and send-happens  theorems, and thus
# the Clock progress properties.  They apply the receive-remains-enabled
# and send-remains-enabled theorems proved in fairness.ath.

#----------------------------------------------------------------------
define IOE-Clock-receive :=
 (forall T n s ls .
   (unique-ids config (citp T n)) &
   config (citp T n) = s ++ (actor Clock ls) ++
                        (One (message' Ticker tcls0 Clock 'tick)) &
   ls ready-to (receive Clock Ticker 'tick)
   ==> (citp T (S n)) = (citp T n) then (receive Clock Ticker 'tick)
       | exists k s' ls' . 
          k > n & 
          config (citp T k) = s' ++ (actor Clock ls') ++ 
                                (One (message' Ticker tcls0 Clock 'tick)) &
          ls' ready-to (receive Clock Ticker 'tick))

# To prove this theorem, we first define and prove the following lemma:

define Clock-next-receive := 
  (forall step t . 
     focus step = Clock &
     step =/= (receive Clock Ticker 'tick)
     ==> (next (clock local t) step) = (clock local t))

datatype-cases Clock-next-receive {
      (receive id' fr' c') =>
           let {A1 := (focus (receive id' fr' c') = Clock);
		A2 := ((receive id' fr' c') =/= (receive Clock Ticker 'tick))}
           pick-any t
             assume (A1 & A2)
                (!two-cases
		 assume (id' = Clock & fr' = Ticker & c' = 'tick)
                   (!from-complements 
		    ((next (clock local t) (receive id' fr' c')) = (clock local t))
		    (!chain
		     [(receive id' fr' c') 
		      = (receive Clock Ticker 'tick)
			   [(id' = Clock) (fr' = Ticker) (c' = 'tick)]])
		    A2)
                 assume (~ (id' = Clock & fr' = Ticker & c' = 'tick))
                    (!chain
		     [(next (clock local t) (receive id' fr' c'))
		      = (clock local t)    [Clock.next-definition]]))
    | (send id' to' c') =>
        let {A1 := (focus (send id' to' c') = Clock);
	     A2 := ((send id' to' c') =/= (receive Clock Ticker 'tick))}
        pick-any t
            assume (A1 & A2)
             (!chain
	      [(next (clock local t) (send id' to' c'))
	       = (clock local t)                [Clock.next-definition]])
    | (create id' id'') =>
        let {A1 := (focus (create id' id'') = Clock);
	     A2 := ((create id' id'') =/= (receive Clock Ticker 'tick))}
        pick-any t
          assume (A1 & A2)
            (!chain
	     [(next (clock local t) (create id' id''))
	      = (clock local t)                [Clock.next-definition]])
    }

# We next define a method that can be used both for IOE-Clock-receive
# and IOE-Ticker-receive:

define prove-IOE-receive :=
 method (recipient contents lemma)
  pick-any T n s ls
    let {M := (One (message' Ticker tcls0 recipient contents));
         A0 := (unique-ids config (citp T n));
         A1 := (config (citp T n) = s ++ (actor recipient ls) ++ M);
         A2 := (ls ready-to (receive recipient Ticker contents))}
    assume (A0 & A1 & A2)
      let {goal1 := ((citp T (S n)) = (citp T n) then (receive recipient Ticker contents));
           goal2 := (exists ?k ?s' ?ls' .
                       ?k > n &
                       config (citp T ?k) =
                         ?s' ++ (actor recipient ?ls') ++ M &
                       ?ls' ready-to (receive recipient Ticker contents));
           goal := (goal1 | goal2);
           RRE := (!property ['Clone2 ['Clock receive-remains-enabled]] 
			     no-renaming FC-Theory);
           B1 := (!chain-last 
		  [true ==> ((S n) > n) [N.Less.<S]]);
	   B1a := check {
                    (recipient equal? Clock) =>
                       (!chain-last
			[A2 ==> (Ticker = Ticker & contents = 'tick &
                                 exists ?t . ls = clock local ?t) 
			                     [Clock.ready-to-definition]
                            ==> (exists ?t . ls = clock local ?t) [taut]])
                  | else => (!chain-last
			     [A2 ==> (ls = ticker local3)  [Ticker.ready-to-definition]])
                  };
           B2a := method (local-state justification) 
                   let {B3a := pick-any step
                                (!chain
				 [(focus step = recipient & 
                                   step =/= (receive recipient Ticker contents))
				  ==> ((next local-state step) = local-state) [lemma]
				  ==> ((next ls step) = ls)	   [justification]]);
                        B3 := (!chain-last
			       [(A1 & A2 & B3a & A0)
				==> (goal1 |
				     exists ?s' .
				       config (citp T (S n)) =
				         ?s' ++ (actor recipient ls) ++ M &
				       ls ready-to (receive recipient Ticker contents))
                                                    [RRE]])}
                    (!cases B3
		     (!chain [goal1 ==> goal        [alternate]])
                     assume B4 := (exists ?s' .
                                    config (citp T (S n)) =
                                        ?s' ++ (actor recipient ls) ++ M &
                                    ls ready-to (receive recipient Ticker contents))
                       pick-witness s' for B4 B4-w
		         (!chain-last
			  [(B1 & B4-w) ==> goal2      [existence]
			               ==> goal       [alternate]]))}
      check {
        (recipient equal? Clock) =>
           pick-witness t for B1a B1a-w
             (!B2a (clock local t) B1a-w)
      | else => (!B2a (ticker local3) B1a)
      }

# Now we can prove IOE-Clock-receive:

conclude IOE-Clock-receive 
  (!prove-IOE-receive Clock 'tick Clock-next-receive)

#----------------------------------------------------------------------
define IOE-Ticker-receive :=
 (forall T n s ls .
   (unique-ids config (citp T n)) &
   config (citp T n) = s ++ (actor Ticker ls) ++
                        (One (message' Ticker tcls0 Ticker 'continue)) &
   ls ready-to (receive Ticker Ticker 'continue)
   ==> (citp T (S n)) = (citp T n) then (receive Ticker Ticker 'continue)
       | exists k s' ls' . 
          k > n & 
          config (citp T k) = s' ++ (actor Ticker ls') ++ 
                                (One (message' Ticker tcls0 Ticker 'continue)) &
          ls' ready-to (receive Ticker Ticker 'continue))

# To prove this theorem, we first define and prove the following lemma:

define Ticker-next-receive := 
  (forall step . 
     focus step = Ticker &
     step =/= (receive Ticker Ticker 'continue)
     ==> (next (ticker local3) step) = ticker local3) 

datatype-cases Ticker-next-receive {
      (receive id' fr' c') =>
           let {A1 := (focus (receive id' fr' c') = Ticker);
		A2 := ((receive id' fr' c') =/= (receive Ticker Ticker 'continue));
		ECS := (exclusive-constructors "Step")}
           assume (A1 & A2)
             (!two-cases
	      assume (id' = Ticker & fr' = Ticker & c' = 'continue)
                (!from-complements 
		 ((next (ticker local3) (receive id' fr' c')) = (ticker local3))
		 (!chain
		  [(receive id' fr' c') 
		   = (receive Ticker Ticker 'continue)
			   [(id' = Ticker) (fr' = Ticker) (c' = 'continue)]])
		 A2)
              assume B0 := (~ (id' = Ticker & fr' = Ticker & c' = 'continue))
                    let {B1 := ((receive id' fr' c') = 
				(receive Ticker Ticker 'continue));
                         B2 := (!by-contradiction (~ B1)
                                assume B1
                                  (!absurd (!chain-last
					    [B1 ==> (and (id' = Ticker) (fr' = Ticker) 
							 (c' = 'continue))
						[(!constructor-injectivity receive)]
						==> (id' = Ticker & fr' = Ticker & 
						     c' = 'continue) [and-conv]])
				   	   B0))}
		    (!chain-last
		     [B2 ==> ((next (ticker local3) (receive id' fr' c')) = 
			      (ticker local3))
			 [Ticker.next-definition]]))
    | (send id' to' c') =>
        let {A1 := (focus (send id' to' c') = Ticker);
	     A2 := ((send id' to' c') =/= (receive Ticker Ticker 'continue))}
        assume (A1 & A2)
          (!chain-last
	   [A2 ==> ((next (ticker local3) (send id' to' c'))
		    = (ticker local3))            [Ticker.next-definition]])
    | (create id' id'') =>
        let {A1 := (focus (create id' id'') = Ticker);
	      A2 := ((create id' id'') =/= (receive Ticker Ticker 'continue))}
        assume (A1 & A2)
          (!chain-last
	   [A2 ==> ((next (ticker local3) (create id' id''))
		    = (ticker local3))             [Ticker.next-definition]])
    }

# Now we can prove IOE-Ticker-receive using the method prove-IOE-receive:

conclude IOE-Ticker-receive 
  (!prove-IOE-receive Ticker 'continue Ticker-next-receive)

#----------------------------------------------------------------------
# To prove the IOE theorems about Ticker sending, we define parametrized
# functions and methods:

define IOE-Ticker-send-to :=
 lambda (recipient contents)
  (forall T n s ls .
   (unique-ids config (citp T n)) &
   config (citp T n) = s ++ (actor Ticker ls) &
   ls ready-to (send Ticker recipient contents)
   ==> (citp T (S n)) = (citp T n) then (send Ticker recipient contents)
       | exists k s' ls' . 
          k > n & 
          config (citp T k) = s' ++ (actor Ticker ls') &
          ls' ready-to (send Ticker recipient contents))

# To prove (IOE-Ticker-send-to Ticker 'continue) we define the
# following parametrized lemma and proof method:

define Ticker-next-send-to := 
 lambda (recipient contents local-state)
  (forall step . 
     focus step = Ticker &
     step =/= (send Ticker recipient contents)
     ==> (next (ticker local-state) step) = ticker local-state) 

define prove-Ticker-next-send-to :=
  method (recipient contents local-state)
    datatype-cases (Ticker-next-send-to recipient contents local-state) {
      (send id' to' c') =>
           let {A1 := (focus (send id' to' c') = Ticker);
		A2 := ((send id' to' c') =/= (send Ticker recipient contents));
		ECS := (exclusive-constructors "Step")}
           assume (A1 & A2)
             (!two-cases
	      assume (id' = Ticker & to' = recipient & c' = contents)
                (!from-complements 
		 ((next (ticker local-state) (send id' to' c')) = 
		  (ticker local-state))
		 (!chain
		  [(send id' to' c') 
		   = (send Ticker recipient contents)
			   [(id' = Ticker) (to' = recipient) (c' = contents)]])
		 A2)
              assume B0 := (~ (id' = Ticker & to' = recipient & c' = contents))
                let {B1 := ((send id' to' c') = (send Ticker recipient contents));
		     B2 := (!by-contradiction (~ B1)
                            assume B1
                              (!absurd 
			       (!chain-last
				[B1 ==> (and (id' = Ticker) (to' = recipient) 
					     (c' = contents))
						[(!constructor-injectivity send)]
				==> (id' = Ticker & to' = recipient & c' = contents) 
				                [and-conv]])
			       B0))}
		    (!chain-last
		     [B2 ==> ((next (ticker local-state) (send id' to' c')) = 
			      (ticker local-state))
			 [Ticker.next-definition]]))
    | (receive id' fr' c') =>
        let {A1 := (focus (receive id' fr' c') = Ticker);
	     A2 := ((receive id' fr' c') =/= (send Ticker recipient contents))}
        assume (A1 & A2)
          (!chain-last
	   [A2 ==> ((next (ticker local-state) (receive id' fr' c'))
		    = (ticker local-state))            [Ticker.next-definition]])
    | (create id' id'') =>
        let {A1 := (focus (create id' id'') = Ticker);
	     A2 := ((create id' id'') =/= (send Ticker recipient contents))}
        assume (A1 & A2)
          (!chain-last
	   [A2 ==> ((next (ticker local-state) (create id' id''))
		    = (ticker local-state))             [Ticker.next-definition]])
    }

# Next, a method for proof of (IOE-Ticker-send-to recipient contents):

define prove-IOE-Ticker-send-to :=
 method (recipient contents local-state)
  conclude (IOE-Ticker-send-to recipient contents)
   pick-any T n s ls
    let {A0 := (unique-ids config (citp T n));
         A1 := (config (citp T n) = s ++ (actor Ticker ls));
         A2 := (ls ready-to (send Ticker recipient contents))}
    assume (A0 & A1 & A2)
      let {goal1 := ((citp T (S n)) = (citp T n) then (send Ticker recipient contents));
           goal2 := (exists ?k ?s' ?ls' .
                       ?k > n &
                       config (citp T ?k) =
                         ?s' ++ (actor Ticker ?ls') &
                       ?ls' ready-to (send Ticker recipient contents));
           goal := (goal1 | goal2);
           SRE := (!property ['Clone1 ['Clock send-remains-enabled]] 
			     no-renaming FC-Theory);
           B1 := (!chain-last 
		  [true ==> ((S n) > n) [N.Less.<S]]);
           B1a := (!chain-last
		   [A2 ==> (ls = ticker local-state) [Ticker.ready-to-definition]]);
           TNS := (!prove-Ticker-next-send-to recipient contents local-state);
           B2a := pick-any step
                    (!chain
		     [(focus step = Ticker & step =/= (send Ticker recipient contents))
		      ==> ((next (ticker local-state) step) = ticker local-state) [TNS]
		      ==> ((next ls step) = ls)                         [B1a]]);
           B3 := (!chain-last
		  [(A1 & A2 & B2a & A0)
		   ==> (goal1 |
                        exists ?s' .
                          config (citp T (S n)) =
                            ?s' ++ (actor Ticker ls) &
                          ls ready-to (send Ticker recipient contents))	   [SRE]])}
      (!cases B3
       (!chain [goal1 ==> goal       [alternate]])
       assume B4 := (exists ?s' .
                       config (citp T (S n)) =
                         ?s' ++ (actor Ticker ls) &
                       ls ready-to (send Ticker recipient contents))
         pick-witness s' for B4 B4-w
           (!chain-last
	    [(B1 & B4-w) ==> goal2       [existence]
	                 ==> goal        [alternate]]))


# Now we can prove both of the IOE-Ticker-send-to theorems:

conclude (IOE-Ticker-send-to Ticker 'continue)
  (!prove-IOE-Ticker-send-to Ticker 'continue local1)

conclude (IOE-Ticker-send-to Clock 'tick)
  (!prove-IOE-Ticker-send-to Clock 'tick local2)

# IOE-Clock-create 

# First, a lemma:

define Clock-next-state :=
  (forall step t .
    exists ?t' . 
      (next (clock local t) step) = clock local ?t')

datatype-cases Clock-next-state {
  (receive id fr c) => 
    pick-any t
      (!two-cases
       assume (id = Clock & fr = Ticker & c = 'tick)
         (!chain-last
	  [(next (clock local t) (receive id fr c))
	   = (clock local (S t))  [Clock.next-definition]
	   ==> (exists ?t' .
                 (next (clock local t) (receive id fr c)) = clock local ?t')
	   [existence]])
       assume (~ (id = Clock & fr = Ticker & c = 'tick))
         (!chain-last
	  [(next (clock local t) (receive id fr c))
	   = (clock local t)  [Clock.next-definition]
	   ==> (exists ?t' .
                 (next (clock local t) (receive id fr c)) = clock local ?t')
	   [existence]]))
| (send id to c) =>
    pick-any t
      (!chain-last
       [(next (clock local t) (send id to c)) 
	= (clock local t)    [Clock.next-definition]
	==> (exists ?t' .
                 (next (clock local t) (send id to c)) = clock local ?t')
	[existence]])
| (create id id1) =>
    pick-any t
      (!chain-last
       [(next (clock local t) (create id id1))
	= (clock local t)    [Clock.next-definition]
	==> (exists ?t' .
                 (next (clock local t) (create id id1)) = clock local ?t')
	[existence]])
}

define IOE-Clock-create :=
 (forall T n s ls id1 .
   (unique-ids config (citp T n)) &
   config (citp T n) = s ++ (actor Clock ls) &
   (count id1 config (citp T n)) = zero &
   ls ready-to (create Clock id1)
   ==> (citp T (S n)) = (citp T n) then (create Clock id1)
       | exists k s' ls' . 
          k > n & 
          config (citp T k) = s' ++ (actor Clock ls') &
          (count id1 config (citp T k)) = zero & 
          ls' ready-to (create Clock id1))

conclude IOE-Clock-create
  pick-any T n s ls id1
    let {given := lambda (P) (get-property ['Clone1 ['Clock P]] 
					   no-renaming FC-Theory);
	 lemma := method (P) (!property ['Clone1 ['Clock P]] 
					no-renaming FC-Theory);
	 chain := method (L) (!chain-help given L 'none);
	 chain-last := method (L) (!chain-help given L 'last);
         A0 := (unique-ids config (citp T n));
         A1 := (config (citp T n) = s ++ (actor Clock ls));
         A2 := ((count id1 config (citp T n)) = zero);
         A3 := (ls ready-to (create Clock id1))}
    assume (A0 & A1 & A2 & A3)
      let {goal1 := ((citp T (S n)) = (citp T n) then (create Clock id1));
           goal2 := (exists ?k ?s' ?ls' .
                      ?k > n &
                      config (citp T ?k) = 
                        ?s' ++ (actor Clock ?ls') &
                      (count id1 config (citp T ?k)) = zero &
                      ?ls' ready-to (create Clock id1));
           goal := (goal1 | goal2);
           B1 := (!chain-last 
		  [true ==> ((S n) > n) [N.Less.<S]]);
           B2 := pick-any ls1 step
                   assume B2a := (ls1 ready-to (create Clock id1))
                     conclude ((next ls1 step) ready-to (create Clock id1))
                       let {B2b := (!chain-last
				    [B2a ==> (exists ?t . ls1 = clock local ?t)
					        [Clock.ready-to-definition]])}
                       pick-witness t for B2b B2b-w
                         (!chain-last
			  [true ==> (exists ?t' . 
				      (next (clock local t) step) = 
				      (clock local ?t'))
				        [Clock-next-state]
				==> ((next (clock local t) step) ready-to 
				     (create Clock id1))
				        [Clock.ready-to-definition]
				==> ((next ls1 step) ready-to (create Clock id1))
				        [B2b-w]]);
           goal2' := (exists ?s' ?ls' .
                       config (citp T (S n)) = ?s' ++ (actor Clock ?ls') &
                       (count id1 config (citp T (S n))) = zero & 
                       ?ls' ready-to (create Clock id1));
           CRE := (!lemma create-remains-enabled);
           B3 := (!chain-last
		  [(A1 & A3 & B2 & A0 & A2) ==> (goal1 | goal2')  [CRE]])}
      (!cases B3
       assume goal1
         (!chain-last [goal1 ==> goal [alternate]])
       assume goal2'
         pick-witnesses s' ls' for goal2' goal2'-w
           (!chain-last
	    [(B1 & goal2'-w) ==> goal2  [existence]
	                     ==> goal   [alternate]]))

# And finally, combining these results and filling in the gaps:

define step := ?step:(Step Clock-Actors.Name)

define IOE-Ticker-Clock :=
  (forall step T n s ls . 
    (unique-ids config (citp T n)) &
    (before (citp T n) step s ls)
    ==>
    (citp T (S n)) = (citp T n) then step |
    exists k s' ls' . 
      k > n & 
      (before (citp T k) step s' ls'))

let {BR := (!property ['Clone1 ['Clock before.receiving]] no-renaming FC-Theory);
     BS := (!property ['Clone1 ['Clock before.sending]] no-renaming FC-Theory);
     BC := (!property ['Clone1 ['Clock before.creating]] no-renaming FC-Theory)}
datatype-cases IOE-Ticker-Clock {
  (receive id:Clock-Actors.Name fr c) =>
    datatype-cases 
      (forall ?T ?n ?s ?ls .
         (unique-ids config (citp ?T ?n)) &
	 (before (citp ?T ?n) (receive id fr c) ?s ?ls)
	 ==>
	 (citp ?T (S ?n)) = (citp ?T ?n) then (receive id fr c) |
	 exists ?k ?s' ?ls' . 
	   ?k > ?n & 
	   (before (citp ?T ?k) (receive id fr c) ?s' ?ls'))
      on id {
        Ticker => 
        datatype-cases 
           (forall ?T ?n ?s ?ls .
             (unique-ids config (citp ?T ?n)) &
	     (before (citp ?T ?n) (receive Ticker fr c) ?s ?ls)
	     ==>
	     (citp ?T (S ?n)) = (citp ?T ?n) then (receive Ticker fr c) |
	     exists ?k ?s' ?ls' . 
	       ?k > ?n & 
	       (before (citp ?T ?k) (receive Ticker fr c) ?s' ?ls'))
           on fr {
             Ticker => 
             pick-any T n s ls
               let {A1 := (unique-ids config (citp T n));
                    A2 := (before (citp T n) (receive Ticker Ticker c) s ls)}
               assume (A1 & A2)
	         let {goal :=
		       ((citp T (S n)) = (citp T n) then (receive Ticker Ticker c)
			| exists ?k ?s' ?ls' .
                            ?k > n &
			    (before (citp T ?k) (receive Ticker Ticker c) ?s' ?ls'))}
                 (!two-cases
	          assume (c = 'continue)
                    let {B1 := (!chain-last
				[A2 
				 ==> (config (citp T n) = 
                     	               s ++ (actor Ticker ls) ++
				       (One (message' Ticker tcls0 Ticker c)) &
                                      ls ready-to (receive Ticker Ticker c))
				 [BR]
				 ==> (config (citp T n) = 
                     	               s ++ (actor Ticker ls) ++
				       (One (message' Ticker tcls0 Ticker 'continue)) &
                                      ls ready-to (receive Ticker Ticker 'continue))
				 [(c = 'continue)]])}
		    (!chain-last
		     [(A1 & B1) 
		      ==> ((citp T (S n)) = 
			     (citp T n) then (receive Ticker Ticker 'continue)
			   | exists ?k ?s' ?ls' .
                               ?k > n &
                               config (citp T ?k) =
                    	         ?s' ++ (actor Ticker ?ls') ++
			         (One (message' Ticker tcls0 Ticker 'continue)) &
                               ?ls' ready-to (receive Ticker Ticker 'continue))
		      [IOE-Ticker-receive]
		      ==> ((citp T (S n)) = 
			     (citp T n) then (receive Ticker Ticker 'continue)
			   | exists ?k ?s' ?ls' .
                               ?k > n &
			       (before (citp T ?k) (receive Ticker Ticker 'continue) 
				       ?s' ?ls'))
		      [BR]
		      ==> goal 	      [(c = 'continue)]])
	          assume (c =/= 'continue)
		    let {B1 := (!chain-last
				[A2 
				 ==> (config (citp T n) = 
                     	               s ++ (actor Ticker ls) ++
				       (One (message' Ticker tcls0 Ticker c)) &
                                      ls ready-to (receive Ticker Ticker c))  [BR]
				 ==> (ls ready-to (receive Ticker Ticker c))
				 [right-and]]);
                         B2 := (!chain-last
				[(c =/= 'continue)
				 ==> (~ (Ticker = Ticker & c = 'continue)) [prop-taut]
				 ==> (ls ready-to (receive Ticker Ticker c) <==> false)
				 [Ticker.ready-to-definition]
				 ==> (~ (ls ready-to (receive Ticker Ticker c)))
				 [prop-taut]])}
                    (!from-complements goal B1 B2))
           | Clock =>
                pick-any T n s ls
                  let {A1 := (unique-ids config (citp T n));
                       A2 := (before (citp T n) (receive Ticker Clock c) s ls)}
                  assume (A1 & A2)
		    let {B1 := (!chain-last
				[A2 ==> (ls ready-to (receive Ticker Clock c))
				          [BR right-and]]);
                         B2 := (!chain-last
				[(Ticker =/= Clock)
				 ==> (Clock =/= Ticker)                   [sym]
				 ==> (~ (Clock = Ticker & c = 'continue)) [prop-taut]
				 ==> (ls ready-to (receive Ticker Clock c) <==> false)
				 [Ticker.ready-to-definition]
				 ==> (~ (ls ready-to (receive Ticker Clock c)))
				 [prop-taut]])}
                    (!from-complements
		      ((citp T (S n)) = (citp T n) then (receive Ticker Clock c) |
		       exists ?k ?s' ?ls' .
                         ?k > n &
			 (before (citp T ?k) (receive Ticker Clock c) ?s' ?ls'))
                      B1 B2)
           }
      | Clock => 
        datatype-cases 
         (forall ?T ?n ?s ?ls .
           (unique-ids config (citp ?T ?n)) &
	   (before (citp ?T ?n) (receive Clock fr c) ?s ?ls)
	   ==>
	   (citp ?T (S ?n)) = (citp ?T ?n) then (receive Clock fr c) 
	   | exists ?k ?s' ?ls' . 
	       ?k > ?n & 
	       (before (citp ?T ?k) (receive Clock fr c) ?s' ?ls'))
        on fr {
          Ticker => # id = Clock & fr = Ticker
          pick-any T n s ls
            let {A1 := (unique-ids config (citp T n));
                 A2 := (before (citp T n) (receive Clock Ticker c) s ls)}
            assume (A1 & A2)
              let {goal :=
                    ((citp T (S n)) = (citp T n) then (receive Clock Ticker c)
                     | exists ?k ?s' ?ls' .
                         ?k > n &
                         (before (citp T ?k) (receive Clock Ticker c) ?s' ?ls'))}
              (!two-cases
               assume (c = 'tick)
                 let {B1 := 
                   (!chain-last
		    [A2
		     ==> (config (citp T n) = 
                          s ++ (actor Clock ls) 
			  ++ (One (message' Ticker tcls0 Clock c)) &
			  ls ready-to (receive Clock Ticker c))
		     [BR]
		     ==> (config (citp T n) = 
                          s ++ (actor Clock ls) 
			  ++ (One (message' Ticker tcls0 Clock 'tick)) &
			  ls ready-to (receive Clock Ticker 'tick))
		     [(c = 'tick)]])}
                 (!chain-last
		  [(A1 & B1)
		   ==> ((citp T (S n)) = (citp T n) then (receive Clock Ticker 'tick)
                        | exists ?k ?s' ?ls' .
                            ?k > n &
                            config (citp T ?k) = 
			      ?s' ++ (actor Clock ?ls') ++
			      (One (message' Ticker tcls0 Clock 'tick)) &
                            ?ls' ready-to (receive Clock Ticker 'tick))
		   [IOE-Clock-receive]
		   ==> ((citp T (S n)) = (citp T n) then (receive Clock Ticker 'tick)
                        | exists ?k ?s' ?ls' .
                            ?k > n &
                            (before (citp T ?k) (receive Clock Ticker 'tick) 
				    ?s' ?ls'))   [BR]
		   ==> goal 		         [(c = 'tick)]])
               assume (c =/= 'tick)
		 let {B1 := (!chain-last
			     [A2 ==> (ls ready-to (receive Clock Ticker c))
				 [BR right-and]]);
                      B2 := (!chain-last
			     [(c =/= 'tick)
			      ==> (~ (Ticker = Ticker & c = 'tick & 
				      exists ?t . ls = clock local ?t))
			      [prop-taut]
			      ==> (~ ls ready-to (receive Clock Ticker c))
				 [Clock.ready-to-definition]])}
                    (!from-complements goal B1 B2))
        | Clock => # id = Clock & fr = Clock
          pick-any T n s ls
            let {A1 := (unique-ids config (citp T n));
                 A2 := (before (citp T n) (receive Clock Clock c) s ls)}
            assume (A1 & A2)
              let {goal := 
                    ((citp T (S n)) = (citp T n) then (receive Clock Clock c) 
	             | exists ?k ?s' ?ls' . 
	                 ?k > n & 
		         (before (citp T ?k) (receive Clock Clock c) ?s' ?ls'));
                   B1 := (!chain-last
			  [A2 ==> (ls ready-to (receive Clock Clock c))
			      [BR right-and]
			      ==> (Clock = Ticker)
			      [Clock.ready-to-definition left-and]
			      ==> (Ticker = Clock) [sym]])}
              (!from-complements goal B1 (Ticker =/= Clock))
       }
  }
| (send id:Clock-Actors.Name to c) =>
  datatype-cases 
      (forall ?T ?n ?s ?ls .
         (unique-ids config (citp ?T ?n)) &
	 (before (citp ?T ?n) (send id to c) ?s ?ls)
	 ==>
	 (citp ?T (S ?n)) = (citp ?T ?n) then (send id to c)
	 | exists ?k ?s' ?ls' . 
	     ?k > ?n & 
	     (before (citp ?T ?k) (send id to c) ?s' ?ls'))
    on id {
      Ticker =>
      datatype-cases
          (forall ?T ?n ?s ?ls .
             (unique-ids config (citp ?T ?n)) &
	     (before (citp ?T ?n) (send Ticker to c) ?s ?ls)
	     ==>
	     (citp ?T (S ?n)) = (citp ?T ?n) then (send Ticker to c)
	     | exists ?k ?s' ?ls' . 
	         ?k > ?n & 
	         (before (citp ?T ?k) (send Ticker to c) ?s' ?ls'))
        on to {
          Ticker =>
          pick-any T n s ls
            let {A1 := (unique-ids config (citp T n));
                 A2 := (before (citp T n) (send Ticker Ticker c) s ls)}
            assume (A1 & A2)
              let {goal := 
                    ((citp T (S n)) = (citp T n) then (send Ticker Ticker c)
                     | exists ?k ?s' ?ls' .
                         ?k > n &
                         (before (citp T ?k) (send Ticker Ticker c) ?s' ?ls'))}
              (!two-cases
               assume (c = 'continue)
                 let {B1 := (!chain-last
			     [A2
			      ==> (before (citp T n) (send Ticker Ticker 'continue)
					  s ls)
			      [(c = 'continue)]
			      ==> (config (citp T n) =
                                    s ++ (actor Ticker ls) &
                                   ls ready-to (send Ticker Ticker 'continue))
			      [BS]])}
                 (!chain-last
		  [(A1 & B1)
		   ==> ((citp T (S n)) = 
			  (citp T n) then (send Ticker Ticker 'continue)
                        | exists ?k ?s' ?ls' .
                            ?k > n &
                            config (citp T ?k) =
                              ?s' ++ (actor Ticker ?ls') &
                              ?ls' ready-to (send Ticker Ticker 'continue))
		   [(IOE-Ticker-send-to Ticker 'continue)]
		   ==> ((citp T (S n)) = 
			  (citp T n) then (send Ticker Ticker 'continue)
                        | exists ?k ?s' ?ls' .
                            ?k > n &
                            (before (citp T ?k) (send Ticker Ticker 'continue) 
				    ?s' ?ls'))   [BS]
		   ==> goal 		         [(c = 'continue)]])
               assume (c =/= 'continue)
                 let {B1 := (!chain-last
			     [A2 
			      ==> (ls ready-to (send Ticker Ticker c))
			      [BS right-and]]);
                      B2 := (!chain-last
			     [(Ticker =/= Clock)
			      ==> (Ticker =/= Clock & c =/= 'continue)
			      [augment]
			      ==> (~ (Ticker = Ticker & c = 'continue) &
				   ~ (Ticker = Clock & c = 'tick))
			      [prop-taut]
			      ==> ((ls ready-to (send Ticker Ticker c)) <==> false)
			      [Ticker.ready-to-definition]
			      ==> (~ ls ready-to (send Ticker Ticker c))
			      [prop-taut]])}
		 (!from-complements goal B1 B2))
        | Clock =>        # id = Ticker & to = Clock
          pick-any T n s ls
            let {A1 := (unique-ids config (citp T n));
                 A2 := (before (citp T n) (send Ticker Clock c) s ls)}
            assume (A1 & A2)
              let {goal := 
                    ((citp T (S n)) = (citp T n) then (send Ticker Clock c)
		     | exists ?k ?s' ?ls' .
		         ?k > n &
		         (before (citp T ?k) (send Ticker Clock c) ?s' ?ls'))}
              (!two-cases
               assume (c = 'tick)
                 let{B1 := (!chain-last
			    [A2
			     ==> (before (citp T n) (send Ticker Clock 'tick) s ls)
			     [(c = 'tick)]
			     ==> (config (citp T n) =
                                   s ++ (actor Ticker ls) &
                                  ls ready-to (send Ticker Clock 'tick))
			     [BS]])}
                 (!chain-last
		  [(A1 & B1)
		   ==> ((citp T (S n)) = (citp T n) then (send Ticker Clock 'tick)
                        | exists ?k ?s' ?ls' .
                            ?k > n &
                            config (citp T ?k) =
                              ?s' ++ (actor Ticker ?ls') &
                              ?ls' ready-to (send Ticker Clock 'tick))
		   [(IOE-Ticker-send-to Clock 'tick)]
		   ==> ((citp T (S n)) = (citp T n) then (send Ticker Clock 'tick)
                        | exists ?k ?s' ?ls' .
                            ?k > n &
                            (before (citp T ?k) (send Ticker Clock 'tick) ?s' ?ls'))
		   [BS]
		   ==> goal   [(c = 'tick)]])
               assume (c =/= 'tick)
	         let {B1 := (!chain-last
			     [A2 
			      ==> (ls ready-to (send Ticker Clock c))
			      [BS right-and]]);
                      B2 := (!chain-last
			     [(Ticker =/= Clock)
			      ==> (Clock =/= Ticker)               [sym]
			      ==> (Clock =/= Ticker & c =/= 'tick) [augment]
			      ==> (~ (Clock = Ticker & c = 'continue) &
				   ~ (Clock = Clock & c = 'tick))  
			      [prop-taut]
			      ==> ((ls ready-to (send Ticker Clock c)) <==> false)
			      [Ticker.ready-to-definition]
			      ==> (~ ls ready-to (send Ticker Clock c))
			      [prop-taut]])}
                 (!from-complements goal B1 B2))
        }
    | Clock =>  # id = Clock
      pick-any T n s ls
        let {A1 := (unique-ids config (citp T n));
             A2 := (before (citp T n) (send Clock to c) s ls)}
        assume (A1 & A2)
          let {goal := 
                ((citp T (S n)) = (citp T n) then (send Clock to c)
	         | exists ?k ?s' ?ls' . 
	             ?k > n & 
	             (before (citp T ?k) (send Clock to c) ?s' ?ls'));
               _ := (!chain-last
		      [A2
		       ==> (ls ready-to (send Clock to c))
		       [BS right-and]
		       ==> false
		       [Clock.ready-to-definition]])}
          (!from-false goal)
    }
| (create id:Clock-Actors.Name id') =>
  datatype-cases 
     (forall ?T ?n ?s ?ls .
         (unique-ids config (citp ?T ?n)) &
	 (before (citp ?T ?n) (create id id') ?s ?ls)
	 ==>
	 (citp ?T (S ?n)) = (citp ?T ?n) then (create id id') |
	 exists ?k ?s' ?ls' . 
	   ?k > ?n & 
	   (before (citp ?T ?k) (create id id') ?s' ?ls'))
    on id {
      Ticker => 
       pick-any T n s ls
        let {A1 := (unique-ids config (citp T n));
             A2 := (before (citp T n) (create Ticker id') s ls)}
        assume (A1 & A2)
          let {goal := 
                ((citp T (S n)) = (citp T n) then (create Ticker id')
	         | exists ?k ?s' ?ls' . 
	             ?k > n & 
	             (before (citp T ?k) (create Ticker id') ?s' ?ls'));
               _ := (!chain-last
		      [A2
		       ==> (ls ready-to (create Ticker id'))
		       [BC right-and]
		       ==> false
		       [Ticker.ready-to-definition]])}
          (!from-false goal)
    | Clock => 
       pick-any T n s ls
        let {A1 := (unique-ids config (citp T n));
             A2 := (before (citp T n) (create Clock id') s ls)}
        assume (A1 & A2)
          let {goal1 := ((citp T (S n)) = (citp T n) then (create Clock id'));
               goal2 := 
	         (exists ?k ?s' ?ls' . 
	             ?k > n & 
	             (before (citp T ?k) (create Clock id') ?s' ?ls'));
               goal2' := 
	         (exists ?k ?s' ?ls' . 
	             ?k > n & 
	             config (citp T ?k) = ?s' ++ (actor Clock ?ls') &
		     (count id' config (citp T ?k)) = zero &
                     ?ls' ready-to (create Clock id'));
               goal := (goal1 | goal2)}
          (!chain-last
	   [(A1 & A2)
	    ==> ((unique-ids config (citp T n)) &
                 config (citp T n) = s ++ (actor Clock ls) &
		 (count id' config (citp T n)) = zero & 
                 ls ready-to (create Clock id'))  [BC]
	    ==> (goal1 | goal2')                  [IOE-Clock-create]
	    ==> goal                              [BC]])
    }
} # Ticker-Clock
