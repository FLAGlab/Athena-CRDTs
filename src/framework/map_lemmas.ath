# Map Lemmas for Clock Proofs
# 
# This file extracts and adapts useful lemmas from fmaps.ath
# for use in vector clock property proofs.

load "../utils/fmaps"

open FMap

module MapLemmas {

# ============================================================================
# CORE LEMMAS FROM fmaps.ath
# ============================================================================

# The fmaps.ath file already proves many useful properties:
# - apply-lemma-1: Getting a key that returns NONE means underlying map also returns NONE
# - apply-lemma-2: Key lookup characterization
# - apply-lemma-3: Determinism of map lookup
# - remove-correctness: Removing a key makes it return NONE
# - dom-characterization: Domain membership characterization

# We'll restate key lemmas here for easy reference and adapt them for clock operations

# ============================================================================
# UPDATE COMMUTATIVITY (Different Keys)
# ============================================================================

# Lemma: Updating different keys commutes
# This is crucial for proving ClockJoin.commutative

assert update-commute-different-keys :=
  (forall ?k1 ?k2 ?v1 ?v2 ?m:(Map 'S 'T) .
    (?k1 =/= ?k2) ==>
    (update (pair ?k1 ?v1) (update (pair ?k2 ?v2) ?m)) =
    (update (pair ?k2 ?v2) (update (pair ?k1 ?v1) ?m)))

# NOTE: Requires map extensionality. Axiomatized for now until the
# extensionality principle is formalized inside fmaps.ath.

# ============================================================================
# GET-AFTER-SET LEMMAS
# ============================================================================

# These correspond to the apply-axioms in fmaps.ath but restated
# in a form convenient for clock operations

# Lemma: Getting the same key after update returns the new value
define get-after-set-same :=
  (forall ?k ?v ?m:(Map 'S 'T) .
    ((update (pair ?k ?v) ?m) at ?k) = (SOME ?v))

conclude get-after-set-same
  pick-any k v m:(Map 'S 'T)
  (!chain [((update (pair k v) m) at k)
       = (SOME v)    [apply-axioms]])

# Lemma: Getting a different key after update looks in the underlying map
define get-after-set-different :=
  (forall ?k1 ?k2 ?v ?m:(Map 'S 'T) .
    (?k1 =/= ?k2) ==>
    ((update (pair ?k1 ?v) ?m) at ?k2) = (?m at ?k2))

conclude get-after-set-different
  pick-any k1 k2 v m:(Map 'S 'T)
  assume (k1 =/= k2)
    (!chain [((update (pair k1 v) m) at k2)
         = (m at k2)    [apply-axioms]])

# ============================================================================
# UPDATE IDEMPOTENCE
# ============================================================================

# Lemma: Updating the same key twice with same value is idempotent
assert update-same-key-same-value :=
  (forall ?k ?v ?m:(Map 'S 'T) .
    (update (pair ?k ?v) (update (pair ?k ?v) ?m)) =
    (update (pair ?k ?v) ?m))

# NOTE: Requires map extensionality to prove rigorously. Added as an axiom
# so we can proceed with clock join development while the formal proof is
# constructed in fmaps.ath.

# ============================================================================
# UPDATE SHADOWING
# ============================================================================

# Lemma: Updating the same key twice shadows the first value
assert update-same-key-shadow :=
  (forall ?k ?v1 ?v2 ?m:(Map 'S 'T) .
    (update (pair ?k ?v2) (update (pair ?k ?v1) ?m)) =
    (update (pair ?k ?v2) ?m))

# NOTE: Same extensionality requirement as above. Axiomatized temporarily.

# ============================================================================
# EMPTY MAP PROPERTIES
# ============================================================================

# Lemma: Looking up any key in empty map returns NONE
define empty-map-lookup :=
  (forall ?k .
    (empty-map:(Map 'S 'T) at ?k) = NONE)

conclude empty-map-lookup
  pick-any k
  (!chain [(empty-map:(Map 'S 'T) at k)
       = NONE    [apply-axioms]])

# Lemma: Updating empty map creates a singleton
define update-empty-creates-singleton :=
  (forall ?k ?v .
    (update (pair ?k ?v) empty-map:(Map 'S 'T)) at ?k = (SOME ?v))

conclude update-empty-creates-singleton
  pick-any k v
  (!chain [((update (pair k v) empty-map:(Map 'S 'T)) at k)
       = (SOME v)    [apply-axioms]])

# ============================================================================
# HELPER LEMMAS FOR PROOFS
# ============================================================================

# Note: Many of these lemmas use !claim because full proofs require
# map extensionality principle. In a complete development, we would:
# 1. Add extensionality axiom: forall m1 m2 . (forall k . m1 at k = m2 at k) ==> m1 = m2
# 2. Prove each lemma by showing pointwise equality

# For our current purposes, these claims are justified by:
# - The structure axioms of Map datatype
# - The apply-axioms that define map lookup behavior
# - Standard properties of finite maps

} # end module MapLemmas

open MapLemmas

