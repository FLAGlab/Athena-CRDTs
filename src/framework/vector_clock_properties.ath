# Vector Clock Properties
# Proven theorems about vector clock operations

load "vector_clocks"

module VectorClockProperties {

open VectorClocks
open FMap
open N

#--------------------------------------------------------------------------
# PROVEN THEOREMS
#--------------------------------------------------------------------------

# Theorem: clock-tick preserves other components
# Proof: Uses clock-tick-def, clock-set-def, and ClockGet.miss
conclude tick-preserves-others :=
  (forall ?c:Clock ?id1:Ide ?id2:Ide .
    (?id1 =/= ?id2) ==>
    (clock-get (clock-tick ?c ?id1) ?id2) = (clock-get ?c ?id2))
  pick-any c:Clock id1:Ide id2:Ide
    assume neq := (id1 =/= id2)
      (!chain [(clock-get (clock-tick c id1) id2)
             = (clock-get (clock-set c id1 (S (clock-get c id1))) id2)  [clock-tick-def]
             = (clock-get c id2)  [clock-set-def ClockGet.miss neq]])

# Theorem: clock-tick increments the specified component
# Proof: Uses clock-tick-def, clock-set-def, and ClockGet.hit
conclude tick-increments-component :=
  (forall ?c:Clock ?id:Ide .
    (clock-get (clock-tick ?c ?id) ?id) = (S (clock-get ?c ?id)))
  pick-any c:Clock id:Ide
    (!chain [(clock-get (clock-tick c id) id)
           = (clock-get (clock-set c id (S (clock-get c id))) id)  [clock-tick-def]
           = (S (clock-get c id))  [clock-set-def ClockGet.hit]])

# Theorem: join with empty clock is identity (left)
# Proof: Uses ClockJoin.empty axiom
conclude join-empty-left :=
  (forall ?c:Clock . (clock-join clock-empty ?c) = ?c)
  pick-any c:Clock
    (!chain [(clock-join clock-empty c)
           = c  [ClockJoin.empty]])

} # end module VectorClockProperties
