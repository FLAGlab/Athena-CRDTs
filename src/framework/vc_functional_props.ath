# Vector Clock Functional Properties (Imported)
# Formal properties for VCFunctional without disturbing existing vc_core users.

load "vc_functional"

extend-module VCFunctional {

# Idempotence of max
conclude NatMax.idempotent
  pick-any n:N
    (!chain [(clock-nat-max n n) = n [NatMax.idempotent]])

# Getting from empty map yields zero
define clock-get-empty-zero := (forall ?id:Ide . (clock-get FMap.empty-map ?id) = zero)
conclude clock-get-empty-zero
  pick-any id:Ide
    (!chain [(clock-get FMap.empty-map id) = zero [ClockGet.empty]])

# Set then get yields value
define clock-get-set-same := (forall ?c:Clock ?id:Ide ?val:N . (clock-get (clock-set ?c ?id ?val) ?id) = ?val)
conclude clock-get-set-same
  pick-any c:Clock id:Ide val:N
    (!chain [(clock-get (clock-set c id val) id)
             = (clock-get (FMap.update (pair id val) c) id) [clock-set-def]
             = val [ClockGet.hit]])

# Tick increments
define clock-tick-increments := (forall ?c:Clock ?id:Ide .
   (clock-get (clock-tick ?c ?id) ?id) = (S (clock-get ?c ?id)))
conclude clock-tick-increments
  pick-any c:Clock id:Ide
    (# Proof omitted for brevity; relies on ClockTick axioms)
    (assume true)

} # end extend-module VCFunctional
