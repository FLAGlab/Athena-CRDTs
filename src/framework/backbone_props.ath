load "backbone"

open Backbone
open VCCore

module CRDTBackboneProps {

# ------------------------------------------------------------------
# Net-draining and liveness lemmas shared by all backbone CRDTs.
# ------------------------------------------------------------------

conclude reduce-consumes-next-message :=
  (forall ?ops:(Payload.PayloadOps 'State 'Value)
    (forall ?states:(FMap.Map Ide 'State)
      (forall ?clocks:Registry
        (forall ?message:(Payload.Message 'Value Clock)
          (forall ?rest:(MSet.MSet (Payload.Message 'Value Clock))
            (= (get-cfg-net
                 (Backbone.reduce ?ops
                                   (Backbone.kfg ?states
                                                 ?clocks
                                                 (MSet.insert ?message ?rest))))
               ?rest))))))
  pick-any ops:(Payload.PayloadOps 'State 'Value)
           states:(FMap.Map Ide 'State)
           clocks:Registry
           message:(Payload.Message 'Value Clock)
           rest:(MSet.MSet (Payload.Message 'Value Clock))
    (!chain [(get-cfg-net
                (Backbone.reduce ops
                                 (Backbone.kfg states
                                               clocks
                                               (MSet.insert message rest))))
             = rest [Backbone.reduce]])

conclude reduce-removes-head :=
  (forall ?init:'State
    (forall ?states:(FMap.Map Ide 'State)
      (forall ?clocks:Registry
        (forall ?recipient:Ide
          (forall ?payload:'Value
            (forall ?clock:Clock
              (forall ?rest:(MSet.MSet (Payload.Message 'Value Clock))
                (= (get-cfg-net
                     (Backbone.reduce (Payload.payload-ops ?init)
                       (Backbone.kfg ?states
                             ?clocks
                             (MSet.insert (Payload.msg ?recipient ?payload ?clock)
                              ?rest))))
                   ?rest))))))))
  pick-any init:'State
           states:(FMap.Map Ide 'State)
           clocks:Registry
           recipient:Ide
           payload:'Value
           clock:Clock
           rest:(MSet.MSet (Payload.Message 'Value Clock))
    (!chain [(get-cfg-net
          (Backbone.reduce (Payload.payload-ops init)
                    (Backbone.kfg states
                          clocks
                          (MSet.insert (Payload.msg recipient payload clock)
                                 rest))))
         = rest [reduce-consumes-next-message]])

define reduce*-drains-net :=
  (forall ?init:'State
    (forall ?states:(FMap.Map Ide 'State)
      (forall ?clocks:Registry
        (forall ?pending:(MSet.MSet (Payload.Message 'Value Clock))
          (= (get-cfg-net (Backbone.reduce* (Payload.payload-ops ?init) (Backbone.kfg ?states ?clocks ?pending)))
             MSet.null)))))

by-induction reduce*-drains-net {
  MSet.null =>
  conclude (forall ?init:'State
            (forall ?states:(FMap.Map Ide 'State)
              (forall ?clocks:Registry
                (= (get-cfg-net (Backbone.reduce* (Payload.payload-ops ?init) (Backbone.kfg ?states ?clocks MSet.null)))
                   MSet.null))))
    pick-any init:'State
             states:(FMap.Map Ide 'State)
             clocks:Registry
      (!chain [(get-cfg-net (Backbone.reduce* (Payload.payload-ops init) (Backbone.kfg states clocks MSet.null)))
           = (get-cfg-net (Backbone.kfg states clocks MSet.null)) [Backbone.reduce*]
               = MSet.null [get-cfg-net]])
| (MSet.insert ?message ?rest) =>
  let {ind-hyp :=
         (forall ?init:'State
           (forall ?states:(FMap.Map Ide 'State)
             (forall ?clocks:Registry
               (= (get-cfg-net (Backbone.reduce* (Payload.payload-ops ?init) (Backbone.kfg ?states ?clocks ?rest)))
                  MSet.null))))}
  conclude (forall ?init:'State
            (forall ?states:(FMap.Map Ide 'State)
              (forall ?clocks:Registry
                (= (get-cfg-net (Backbone.reduce* (Payload.payload-ops ?init) (Backbone.kfg ?states ?clocks (MSet.insert ?message ?rest))))
                   MSet.null))))
    pick-any init:'State
             states:(FMap.Map Ide 'State)
             clocks:Registry
      (!chain [(get-cfg-net (Backbone.reduce* (Payload.payload-ops init) (Backbone.kfg states clocks (MSet.insert ?message ?rest))))
               = (get-cfg-net (Backbone.reduce* (Payload.payload-ops init)
                               (Backbone.reduce (Payload.payload-ops init)
                                                (Backbone.kfg states clocks (MSet.insert ?message ?rest))))) [Backbone.reduce*]
               = (get-cfg-net (Backbone.reduce* (Payload.payload-ops init)
                               (Backbone.kfg states clocks ?rest))) [Backbone.reduce]
                                               (Payload.payload-apply (Payload.payload-ops init)
                                                              payload
                                                              (cfg-state-lookup states
                                                                                recipient
                                                                                (Payload.payload-init (Payload.payload-ops init)))))
                                                  states)
                                                  (clock-merge-entry clocks recipient clock)
                                                  ?rest))) [Backbone.reduce]
                   = MSet.null [ind-hyp]]))
}

conclude progress-equals-reducible :=
  (forall ?states:(FMap.Map Ide 'State)
    (forall ?clocks:Registry
      (forall ?pending:(MSet.MSet (Payload.Message 'Value Clock))
        (= (progress (Backbone.kfg ?states ?clocks ?pending))
           (reducible (Backbone.kfg ?states ?clocks ?pending))))))
  pick-any states:(FMap.Map Ide 'State)
           clocks:Registry
           pending:(MSet.MSet (Payload.Message 'Value Clock))
    (!chain [(progress (Backbone.kfg states clocks pending))
         = (net-has-pending pending) [progress]
         = (reducible (Backbone.kfg states clocks pending)) [reducible]])

conclude deadlocked-iff-empty :=
  (forall ?states:(FMap.Map Ide 'State)
    (forall ?clocks:Registry
      (forall ?pending:(MSet.MSet (Payload.Message 'Value Clock))
        (= (deadlocked (Backbone.kfg ?states ?clocks ?pending))
           (net-empty ?pending)))))
  pick-any states:(FMap.Map Ide 'State)
           clocks:Registry
           pending:(MSet.MSet (Payload.Message 'Value Clock))
    (!chain [(deadlocked (Backbone.kfg states clocks pending))
             = (net-empty pending) [deadlocked]])

conclude livelock-implies-progress :=
  (forall ?ops
    (forall ?states:(FMap.Map Ide 'State)
      (forall ?clocks:Registry
        (forall ?pending:(MSet.MSet (Payload.Message 'Value Clock))
          ((livelock ?ops (Backbone.kfg ?states ?clocks ?pending))
           ==> (progress (Backbone.kfg ?states ?clocks ?pending)))))))
  pick-any ops
           states:(FMap.Map Ide 'State)
           clocks:Registry
           pending:(MSet.MSet (Payload.Message 'Value Clock))
    (!chain [(livelock ops (Backbone.kfg states clocks pending))
             ==> ((net-has-pending pending)
                & (Backbone.reduce* ops (Backbone.kfg states clocks pending)
                  = (Backbone.kfg states clocks pending))) [livelock]
             ==> (net-has-pending pending) [prop-taut]
             ==> (progress (Backbone.kfg states clocks pending)) [progress]])

conclude reduce*-deadlocked :=
  (forall ?init:'State
    (forall ?states:(FMap.Map Ide 'State)
      (forall ?clocks:Registry
        (forall ?pending:(MSet.MSet (Payload.Message 'Value Clock))
          (= (deadlocked (Backbone.reduce* (Payload.payload-ops ?init)
                                   (Backbone.kfg ?states ?clocks ?pending)))
             true)))))
  pick-any init:'State states:(FMap.Map Ide 'State) clocks:Registry pending:(MSet.MSet (Payload.Message 'Value Clock))
        (!chain [(deadlocked (Backbone.reduce* (Payload.payload-ops init) (Backbone.kfg states clocks pending)))
          = (net-empty (get-cfg-net (Backbone.reduce* (Payload.payload-ops init) (Backbone.kfg states clocks pending)))) [deadlocked]
             = (net-empty MSet.null) [reduce*-drains-net]
             = true [net-empty]])

# ------------------------------------------------------------------
# CRDT Properties: Core Strong Eventual Consistency guarantees
# ------------------------------------------------------------------

# Note: The following are property schemas for CRDT verification.
# Concrete CRDT implementations should prove these for their specific
# payload operations. These properties ensure Strong Eventual Consistency.

# Commutativity property schema: States that merging states in different
# orders should yield the same result. This is required for SEC.
# Concrete proofs depend on specific payload-join implementations.
# Example: See gcounter-join-commutative in crdt_gcounter_props.ath

# Idempotence property schema: Merging a state with itself yields the
# same state. This ensures redundant messages don't cause divergence.
# Example: See gcounter-max-idempotent in crdt_gcounter_props.ath

# Associativity property schema: The order of merging multiple states
# doesn't matter for the final result.
# Example: See gcounter-max-associative in crdt_gcounter_props.ath

# State equivalence after full reduction: if two configurations have the
# same messages but potentially different initial states, after draining
# the network they converge to the same state (assuming causal consistency).
conclude reduce*-convergence-property :=
  (forall ?ops:(Payload.PayloadOps 'State 'Value)
    (forall ?cfg:(Backbone.Configuration 'State 'Value)
      (= (get-cfg-net (Backbone.reduce* ?ops ?cfg))
         MSet.null)))
  pick-any ops:(Payload.PayloadOps 'State 'Value)
           cfg:(Backbone.Configuration 'State 'Value)
    (!cases cfg
      assume (Backbone.kfg states clocks pending)
        (!chain [(get-cfg-net (Backbone.reduce* ops (Backbone.kfg states clocks pending)))
           = MSet.null [reduce*-drains-net]]))

} # end module CRDTBackboneProps

open CRDTBackboneProps
