load "src/framework/theory/gcounter_theory"
module TestGCounterV3 {
  open GCounterTheoryV3
  define test-commutative := gc-commutative-proven
  define test-associative := gc-associative-proven  
  define test-idempotent := gc-idempotent-proven
  define test-left-id := gc-left-identity-proven
  define test-right-id := gc-right-identity-proven
  define SL-Theory := SemilatticeTheory.theory
  define gc-absorption-adapted := 
    (get-property SemilatticeTheory.absorption GCounter-Adapter SL-Theory)
  define gc-monotone-left-adapted := 
    (get-property SemilatticeTheory.monotone-left GCounter-Adapter SL-Theory)
  define gc-monotone-right-adapted := 
    (get-property SemilatticeTheory.monotone-right GCounter-Adapter SL-Theory)
  (print "\n=== GCounter Theory V3 Instance Check ===\n")
  (print-instance-check GCounter-Adapter SL-Theory)
  (print "\n=== End Instance Check ===\n")
  conclude double-join-same :=
    (forall ?n:N . (gc-join (gc-join ?n ?n) ?n) = ?n)
    pick-any n:N
      (!chain [(gc-join (gc-join n n) n)
             = (gc-join n n)              [gc-idempotent-proven]
             = n                          [gc-idempotent-proven]])
  (print "\n=== All tests completed successfully ===\n")
  (print "Key difference from V2:\n")
  (print "  - V2: Properties were ASSERTED (assert*)\n")
  (print "  - V3: Properties are PROVEN (conclude) from semantic axioms\n")
  (print "  - Semantic axioms (gc-join-is-max) define what gc-join MEANS\n")
  (print "  - This shows GCounter IS a semilattice, not just claims it\n")
} 
