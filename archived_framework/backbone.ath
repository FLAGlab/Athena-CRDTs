load "../utils/msets-simple"
load "../utils/fmaps"
load "../utils/pair"
load "../utils/list-util"
load "payload"
load "vector_clocks"
module Backbone {
open Payload
open VectorClocks
define (alist->clist L) :=
  match L {
    [] => nil
  | (list-of x rest) => (x :: (alist->clist rest))
  }
define gen-ide :=
  lambda (i n) (string->id ((id->string i) join (val->string n)))
define gen-fresh :=
  lambda (i n)
    (alist->clist
     (map (lambda (k) (gen-ide i k)) (from-to 0 n)))
define empty-map := FMap.empty-map
define empty-mset := MSet.null
define ++ := FMap.++
overload ++ MSet.++
define at := FMap.at
define - := MSet.-
overload - FMap.-
define in := MSet.in
overload in List.in
datatype (Configuration State Value) :=
  (kfg astates:(FMap.Map Ide State)
       clocks:Registry
       net:(MSet.MSet (Message Value Clock)))
define cfg-states := astates
define (get-cfg-states cfg) :=
  match cfg {
    (Backbone.kfg states _ _) => states
  | _ => empty-map 
  }
define (get-cfg-clocks cfg) :=
  match cfg {
    (Backbone.kfg _ clks _) => clks
  | _ => registry-empty 
  }
define (get-cfg-net cfg) :=
  match cfg {
    (Backbone.kfg _ _ network) => network
  | _ => empty-mset 
  }
define (cfg-with-net cfg net) :=
  (Backbone.kfg (get-cfg-states cfg)
                 (get-cfg-clocks cfg)
                 net)
define (cfg-drop-next-message cfg) :=
  match (get-cfg-net cfg) {
    MSet.null => cfg
  | (MSet.insert _ rest) => (cfg-with-net cfg rest)
  }
define (cfg-dom cfg) :=
  (FMap.dom (get-cfg-states cfg))
define (cfg-has-actor? cfg actor) :=
  match ((get-cfg-states cfg) at actor) {
    NONE => false
  | (SOME _) => true
  }
define (net-empty pending) :=
  match pending {
    MSet.null => true
  | (MSet.insert _ _) => false
  }
define (net-has-pending pending) :=
  match pending {
    MSet.null => false
  | (MSet.insert _ _) => true
  }
define (cfg-empty-net cfg) :=
  (net-empty (get-cfg-net cfg))
define (drain-payload-state candidate) :=
  candidate  
define (drain-payload-state-map states) :=
  match states {
    FMap.empty-map => FMap.empty-map
  | (FMap.update (pair actor value) rest) =>
      (FMap.update (pair actor (drain-payload-state value))
                   (drain-payload-state-map rest))
  | _ => states 
  }
define (cfg-state-lookup-normalized states target fallback) :=
  match states {
    FMap.empty-map => fallback
  | (FMap.update (pair key value) rest) =>
      match (equal? key target) {
        true => value
      | false => (cfg-state-lookup-normalized rest target fallback)
      }
  | _ => fallback 
  }
define (cfg-state-lookup states target fallback) :=
  (cfg-state-lookup-normalized
    (drain-payload-state-map states)
    target
    (drain-payload-state fallback))
define (cfg-state-or cfg actor fallback) :=
  (cfg-state-lookup (get-cfg-states cfg) actor fallback)
define (cfg-states-drained cfg) :=
  (drain-payload-state-map (get-cfg-states cfg))
define (cfg-state-or-drained cfg actor fallback) :=
  (cfg-state-lookup-normalized
    (cfg-states-drained cfg)
    actor
    (drain-payload-state fallback))
define (cfg-with-drained-states cfg) :=
  (Backbone.kfg (cfg-states-drained cfg)
                (get-cfg-clocks cfg)
                (get-cfg-net cfg))
define (cfg-with-clocks cfg clocks) :=
  (Backbone.kfg (get-cfg-states cfg) clocks (get-cfg-net cfg))
define (cfg-tick cfg actor) :=
  (Backbone.kfg (get-cfg-states cfg)
                    (registry-tick (get-cfg-clocks cfg) actor)
                    (get-cfg-net cfg))
define (cfg-actor-clock cfg actor) :=
  (let ((result:Clock (registry-get (get-cfg-clocks cfg) actor)))
    result)
define (clock-merge-entry clockmap actor incoming) :=
  (registry-merge clockmap actor incoming)
define (reduce ops cfg) :=
  match (get-cfg-net cfg) {
    MSet.null => cfg
  | (MSet.insert (Payload.msg id payload clock) rest) =>
      (let ((states (get-cfg-states cfg))
            (clocks (get-cfg-clocks cfg))
            (current (cfg-state-lookup states id (payload-init ops)))
            (updated-state (payload-apply ops payload current))
            (next-states (FMap.update (pair id updated-state) states))
            (next-clocks (clock-merge-entry clocks id clock)))
        (Backbone.kfg next-states next-clocks rest))
  }
define (reduce* ops cfg) :=
  match (get-cfg-net cfg) {
    MSet.null => cfg
  | (MSet.insert _ _) => (reduce* ops (reduce ops cfg))
  }
define (enqueue-message cfg recipient payload clock:Clock) :=
  (Backbone.kfg (get-cfg-states cfg)
                    (get-cfg-clocks cfg)
                    (MSet.insert (Payload.msg recipient payload clock) (get-cfg-net cfg)))
define (enqueue-over-states cfg states payload clock-fn) :=
  match states {
    FMap.empty-map => cfg
  | (FMap.update (pair actor _) rest) =>
      (let ((next (enqueue-message cfg actor payload (clock-fn actor))))
        (enqueue-over-states next rest payload clock-fn))
  | _ => cfg 
  }
define (enqueue-bulk cfg payload clock-fn) :=
  (enqueue-over-states cfg (get-cfg-states cfg) payload clock-fn)
define (broadcast-with cfg payload clock-fn) :=
  (enqueue-bulk cfg payload clock-fn)
define (broadcast-from cfg actor payload) :=
  (let ((advanced (cfg-tick cfg actor)))
    (let ((clock (cfg-actor-clock advanced actor)))
      (broadcast-with advanced payload (lambda (_) clock))))
define (broadcast cfg payload) :=
  (broadcast-with cfg payload (lambda (_) clock-empty))
define (init-state-map ops ids) :=
  (Payload.init-map ops ids)
define (init-clock-map ids) :=
  match ids {
    nil => registry-empty
  | (id :: rest) =>
      (FMap.update (pair id clock-empty) (init-clock-map rest))
  | _ => registry-empty
  }
define (init ops ids) :=
  (Backbone.kfg (init-state-map ops ids) (init-clock-map ids) empty-mset)
define (reducible cfg) :=
  match cfg {
    (Backbone.kfg _ _ pending) =>
      (net-has-pending pending)
  }
define (deadlocked cfg) :=
  match cfg {
    (Backbone.kfg _ _ pending) =>
      (net-empty pending)
  }
define (progress cfg) :=
  match cfg {
    (Backbone.kfg _ _ pending) =>
      (net-has-pending pending)
  }
define (livelock ops cfg) :=
  ((net-has-pending (get-cfg-net cfg))
   & (reduce* ops cfg = cfg))
} 
open Backbone
