#!/bin/bash
# Lightweight wrapper for running Athena loads without touching unwritable paths.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: $0 <module-or-path>..." >&2
  exit 64
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DEFAULT_HOME=""
if [[ -d "$SCRIPT_DIR/../athena" ]]; then
  DEFAULT_HOME="$(cd "$SCRIPT_DIR/../athena" && pwd)"
fi

CANDIDATE_HOME="${ATHENA_HOME:-}"
if [[ -z "$CANDIDATE_HOME" ]]; then
  CANDIDATE_HOME="$DEFAULT_HOME"
fi

if [[ -z "$CANDIDATE_HOME" ]]; then
  echo "Error: unable to determine ATHENA_HOME; set it explicitly." >&2
  exit 65
fi

if [[ ! -x "$CANDIDATE_HOME/athena" && -n "$DEFAULT_HOME" && -x "$DEFAULT_HOME/athena" ]]; then
  CANDIDATE_HOME="$DEFAULT_HOME"
fi

if [[ ! -x "$CANDIDATE_HOME/athena" ]]; then
  echo "Error: Athena binary not found at $CANDIDATE_HOME/athena." >&2
  exit 66
fi

ATHENA_HOME="$CANDIDATE_HOME"
ATHENA_BIN="${ATHENA_BIN:-$ATHENA_HOME/athena}"

if [[ ! -x "$ATHENA_BIN" ]]; then
  echo "Error: Athena binary not found at $ATHENA_BIN." >&2
  exit 66
fi

resolve_input() {
  local arg="$1"
  local candidate=""

  if [[ -f "$arg" ]]; then
    candidate="$arg"
  fi

  if [[ -z "$candidate" && -f "$arg.ath" ]]; then
    candidate="$arg.ath"
  fi

  if [[ -z "$candidate" && -f "$SCRIPT_DIR/$arg" ]]; then
    candidate="$SCRIPT_DIR/$arg"
  fi

  if [[ -z "$candidate" && -f "$SCRIPT_DIR/$arg.ath" ]]; then
    candidate="$SCRIPT_DIR/$arg.ath"
  fi

  if [[ -z "$candidate" && -f "$SCRIPT_DIR/src/$arg" ]]; then
    candidate="$SCRIPT_DIR/src/$arg"
  fi

  if [[ -z "$candidate" && -f "$SCRIPT_DIR/src/$arg.ath" ]]; then
    candidate="$SCRIPT_DIR/src/$arg.ath"
  fi

  if [[ -z "$candidate" && -f "$SCRIPT_DIR/src/demos/$arg" ]]; then
    candidate="$SCRIPT_DIR/src/demos/$arg"
  fi

  if [[ -z "$candidate" && -f "$SCRIPT_DIR/src/demos/$arg.ath" ]]; then
    candidate="$SCRIPT_DIR/src/demos/$arg.ath"
  fi

  if [[ -z "$candidate" && "$arg" != */* ]]; then
    local found
    found="$(find "$SCRIPT_DIR/src/demos" -maxdepth 3 -type f \( -name "$arg" -o -name "$arg.ath" \) -print -quit 2>/dev/null)"
    if [[ -n "$found" ]]; then
      candidate="$found"
    fi
  fi

  if [[ -z "$candidate" ]]; then
    echo "Error: unable to resolve '$arg' to an Athena file." >&2
    exit 67
  fi

  local dir base
  dir="$(cd "$(dirname "$candidate")" && pwd)"
  base="$(basename "$candidate")"
  echo "$dir/$base"
}

declare -a FILES=()
for arg in "$@"; do
  FILES+=("$(resolve_input "$arg")")
done

{
  for file in "${FILES[@]}"; do
    escaped="${file//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    printf '(load "%s")\n' "$escaped"
  done
  printf 'quit\n'
} | env ATHENA_HOME="$ATHENA_HOME" "$ATHENA_BIN"
