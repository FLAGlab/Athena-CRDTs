load "../crdts/lww_register_specification"

# Simple Demo: LWW-Register with Axiomatic Specification
#
# Demonstrates proper Athena patterns:
# - Operations declared (not defined procedurally)
# - Axioms specified with assert*
# - Reasoning about properties symbolically

open LWWRegisterSpec
open VectorClocks

(print "\n===================================================================")
(print "  LWW-Register Demo: Axiomatic Specification Pattern")
(print "===================================================================\n")

# ------------------------------------------------------------------
# Setup: Define example values and states
# ------------------------------------------------------------------

define alice := (string->id "alice")
define bob := (string->id "bob")

define val-hello := (LWWRegisterSpec.val (string->id "hello"))
define val-world := (LWWRegisterSpec.val (string->id "world"))

(print "Actors: alice, bob")
(print "Values: hello, world\n")

# Initial state
define state0 := lww-initial

(print "Initial state: lww-initial")
(print "  = (val(nil), empty-clock)\n")

# ------------------------------------------------------------------
# Scenario 1: Single write
# ------------------------------------------------------------------

(print "--- Scenario 1: Alice writes 'hello' ---\n")

# Alice writes hello
define state1 := (lww-apply-update state0 (LWWRegisterSpec.write val-hello) alice)

(print "After alice writes 'hello':")
(print "  state1 = lww-apply-update(state0, write(hello), alice)")
(print "  Using axiom: lww-apply-update-def")
(print "  state1 = (hello, tick(empty-clock, alice))\n")

# Read value
define value1 := (lww-read state1)

(print "Read value from state1:")
(print "  value1 = lww-read(state1)")
(print "  Using axiom: lww-read-def")
(print "  value1 = first(state1) = hello\n")

# ------------------------------------------------------------------
# Scenario 2: Merge demonstrates commutativity
# ------------------------------------------------------------------

(print "--- Scenario 2: Commutative merge ---\n")

# Create two different states
define state-a := (lww-apply-update state0 (LWWRegisterSpec.write val-hello) alice)
define state-b := (lww-apply-update state0 (LWWRegisterSpec.write val-world) bob)

(print "state-a = alice writes 'hello'")
(print "state-b = bob writes 'world'\n")

# Merge in both orders
define merged-ab := (lww-merge state-a state-b)
define merged-ba := (lww-merge state-b state-a)

(print "merged-ab = lww-merge(state-a, state-b)")
(print "merged-ba = lww-merge(state-b, state-a)\n")

(print "By axiom lww-merge-commutative:")
(print "  merged-ab = merged-ba")
(print "  (Strong Eventual Consistency!)\n")

# ------------------------------------------------------------------
# Scenario 3: Idempotence
# ------------------------------------------------------------------

(print "--- Scenario 3: Idempotent merge ---\n")

define merged-aa := (lww-merge state-a state-a)

(print "merged-aa = lww-merge(state-a, state-a)")
(print "\nBy axiom lww-merge-idempotent:")
(print "  merged-aa = state-a")
(print "  (Merging with yourself is no-op)\n")

# ------------------------------------------------------------------
# Key Insights
# ------------------------------------------------------------------

(print "===================================================================")
(print "  Key Insights: Axiomatic vs Procedural")
(print "===================================================================")
(print "\n1. AXIOMATIC SPECIFICATION:")
(print "   - Operations DECLARED (not defined)")
(print "   - Behavior specified via AXIOMS")
(print "   - Reasoning is SYMBOLIC\n")

(print "2. ADVANTAGES:")
(print "   - Clear separation: spec vs implementation")
(print "   - Properties (commutativity) are AXIOMS, not theorems to prove")
(print "   - Can reason without execution\n")

(print "3. PATTERN FOR CRDTS:")
(print "   declare merge: [State State] -> State")
(print "   assert* merge-commutative := (merge ?s1 ?s2 = merge ?s2 ?s1)")
(print "   assert* merge-idempotent := (merge ?s ?s = ?s)\n")

(print "4. LWW-REGISTER SPECIFICS:")
(print "   - Uses vector clocks for causality")
(print "   - Commutative (SEC) but NOT associative")
(print "   - First non-semilattice CRDT in framework!\n")

(print "===================================================================\n")

(print "[SUCCESS] Axiomatic LWW-Register demonstration complete!\n")
